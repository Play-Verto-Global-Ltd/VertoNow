<%# One Verto in the account: what they said, next to what everyone said.
    These are the rows the player already draws at the end of a Verto — the
    account's contribution is that they survive closing the tab, which until
    now they did not. Nothing is restyled for this surface on purpose: a
    respondent should recognise the screen they saw when they finished. %>
<div class="you-page you-page-bar">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <%= render "you/bar", current: :verto %>
  <div class="you-shell">

    <%= link_to you_path, class: "you-back" do %>‹ <%= t("you.back") %><% end %>

    <div class="you-head">
      <div class="you-verto-org"><%= @survey.organisation.name %></div>
      <h1 class="you-h1"><%= @survey.theme.presence || @survey.title %></h1>
      <div class="you-verto-when">
        <%= t("you.answered_on",
              date: l((@answered.completed_at || @answered.created_at).to_date, format: :long)) %><%
        if @comparison[:state] != :off && @comparison[:total].to_i.positive? %> ·
          <%= t("you.have_answered", count: @comparison[:total]) %><% end %>
      </div>
    </div>

    <%# A quiz's score against everyone's. Above the answers because it is the
        number they came for, and not behind the creator's comparison switch:
        the end screen never put it there either (PlayerController#scores). %>
    <% if @scores %>
      <div class="you-card" id="score">
        <h2 class="you-h2"><%= t("player.quiz_compare_title") %></h2>
        <% if @scores[:state] == :suppressed %>
          <p class="you-sub"><%= t("you.comparison_too_few") %></p>
          <p class="you-fine">
            <%= t("you.compare_pending", needed: Response::MIN_REGION_SAMPLE_SIZE,
                  have: @scores[:total].to_i) %>
          </p>
        <% else %>
          <p class="you-sub you-score-meta">
            <%= t("js.player.quiz_compare_meta", score: @scores[:score], max: @scores[:max],
                  beat: @scores[:beat], avg: @scores[:average]) %>
          </p>
          <% @scores[:bars].each do |bar| %>
            <div class="you-bar-row<%= " is-mine" if bar[:mine] %>">
              <div class="you-bar-label"><%= bar[:label] %></div>
              <div class="you-bar-track">
                <span class="you-bar-fill" style="width:<%= bar[:pct] %>%;"></span>
              </div>
              <div class="you-bar-pct"><%= bar[:pct] %>%</div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="you-card" id="compare">
      <% case @comparison[:state] %>
      <% when :off %>
        <%# show_results_comparison is the creator's switch and it stays theirs.
            The account keeps the Verto either way; it just has less to show. %>
        <h2 class="you-h2"><%= t("you.your_answers") %></h2>
        <p class="you-sub"><%= t("you.comparison_off", org: @survey.organisation.name) %></p>

      <% when :suppressed %>
        <%# The same rule the player enforces: under MIN_REGION_SAMPLE_SIZE the
            whole payload is refused, because on a Verto with one or two
            responders the "comparison" IS the other respondent's answers. An
            account does not become a way around small-cell suppression. %>
        <h2 class="you-h2"><%= t("you.comparison_title") %></h2>
        <p class="you-sub"><%= t("you.comparison_too_few") %></p>
        <%# The prose says come back; this says when. A respondent who can see
            it is 2 of 5 knows whether that means tomorrow or never. %>
        <p class="you-fine">
          <%= t("you.compare_pending", needed: Response::MIN_REGION_SAMPLE_SIZE,
                have: @comparison[:total].to_i) %>
        </p>

      <% else %>
        <h2 class="you-h2"><%= t("you.comparison_title") %></h2>
        <% @comparison[:rows].each do |row| %>
          <div class="you-q">
            <div class="you-q-prompt"><%= row[:prompt] %></div>
            <div class="you-q-mine"><%= t("you.your_answer", answer: row[:mine]) %></div>
            <% row[:bars].each do |bar| %>
              <% if bar[:heading] %><div class="you-bar-group"><%= bar[:heading] %></div><% end %>
              <div class="you-bar-row<%= " is-mine" if bar[:mine] %>">
                <div class="you-bar-label" title="<%= bar[:label] %>"><%= bar[:label] %></div>
                <div class="you-bar-track">
                  <span class="you-bar-fill" style="width:<%= bar[:pct] %>%;"></span>
                </div>
                <%# A ranking's figure is a mean position, not a share (ResultsComparison). %>
                <div class="you-bar-pct"><%= bar[:text] || "#{bar[:pct]}%" %></div>
              </div>
            <% end %>
          </div>
        <% end %>
        <% if @comparison[:rows].empty? %>
          <p class="you-sub"><%= t("you.comparison_none") %></p>
        <% end %>
      <% end %>
    </div>

    <%# Their piles and their standing on this Verto's own board. The amounts
        are a snapshot of what they collected; the rank is live, because it
        describes a population that is still answering. %>
    <% if @piles.any? %>
      <div class="you-card you-card-tight">
        <div class="you-piles">
          <% @piles.each do |pile| %>
            <span class="you-pile">
              <%= pile[:icon] %> <b><%= number_with_delimiter(pile[:amount]) %></b> <%= pile[:name] %>
            </span>
          <% end %>
        </div>
        <% if @standing %>
          <div class="you-standing">
            <%= t("you.standing", name: @standing[:name],
                  rank: number_with_delimiter(@standing[:rank]),
                  of: number_with_delimiter(@standing[:of])) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# What happened. Three states, and the third is the commonest and the one
        a design like this usually forgets: most Vertos will never get an
        impact written. It has to read as honest rather than as an error — the
        copy says the organisation hasn't said, not that nothing happened,
        because the app does not know which and must not imply the harsher
        reading of a creator who simply hasn't come back. %>
    <div class="you-card you-impact" id="impact">
      <% if @survey.impact_published? %>
        <h2 class="you-h2"><%= t("you.impact_title") %></h2>
        <div class="you-impact-headline"><%= @survey.impact_headline %></div>
        <p class="you-sub"><%= @survey.impact_body %></p>
        <% @survey.impact_changes_list.each do |line| %>
          <div class="you-impact-change"><span aria-hidden="true">→</span> <%= line %></div>
        <% end %>
        <% if @survey.impact_link? %>
          <p class="you-impact-link">
            <%= link_to "#{@survey.impact_link_text} ↗", @survey.impact_link_url,
                  target: "_blank", rel: "noopener" %>
          </p>
        <% end %>
      <% elsif @survey.next_step? %>
        <h2 class="you-h2"><%= t("you.next_step_title") %></h2>
        <% if @survey.next_step_headline.present? %>
          <div class="you-impact-headline"><%= @survey.next_step_headline %></div>
        <% end %>
        <% if @survey.next_step_body.present? %>
          <p class="you-sub"><%= @survey.next_step_body %></p>
        <% end %>
      <% else %>
        <h2 class="you-h2"><%= t("you.next_step_title") %></h2>
        <p class="you-sub"><%= t("you.impact_none", org: @survey.organisation.name) %></p>
      <% end %>
    </div>

    <%# The next Verto this creator pointed at, with the reason on the card. %>
    <% if @follow_ups.any? %>
      <div class="you-head you-head-tight">
        <h2 class="you-h2"><%= t("you.next_title") %></h2>
      </div>
      <div class="you-list">
        <% @follow_ups.each do |next_verto| %>
          <%= link_to play_survey_path(next_verto.publish_token), class: "you-verto" do %>
            <span class="you-verto-rule" aria-hidden="true"></span>
            <div class="you-verto-body">
              <div class="you-verto-org">
                <%= t("you.next_because", verto: @survey.theme.presence || @survey.title) %>
              </div>
              <h2 class="you-verto-title"><%= next_verto.theme.presence || next_verto.title %></h2>
              <div class="you-verto-when"><%= t("you.next_meta") %></div>
              <span class="you-verto-go" aria-hidden="true">→</span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
