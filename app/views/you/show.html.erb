<%# The dashboard: every Verto this person has played, in the shape of the
    creator's own (surveys/index) — a bar, a hero, a row of tiles, and a grid
    of cards — because a respondent who goes on to make a Verto should
    recognise the room.

    Signed out is a first-class state: there is no sign-in form anywhere in
    this app, so the page explains where a link comes from rather than
    sending anyone to a screen they cannot use. %>
<div class="you-page you-page-bar">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <%= render "you/bar", current: :vertos %>

  <% if !player_signed_in? %>
    <div class="you-shell">
      <div class="you-card">
        <h1 class="you-h1"><%= t("you.signed_out_title") %></h1>
        <p class="you-sub"><%= t("you.signed_out_body") %></p>
      </div>
    </div>

  <% else %>
    <section class="you-hero">
      <div class="you-orbs you-orbs-hero" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i></div>
      <div class="you-hero-inner">
        <div class="you-eyebrow"><span class="you-dot"></span><%= t("you.welcome_back") %></div>
        <h1 class="you-h1 you-h1-hero"><%= t("you.heading_html") %></h1>
        <p class="you-lead"><%= t("you.lead") %></p>
      </div>
    </section>

    <%# Four numbers, and the one that is a sum is a door: the wallet is the
        page the collected total belongs to, so the tile opens it — but only
        when there is something in it, a link to "no points yet" is a trick. %>
    <section class="you-tiles-wrap">
      <div class="you-tiles">
        <div class="you-tile is-teal">
          <div class="you-tile-value"><%= @tiles[:vertos] %></div>
          <div class="you-tile-label"><%= t("you.tile_vertos") %></div>
        </div>
        <div class="you-tile is-pink">
          <div class="you-tile-value"><%= @tiles[:results_open] %></div>
          <div class="you-tile-label"><%= t("you.tile_results_open") %></div>
        </div>
        <div class="you-tile is-purple">
          <div class="you-tile-value"><%= @tiles[:impact] %></div>
          <div class="you-tile-label"><%= t("you.tile_impact") %></div>
        </div>
        <% collected = capture do %>
          <div class="you-tile-value"><%= number_with_delimiter(@tiles[:collected]) %></div>
          <div class="you-tile-label"><%= t("you.tile_collected") %></div>
        <% end %>
        <% if @tiles[:collected].positive? %>
          <%= link_to collected, you_wallet_path, class: "you-tile is-yellow" %>
        <% else %>
          <div class="you-tile is-yellow"><%= collected %></div>
        <% end %>
      </div>
    </section>

    <div class="you-main">
      <%= render "you/flash" %>
      <%= render "you/confirm_banner", state: @confirm, player: current_player if @confirm %>

      <section class="you-section" id="vertos">
        <div class="you-section-head">
          <span class="you-section-dot is-teal" aria-hidden="true"></span>
          <span class="you-section-label"><%= t("you.section_vertos") %></span>
          <div class="you-section-line" aria-hidden="true"></div>
          <span class="you-section-count"><%= @rows.size %></span>
        </div>
        <% if @rows.empty? %>
          <div class="you-card">
            <p class="you-sub"><%= t("you.empty") %></p>
          </div>
        <% else %>
          <div class="you-grid">
            <% @rows.each do |row| %>
              <%= render "you/verto_card", row: row %>
            <% end %>
          </div>
        <% end %>
      </section>

      <%# Where the Vertos they hold point. A section rather than a strip
          inside each card, now that the cards are a grid — but the reason
          still travels with each entry, and a Verto already in the account
          is never offered back (see YouController#follow_ups_for). %>
      <% if @next.any? %>
        <section class="you-section" id="next">
          <div class="you-section-head">
            <span class="you-section-dot is-blue" aria-hidden="true"></span>
            <span class="you-section-label"><%= t("you.section_next") %></span>
            <div class="you-section-line" aria-hidden="true"></div>
            <span class="you-section-count"><%= @next.size %></span>
          </div>
          <div class="you-grid">
            <% @next.each do |item| %>
              <%= render "you/next_card", item: item %>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# What their answers did: every impact an organisation has written,
          then every promise of one. Most Vertos have neither, and the section
          is simply absent then rather than drawn empty — the honest reading
          of "hasn't said" is on each Verto's own page. %>
      <% if @impacts.any? %>
        <section class="you-section" id="impact">
          <div class="you-section-head">
            <span class="you-section-dot is-purple" aria-hidden="true"></span>
            <span class="you-section-label"><%= t("you.section_impact") %></span>
            <div class="you-section-line" aria-hidden="true"></div>
            <span class="you-section-count"><%= @impacts.size %></span>
          </div>
          <div class="you-grid you-grid-wide">
            <% @impacts.each do |item| %>
              <%= render "you/impact_card", item: item %>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# Always drawn, signed in, even for an empty account: it is the one
          part of the page that explains what the rest is for. %>
      <section class="you-steps" id="count">
        <div class="you-section-head you-section-head-bare">
          <span class="you-section-dot is-pink" aria-hidden="true"></span>
          <span class="you-section-label"><%= t("you.section_count") %></span>
        </div>
        <h2 class="you-steps-title"><%= t("you.count_title") %></h2>
        <ol class="you-steps-list">
          <li class="you-step">
            <span class="you-step-n" aria-hidden="true">1</span>
            <div class="you-step-title"><%= t("you.step_share_title") %></div>
            <p class="you-step-body"><%= t("you.step_share_body", needed: Response::MIN_REGION_SAMPLE_SIZE) %></p>
          </li>
          <li class="you-step">
            <span class="you-step-n" aria-hidden="true">2</span>
            <div class="you-step-title"><%= t("you.step_compare_title") %></div>
            <p class="you-step-body"><%= t("you.step_compare_body") %></p>
          </li>
          <li class="you-step">
            <span class="you-step-n" aria-hidden="true">3</span>
            <div class="you-step-title"><%= t("you.step_impact_title") %></div>
            <p class="you-step-body"><%= t("you.step_impact_body") %></p>
          </li>
        </ol>
      </section>
    </div>
  <% end %>
</div>
