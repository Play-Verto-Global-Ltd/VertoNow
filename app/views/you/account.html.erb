<%# The settings page. Four panels, four forms, because each one fails on its
    own terms: a name too long, a password that does not match, a preference
    that saved. Redirecting back with one flash is only legible if the flash
    can be about ONE form.

    The address is shown and not edited. It is the thing the account is keyed
    on, and changing it would need the proof-of-inbox the sign-in link gives
    — which is the mail this page cannot promise to send. %>
<div class="you-page you-page-bar">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <%= render "you/bar", current: :account %>

  <section class="you-hero you-hero-account">
    <div class="you-hero-inner you-hero-inner-narrow">
      <%= link_to you_path, class: "you-back" do %>‹ <%= t("you.back") %><% end %>
      <div class="you-eyebrow"><span class="you-dot"></span><%= t("you.account_eyebrow") %></div>
      <h1 class="you-h1 you-h1-hero"><%= t("you.account_heading_html") %></h1>
      <p class="you-lead"><%= t("you.account_lead") %></p>
    </div>
  </section>

  <div class="you-main you-main-narrow">
    <% if notice.present? %><div class="you-flash is-notice" role="status"><%= notice %></div><% end %>
    <% if alert.present? %><div class="you-flash is-alert" role="alert"><%= alert %></div><% end %>

    <%# ── Profile ──────────────────────────────────────────────────────── %>
    <section class="you-panel" id="profile">
      <h2 class="you-panel-title"><%= t("you.profile_title") %></h2>
      <p class="you-panel-sub"><%= t("you.profile_sub") %></p>
      <%= form_with url: you_account_path, method: :patch, class: "you-form" do |f| %>
        <div class="you-field">
          <%= f.label :name, t("you.name_label"), class: "you-label" %>
          <%= f.text_field :name, value: @player.name, class: "you-input",
                placeholder: t("you.name_placeholder"), maxlength: Player::MAX_NAME,
                autocomplete: "name" %>
        </div>
        <div class="you-field">
          <span class="you-label"><%= t("you.email_label") %></span>
          <div class="you-input you-input-ro">
            <span class="you-input-ro-text"><%= @player.email_address %></span>
            <% if @player.email_verified? %>
              <span class="you-tag is-teal">
                <svg width="10" height="8" viewBox="0 0 10 8" fill="none" aria-hidden="true">
                  <path d="M1 4l2.6 2.6L9 1.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <%= t("you.email_verified") %>
              </span>
            <% elsif @confirm %>
              <span class="you-tag is-amber"><%= t("you.email_unconfirmed") %></span>
            <% end %>
            <% if @google %>
              <span class="you-tag">
                <span class="you-tag-g" aria-hidden="true">G</span>
                <%= t("you.email_google") %>
              </span>
            <% end %>
          </div>
          <p class="you-help"><%= t("you.email_help") %></p>
        </div>
        <div class="you-form-actions">
          <%= f.button t("you.save"), type: "submit", class: "you-btn you-btn-primary" %>
        </div>
      <% end %>
      <%# Outside the form above: the resend is its own POST, and a form
          cannot hold another one. %>
      <%= render "you/confirm_banner", state: @confirm, player: @player if @confirm %>
    </section>

    <%# ── Sign in ──────────────────────────────────────────────────────── %>
    <section class="you-panel" id="password">
      <h2 class="you-panel-title"><%= t("you.signin_title") %></h2>
      <p class="you-panel-sub"><%= t(@has_password ? "you.signin_sub_has" : "you.signin_sub_none") %></p>
      <%= form_with url: you_account_password_path, method: :patch, class: "you-form" do |f| %>
        <% if @has_password %>
          <div class="you-field">
            <%= f.label :current_password, t("you.current_password"), class: "you-label" %>
            <%= f.password_field :current_password, class: "you-input", autocomplete: "current-password" %>
          </div>
        <% end %>
        <div class="you-field-grid">
          <div class="you-field">
            <%= f.label :password, t("you.new_password"), class: "you-label" %>
            <%= f.password_field :password, class: "you-input", autocomplete: "new-password",
                  placeholder: t("you.password_hint", min: Player::MIN_PASSWORD),
                  minlength: Player::MIN_PASSWORD %>
          </div>
          <div class="you-field">
            <%= f.label :password_confirmation, t("you.confirm_password"), class: "you-label" %>
            <%= f.password_field :password_confirmation, class: "you-input", autocomplete: "new-password",
                  placeholder: t("you.password_again") %>
          </div>
        </div>
        <div class="you-form-actions">
          <%= f.button t(@has_password ? "you.change_password" : "you.set_password"),
                type: "submit", class: "you-btn" %>
        </div>
      <% end %>
    </section>

    <%# ── Preferences ──────────────────────────────────────────────────── %>
    <section class="you-panel" id="preferences">
      <h2 class="you-panel-title"><%= t("you.prefs_title") %></h2>
      <p class="you-panel-sub"><%= t("you.prefs_sub") %></p>
      <%= form_with url: you_account_preferences_path, method: :patch, class: "you-form" do |f| %>
        <div class="you-field">
          <%= f.label :preferred_locale, t("you.language_label"), class: "you-label" %>
          <%= f.select :preferred_locale,
                SupportedLocales.ui_ready.map { |loc| [ loc.english_name, loc.code ] },
                { selected: I18n.locale.to_s }, class: "you-input you-select" %>
        </div>
        <div class="you-field">
          <span class="you-label"><%= t("you.emails_label") %></span>
          <p class="you-help"><%= t("you.emails_hint") %></p>
          <% if @organisations.empty? %>
            <p class="you-help"><%= t("you.emails_none") %></p>
          <% else %>
            <%# The hidden "0" ahead of the box, so an unticked toggle posts as
                a refusal rather than as nothing — nothing is what an
                organisation the account does not hold posts as, and the two
                must not read the same. %>
            <div class="you-rows">
              <% @organisations.each do |organisation| %>
                <div class="you-row">
                  <label class="you-row-name" for="emails_<%= organisation.id %>"><%= organisation.name %></label>
                  <%= hidden_field_tag "emails[#{organisation.id}]", "0", id: nil %>
                  <label class="you-toggle">
                    <%= check_box_tag "emails[#{organisation.id}]", "1",
                          !@unsubscribed.include?(organisation.id),
                          id: "emails_#{organisation.id}", class: "you-toggle-input" %>
                    <span class="you-toggle-track" aria-hidden="true"></span>
                  </label>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="you-form-actions">
          <%= f.button t("you.save_prefs"), type: "submit", class: "you-btn" %>
        </div>
      <% end %>
    </section>

    <%# ── Delete ───────────────────────────────────────────────────────── %>
    <section class="you-panel is-danger" id="delete">
      <h2 class="you-panel-title"><%= t("you.delete") %></h2>
      <p class="you-panel-sub"><%= t("you.delete_body") %></p>
      <div class="you-form-actions">
        <%= button_to t("you.delete"), you_path, method: :delete,
              class: "you-btn you-btn-danger",
              form: { class: "you-account-form", data: { turbo_confirm: t("you.delete_confirm") } } %>
      </div>
    </section>
  </div>
</div>
