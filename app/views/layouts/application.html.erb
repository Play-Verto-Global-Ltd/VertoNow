<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= SupportedLocales.dir(I18n.locale) %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-slate text-smoke font-sans min-h-screen <%= 'has-bottom-bar' if Current.user %>">
    <% unless Current.user %>
      <header class="border-b border-smoke/10">
        <div class="max-w-3xl mx-auto px-4 sm:px-5 md:px-6 py-5 flex items-center justify-between">
          <%= link_to root_path, class: "flex items-center gap-2 group" do %>
            <%= image_tag "playverto.svg", alt: "Playverto", class: "h-8 w-auto" %>
          <% end %>
          <div class="flex items-center gap-4">
            <%= render "shared/locale_switcher" %>
            <span class="display text-xs tracking-widest text-smoke/50"><%= t("layout.studio_tagline", default: "Verto Studio") %></span>
          </div>
        </div>
      </header>
    <% end %>

    <%# Only in this layout, not fullscreen: that one positions its content with
        fixed offsets (top: 56px), so an extra band above it would sit under the
        page rather than push it down. The editor surfaces the same block when
        publishing is attempted. %>
    <%= render "shared/email_confirmation_banner" %>

    <main class="<%= 'max-w-3xl mx-auto px-4 sm:px-5 md:px-6 py-8 md:py-10' unless Current.user %>">
      <%= yield %>
    </main>

    <% if Current.user %>
      <div data-controller="command-palette">
        <%= render "shared/bottom_bar" %>
        <%= render "shared/command_palette" %>
      </div>
    <% else %>
      <%= render "shared/legal_footer" %>
    <% end %>
  </body>
</html>
