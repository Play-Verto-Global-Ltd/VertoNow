<%
  default_locale ||= SupportedLocales::DEFAULT
  type     = card["type"].to_s
  is_q     = CardTypes.question?(type)
  progress = total_q > 0 && is_q ? ((q_idx.to_f / total_q) * 100).round : 5
  eyebrow  = CardTypes.eyebrow(type).presence || type.tr('_', ' ')
  # The lock as this REQUEST sees it (LiveEditing), not the model's own — an
  # allowed account editing a live Verto gets the full chrome back.
  live     = @survey.present? && editing_locked?(@survey)
%>

<div class="survey-card-wrap"
     data-type-panel-target="card"
     data-survey-editor-target="card"
     <%# editor-scroll-sync observes each card so the right panel follows the one
         the creator scrolls to. It has to be declared HERE, not in show.html.erb:
         cards spliced in after load are re-rendered from this partial (see
         RendersCardHtml), and one without the target is invisible to the
         observer — it would silently never become the edited card. %>
     data-editor-scroll-sync-target="card"
     data-card-type="<%= type %>"
     data-card-cid="<%= card['cid'].to_s %>"
     data-card-num="<%= idx + 1 %>"
     data-card-image="<%= card['image'].to_s %>"
     <%# The pre-crop original and the crop taken from it — what "Adjust crop"
         reopens, so a creator can zoom OUT past the first crop. Autosave
         rebuilds every card from this DOM, so like common_question_id these
         must survive the round-trip or one reload-and-save would drop them. %>
     <% if card['image_source'].present? %>data-card-image-source="<%= card['image_source'] %>"<% end %>
     <% if card['image_crop'].is_a?(Hash) %>data-card-image-crop="<%= card['image_crop'].to_json %>"<% end %>
     data-card-lottie="<%= card['lottie'].to_s %>"
     data-card-video="<%= card['video'].to_s %>"
     data-card-video-poster="<%= card['video_poster'].to_s %>"
     data-card-image-credit="<%= card['image_credit'].to_s %>"
     data-card-image-credit-url="<%= card['image_credit_url'].to_s %>"
     data-card-allow-other="<%= card['allow_other'] ? 'true' : 'false' %>"
     data-card-required="<%= card['required'] ? 'true' : 'false' %>"
     data-card-ask-once="<%= card['ask_once'] ? 'true' : 'false' %>"
     <%# Respondent-code card only. Like every other flag here it has to survive
         the DOM round-trip autosave rebuilds each card from, or the first save
         after a reload would silently switch recall back off. %>
     data-card-recall="<%= card['recall'] ? 'true' : 'false' %>"
     data-card-input="<%= card['input'].to_s %>"
     data-card-demographic="<%= card['demographic'] ? 'true' : 'false' %>"
     <%# key_for, not the stored key: the auto-appended tail predates
         demographic_key, and this attribute is what greys the modal's
         Demographics tiles — a keyless birth-date card must still grey Age. %>
     <% if (dk = DemographicQuestions.key_for(card)) %>data-card-demographic-key="<%= dk %>"<% end %>
     <% if card['heritage_country'].present? %>data-card-heritage-country="<%= card['heritage_country'] %>"<% end %>
     <%# A location card's search narrowing (LocationScope). Edited by the
         location-scope panel; like everything here it must survive the DOM
         round-trip autosave rebuilds each card from. %>
     <% if card['location_places'].present? %>data-card-location-places="<%= Array(card['location_places']).to_json %>"<% end %>
     <% if card['location_countries'].present? %>data-card-location-countries="<%= Array(card['location_countries']).to_json %>"<% end %>
     <% if card['location_cities'].present? %>data-card-location-cities="<%= Array(card['location_cities']).to_json %>"<% end %>
     data-card-options="<%= Array(card['options']).to_json %>"
     data-card-pages="<%= Array(card['pages']).to_json %>"
     data-card-option-images="<%= Array(card['option_images']).to_json %>"
     <%# Per-statement repositions, positional against option_images. Only
         emitted when a statement has actually been moved — an untouched tap
         card carries no attribute, and the serialiser then sends no key. %>
     <% if card['option_focals'].present? %>data-card-option-focals="<%= Array(card['option_focals']).to_json %>"<% end %>
     <% if card['option_styles'].present? %>data-card-option-styles="<%= Array(card['option_styles']).to_json %>"<% end %>
     <% if card_media_bg(card).present? %>data-card-media-bg="<%= card_media_bg(card).to_json %>"<% end %>
     <%# Where the card's photo or video sits in the frames that crop it. Both
         axes always present so the editor's live drag has something to rewrite;
         50 means centre and the serialiser sends nothing. %>
     data-card-focal-x="<%= card_focal_x(card) %>"
     data-card-focal-y="<%= card_focal_y(card) %>"
     <% if card['focal_zoom'].present? %>data-card-focal-zoom="<%= card_focal_zoom(card) %>"<% end %>
     <% if card['animate_asset'] == true %>data-card-animate-asset="true"<% end %>
     <% if card['responses'].present? %>data-card-responses="<%= Array(card['responses']).to_json %>"<% end %>
     data-card-recommended-images="<%= AssetPopulator.recommended_paths(@survey, context: :card, card: card).to_json %>"
     <% if card['next'].is_a?(Hash) %>data-card-next="<%= card['next'].to_json %>"<% end %>
     <% if card['lane_label'].present? %>data-card-lane-label="<%= card['lane_label'] %>"<% end %>
     <% if card['flow_id'].present? %>data-card-flow-id="<%= card['flow_id'] %>"<% end %>
     <%# Common Question provenance. Invisible in the editor, but it's what
         CommonQuestionAggregator and the funder portfolio rollup key on to
         recognise the same question across Vertos — so it has to survive the
         DOM round-trip that autosave rebuilds every card from. %>
     <% if card['common_question_id'].present? %>data-card-common-question-id="<%= card['common_question_id'] %>"<% end %>
     <% if card['common_question_set_id'].present? %>data-card-common-question-set-id="<%= card['common_question_set_id'] %>"<% end %>
     <% if card['range_theme'].present? %>data-card-range-theme="<%= card['range_theme'] %>"<% end %>
     <%# The container an NPS card fills. Absent means "whatever the Verto's
         theme picks" — the same open default range_theme has, so a deck nobody
         has touched keeps following its theme rather than being frozen to the
         shape it happened to render once. %>
     <% if card['nps_shape'].present? %>data-card-nps-shape="<%= card['nps_shape'] %>"<% end %>
     <%# Present only when the creator has turned the classic 0-10 off. Its
         ABSENCE is not "classic" — it is "nobody has said" — so nothing is
         emitted for a card that has never been asked, and the labels answer
         for it (NpsHelper#nps_custom_scale?). %>
     <% if card['nps_custom_scale'] == true %>data-card-nps-custom-scale="true"<% end %>
     <%# The anchor lines beside the scale's ends. The serialiser reads them off
         the rendered column, not from here; this is the type panel's memory
         for a card switched away from NPS and back (type_panel#_npsAnchorsFor),
         the way data-card-options is for the labels. %>
     <% if card['nps_low_label'].present? || card['nps_high_label'].present? %>data-card-nps-anchors="<%= { low: card['nps_low_label'].to_s, high: card['nps_high_label'].to_s }.to_json %>"<% end %>
     <%# How many answers a respondent may tick on this card. Absent = no limit,
         which is what keeps "as many as there are answers" true when the option
         list grows — see Survey::MULTI_SELECT_TYPES. %>
     <% if card['max_choices'].present? %>data-card-max-choices="<%= card['max_choices'] %>"<% end %>
     <% if card['slider_axis'].present? %>data-card-slider-axis="<%= card['slider_axis'] %>"<% end %>
     data-card-competency="<%= card['competency'].to_s %>"
     data-card-outcome="<%= card['outcome'].to_s %>"
     data-card-condition="<%= card['condition'].to_s %>"
     <%# CardSubjectExtractor's photographable-noun-phrase stamp — nothing in
         the editor displays or edits it, but AssetPopulator reads it on every
         Shuffle, so the DOM round-trip has to carry it like the Framework
         provenance above or the first autosave silently drops it. %>
     <% if card['subject'].present? %>data-card-subject="<%= card['subject'] %>"<% end %>
     data-action="click->type-panel#selectCard">

  <%# CTA rail — every per-card control stacked on the card's inline-start
      side: Card N pill, the "Why" ?, the Rules-of-the-Game traffic light,
      reorder + duplicate, delete, and Add question. Expanded (icon + label)
      while the right panel is closed; when it opens, .is-panel-open hides
      every .rail-label so the rail collapses to icons — each control keeps
      its icon in both states. The light + analysis panel are filled in and
      toggled by survey_editor_controller. %>
  <div class="card-rail">
    <%# Everyday controls, pinned to the card's top. Reorder leads — position
        is the thing a creator most often adjusts. %>
    <div class="rail-top">
      <% unless live %>
        <%# The move swaps the card's slot with its neighbour in the DOM;
            autosave persists the new order (the serialiser reads cards in
            document order). %>
        <div class="card-reorder">
          <%# Drag handle — touch has no native HTML5 drag without a polyfill
              this deck doesn't carry, so ▲▼ stay the touch/keyboard path;
              this is a pointer-only addition, not a replacement. %>
          <button type="button" class="card-move-btn card-grip" data-role="grip"
                  draggable="true"
                  title="<%= t('editor.drag_to_reorder') %>"
                  aria-label="<%= t('editor.drag_to_reorder') %>"
                  data-action="dragstart->survey-editor#dragStart dragend->survey-editor#dragEnd">⠿</button>
          <button type="button" class="card-move-btn" data-role="move-up"
                  title="<%= t('editor.move_up', default: 'Move question up') %>"
                  aria-label="<%= t('editor.move_up', default: 'Move question up') %>"
                  data-action="click->survey-editor#moveCardUp">▲</button>
          <button type="button" class="card-move-btn" data-role="move-down"
                  title="<%= t('editor.move_down', default: 'Move question down') %>"
                  aria-label="<%= t('editor.move_down', default: 'Move question down') %>"
                  data-action="click->survey-editor#moveCardDown">▼</button>
        </div>
      <% end %>
      <%# Word and number split: the word is a .rail-label, so the collapsed
          rail shows a circle holding just the number. The number span is the
          re-stamp hook (survey_editor renumbers after every move). %>
      <span class="card-num-pill"><span class="rail-label">Card</span><span data-role="card-number"><%= idx + 1 %></span></span>
      <%# Opens the Why view for this card — the click also bubbles to
          type-panel#selectCard, which populates it (same behaviour the old
          Why tab had after selecting a card). %>
      <button type="button" class="why-cta"
              title="<%= t('editor.why', default: 'Why') %>"
              aria-label="<%= t('editor.why', default: 'Why') %>"
              data-action="click->publish-panel#showWhy"><span class="rail-icon">?</span><span class="rail-label"><%= t('editor.why', default: 'Why') %></span></button>
      <%# Intro modal. A full-rail-width control under the Card N / Why pair —
          one of the everyday controls, not one of the structural ones in
          .rail-bottom: a modal is this card's content, not the deck's shape.
          The full width comes from the `grid-column: 1 / -1` list in
          application.css, NOT from anything here: the rail is a two-column
          grid, so a control missing from that list gets half a rail (62px)
          and its label wraps out of the pill. This one shipped missing.
          It is a TOGGLE with two readings, which is why the label and the
          class both flip: off it invites (tinted, like Add question), on it
          reports (filled) and jumps to the panel the creator is about to
          type in. Offered on every type — a modal explains whatever card it
          is hung on, and a live Verto can gain one, because hanging it on the
          card moves no card and so re-points no stored answer. %>
      <button type="button" class="card-modal-btn<%= " is-on" if card_has_modal?(card) %>"
              data-role="card-modal-btn"
              aria-pressed="<%= card_has_modal?(card) %>"
              title="<%= t('editor.modal_toggle_title') %>"
              data-action="click->survey-editor#toggleCardModal">
        <%= card_modal_icon %>
        <span class="rail-label" data-role="card-modal-btn-label"><%= card_has_modal?(card) ? t("editor.modal_on") : t("editor.modal_add") %></span>
      </button>
      <% if is_q %>
        <%# Passive glance indicator — visible only while the card is Required
            (toggled live from the Answer Type tab's Card settings). %>
        <span class="required-chip" data-role="required-chip" <%= "hidden" unless card["required"] %>>✳ <span class="rail-label"><%= t("editor.required_chip", default: "Required") %></span></span>
      <% end %>
      <% if is_q %>
        <button type="button" class="card-light" data-role="card-light" hidden
                aria-expanded="false"
                title="<%= t('editor.rules.card_aria', default: 'How this card scores against the Rules of the Game') %>"
                data-action="click->survey-editor#toggleCardAnalysis">
          <span class="rule-dot"></span>
          <span class="card-light-word" data-role="card-light-word"></span>
          <span class="card-light-score" data-role="card-light-score"></span>
        </button>
      <% end %>
      <%# The welcome card takes part in reorder and delete like any other card
          (it has no traffic light — that's gated on is_q — and can't be
          duplicated, since at most one welcome card is allowed: verto_rules
          §1.3). It used to be excluded from all four, which is why a welcome
          card the creator no longer wanted couldn't be removed. %>
      <% unless live || type == "welcome_card" %>
        <%# Duplicate — same content, fresh identity; wiring and Common
            Question provenance stay with the original (flows_controller
            strips them before render_card mints the copy). %>
        <button type="button" class="card-duplicate-btn"
                title="<%= t('editor.duplicate_card_title', default: 'Duplicate this card') %>"
                aria-label="<%= t('editor.duplicate_card_title', default: 'Duplicate this card') %>"
                data-action="click->flows#duplicateCardClicked"><span class="rail-icon">⧉</span><span class="rail-label"><%= t("editor.duplicate_card", default: "Duplicate") %></span></button>
      <% end %>
    </div>

    <%# Rules-of-the-Game analysis for this card — populated + toggled by
        survey_editor_controller when the traffic light is clicked.
        It lives in the RAIL, directly beneath the dock whose score chip opens
        it. It used to be the first child of .card-col, above the 680px card, so
        un-hiding it pushed the card down inside a mandatory scroll-snap
        container and the whole designer jumped — "it comes up as a big box, and
        'pops' the verto designer down/up". In the rail it is a sibling of the
        card instead of a predecessor, and the rail is what grows. %>
    <% if is_q %>
      <div class="card-analysis" data-role="card-analysis" hidden></div>
    <% end %>

    <%# The card's FOOT: destructive + structural-insert, pinned to the
        bottom — Delete kept away from the everyday controls above, and Add
        question beside the seam where the new card will actually appear. %>
    <div class="rail-bottom">
      <%# Names its target. Three visually identical delete buttons sit in
          this editor (this one, plus Remove on the consent gate and the
          thank-you screen), so the accessible name has to say WHICH — the
          visible label stays short because the "Card N" pill is in the same
          rail. %>
      <% delete_name = t("editor.delete_card_n", n: idx + 1, default: "Delete card %{n}") %>
      <button type="button" class="card-delete-btn"
              title="<%= delete_name %>"
              aria-label="<%= delete_name %>"
              data-action="click->type-panel#deleteCard">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex-shrink:0;">
          <path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6h12z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="rail-label"><%= t("editor.delete_card", default: "Delete card") %></span>
      </button>
      <%# Insert a question after this card — was a row under the card
          (.aq-insert-row); add_question#open still finds its insertion point
          via closest(.card-slot). Hidden on live Vertos like reorder. %>
      <% unless live %>
        <button type="button" class="aq-trigger-btn rail-add-btn"
                title="<%= t('editor.add_question_here', default: 'Add a question after this one') %>"
                aria-label="<%= t('editor.add_question_here', default: 'Add a question after this one') %>"
                data-action="click->add-question#open"><span class="rail-icon">＋</span><span class="rail-label"><%= t("editor.add_question") %></span></button>
      <% end %>
    </div>
  </div><%# /card-rail %>

  <div class="card-col">
    <%# Horizontal split-card %>
    <div class="split-card<%= " has-card-modal" if card_has_modal?(card) %>">
      <%= render "shared/split_left",     card: card, progress: progress, mode: :editor %>
      <%= render "shared/card_component", card: card, mode: :editor, default_locale: default_locale,
            quiz: local_assigns.fetch(:quiz, false), tokenisation: local_assigns.fetch(:tokenisation, false) %>
      <%# The modal, inside .split-card so it paints over BOTH halves and clips
          to the card's own 24px radius — the same box the player puts it in,
          which is the point of rendering an editable replica at all. Always in
          the DOM (hidden by .has-card-modal on the parent) so toggling it on
          needs no re-render and the contenteditable nodes the serialiser reads
          are never missing: a card whose modal is off still round-trips its
          empty strings through autosave and stores nothing. %>
      <%= render "shared/card_modal", card: card, mode: :editor,
            display_locale: default_locale %>
    </div><%# /split-card %>
  </div><%# /card-col %>

  <%# Allow-Other / Required moved to the Answer Type tab's Card settings —
      their state lives on the wrap's data attributes (the serializer reads
      those), so nothing structural remains below the card. %>
</div><%# /survey-card-wrap %>
