<style>
  .results-export-menu > summary { list-style: none; }
  .results-export-menu > summary::-webkit-details-marker { display: none; }
  .results-export-menu > summary::marker { content: ""; }
  .results-export-menu > summary:hover { color: #fff; border-color: rgba(255,255,255,0.3); }
  [data-results-autorefresh-target="toggle"].is-on { color: #01EACB; border-color: rgba(1,234,203,0.4); background: rgba(1,234,203,0.08); }
</style>

<%# Full-viewport app-shell — body stays overflow:hidden from fullscreen layout %>
<div style="height:100%;background:#1C2034;display:flex;overflow:hidden;position:relative;"
     data-controller="freeform-answers"
     data-action="keydown.esc@window->freeform-answers#closeOnEsc">

  <%# ── Freeform answers panel — one shell for the whole page, opened by the
      "View all answers" button on any freeform result card (_result_cards).
      Outside the results-feed frame on purpose: the frame is replaced on
      every refresh and segment switch, and the panel must survive that. The
      list is fetched from SurveyTextAnswersController, paged, so a Verto with
      thousands of answers costs the page nothing until someone asks. ── %>
  <div data-freeform-answers-target="modal" class="app-modal hidden" role="dialog" aria-modal="true">
    <div class="app-modal__backdrop" data-action="click->freeform-answers#close"></div>
    <div class="app-modal__panel freeform-modal">
      <div class="freeform-modal__head">
        <div style="min-width:0;">
          <div class="freeform-modal__eyebrow"><%= t("results.freeform_eyebrow") %></div>
          <div class="freeform-modal__question" data-freeform-answers-target="question"></div>
        </div>
        <button type="button" class="freeform-modal__close" data-action="click->freeform-answers#close"
                aria-label="<%= t("share_modal.close") %>">✕</button>
      </div>
      <div class="freeform-modal__tools">
        <input type="search" class="freeform-modal__search"
               placeholder="<%= t("results.freeform_search_placeholder") %>"
               data-freeform-answers-target="search"
               data-action="input->freeform-answers#search keydown.enter->freeform-answers#searchNow" />
        <button type="button" class="freeform-modal__copy" data-freeform-answers-target="copy"
                data-copy-label="<%= t("results.freeform_copy") %>"
                data-action="click->freeform-answers#copy"><%= t("results.freeform_copy") %></button>
      </div>
      <div class="freeform-modal__body">
        <div class="freeform-modal__list" data-freeform-answers-target="list"></div>
        <div class="freeform-modal__status" data-freeform-answers-target="status" aria-live="polite"></div>
        <button type="button" class="freeform-modal__more" hidden data-freeform-answers-target="more"
                data-action="click->freeform-answers#loadMore"><%= t("results.freeform_load_more") %></button>
      </div>
    </div>
  </div>

  <%# Subtle on-brand ambient orbs behind everything %>
  <div class="gen-orbs results-orbs" aria-hidden="true">
    <div class="gen-orb gen-orb-1"></div>
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
    <div class="gen-orb gen-orb-4"></div>
  </div>

  <%# ── Middle: top-bar + scrollable content ── %>
  <div style="flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden;position:relative;z-index:1;">

    <%# ── Top bar ── the page hides the global nav (@hide_main_nav), so this
        strip is the whole chrome and it wears the editor's convention: the
        way out as a glass pill at the inline-start edge, the Verto's name
        beside it. Read-only here — renaming stays in the editor, which is
        why these carry .is-static rather than the editor's contenteditable.
        The theme only joins the name when the two differ: the pair reads as
        name-then-subject, and most Vertos share both, which would otherwise
        print the same words twice. %>
    <div class="results-top-bar">
      <%= link_to root_path, class: "editor-leave-btn",
            title: t("results.leave_results"),
            "aria-label": t("results.leave_results") do %>
        <svg class="editor-leave-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M9.5 3.5 5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="editor-leave-label"><%= t("results.leave_results") %></span>
      <% end %>
      <span class="editor-verto-title is-static" title="<%= @survey.title %>"><%= @survey.title %></span>
      <% if @survey.theme.present? && @survey.theme != @survey.title %>
        <span class="editor-verto-title editor-verto-theme is-static" title="<%= @survey.theme %>"><%= @survey.theme %></span>
      <% end %>
      <%# A viewer has no editor to go back to — the pill above is their whole
          way out, so only an editor is offered the door back into it. %>
      <% if can_edit_vertos? %>
        <%= link_to t("results.editor"), survey_path(@survey),
              style: "margin-inline-start:auto;flex-shrink:0;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.4);text-decoration:none;padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);transition:all 0.15s;",
              onmouseover: "this.style.color='white';this.style.borderColor='rgba(255,255,255,0.3)'",
              onmouseout:  "this.style.color='rgba(255,255,255,0.4)';this.style.borderColor='rgba(255,255,255,0.1)'" %>
      <% end %>
    </div>

    <%# Scrollable results feed %>
    <div style="flex:1;overflow-y:auto;padding:24px 24px 48px;">
      <div style="max-width:780px;margin:0 auto;display:flex;flex-direction:column;gap:14px;">

        <%# ── Ask Verto summary card (brand-coloured generating state) ── %>
        <div id="av-card" class="summary-card" style="border-radius:14px;background:rgba(1,234,203,0.05);border:1px solid rgba(1,234,203,0.18);padding:18px 22px;">
          <div class="summary-rainbow"></div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
            <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.4);letter-spacing:0.1em;text-transform:uppercase;"><%= t("results.ask_verto") %></span>
            <span id="av-thinking" class="gen-shimmer--brand" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);margin-left:2px;"><%= t("results.analysing") %></span>
          </div>
          <div id="av-text"
               style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.65);line-height:1.8;white-space:pre-wrap;min-height:18px;"></div>
        </div>

        <script>
          (function() {
            const card    = document.getElementById("av-card")
            const textEl  = document.getElementById("av-text")
            const thinkEl = document.getElementById("av-thinking")
            card.classList.add("is-generating")
            const stop = () => { card.classList.remove("is-generating"); thinkEl.style.display = "none" }
            fetch(<%= survey_results_summary_path(@survey).to_json.html_safe %>)
              .then(async r => {
                // A 503 means every streaming slot is busy, not that insights
                // are broken — show the server's wording, which says to retry.
                if (!r.ok) throw new Error((await r.text()).trim())
                const reader = r.body.getReader()
                const dec    = new TextDecoder()
                let started  = false
                function pump() {
                  return reader.read().then(({ done, value }) => {
                    if (done) { stop(); return }
                    if (!started) { started = true; stop() }
                    textEl.textContent += dec.decode(value, { stream: true })
                    return pump()
                  })
                }
                return pump()
              })
              .catch(err => {
                stop()
                textEl.textContent = (err && err.message) || "Insights unavailable right now."
                textEl.style.color = "rgba(255,255,255,0.2)"
              })
          })()
        </script>

        <%# ── Regions map — where responses came from (region-tagged Vertos) ──
            Also the compare-panel's mount point, so it appears whenever
            there's anything to compare even without a single tagged region:
            _setupMap already tolerates empty map data (results_compare_
            controller.js), the map just shows untinted in that case. %>
        <% region_segments = @segments.select { |s| s[:id].to_s.start_with?("region_") } %>
        <% wave_ids = @wave_stats&.size.to_i >= 2 ? @wave_stats.map { |s| "wave_#{s[:wave].position}" } : [] %>
        <% if region_segments.any? || wave_ids.any? %>
          <%
            # cc → { count:, name:, segment_ids: [...] }: one region segment
            # per country (see ResolvesResultSegments), keyed here by its
            # lowercase map shape id.
            map_data = {}
            region_segments.each do |seg|
              next if seg[:country].blank?
              cc = seg[:country].downcase
              map_data[cc] ||= { count: 0, name: WorldRegions.name_for(seg[:country]), segment_ids: [] }
              map_data[cc][:count] += seg[:count]
              map_data[cc][:segment_ids] << seg[:id]
            end
          %>
          <div class="regions-box" data-controller="results-compare"
               data-results-compare-url-value="<%= survey_results_compare_path(@survey) %>"
               data-results-compare-summarize-url-value="<%= survey_results_summarize_texts_path(@survey) %>"
               <%# Waves take priority as the default comparison when both exist
                   — running waves usually means the owner is mid-study and
                   wants that lens first; regions stay one click away in the
                   same picker either way. %>
               data-results-compare-preselect-value="<%= wave_ids.any? ? (["overall"] + wave_ids).to_json : "" %>">
            <div class="regions-box-head">
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.5);">🌍 <%= region_segments.any? ? "Audience segments" : "Compare segments" %></span>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.35);">
                <%= region_segments.any? ? "Click a country on the map to compare segments of your audience" : "Compare waves, or any other segment, side by side" %>
              </span>
              <button type="button" class="compare-open-btn" style="margin-left:auto;"
                      data-results-compare-target="openBtn"
                      data-action="click->results-compare#toggle">⛶ Compare segments</button>
            </div>

            <%# ── Map stays visible & clickable at all times; the comparison
                panel docks beside it (never over it, so nothing on the map
                is ever hidden behind the panel). Compare mode takes this
                whole stage (map + panel) full-screen for real room to
                compare — see the controller for why it's this element (not
                the controller root above) that gets moved to <body>. ── %>
            <div class="regions-box-body" data-results-compare-target="stage">
              <div class="compare-stage-row">
                <div class="regions-map-col">
                  <%# Positioned wrapper the controller zooms against — when
                      every selected segment is in one country, the map zooms
                      in on that country's shape for a closer look. ── %>
                  <div class="compare-map-stage" data-results-compare-target="mapStage">
                    <%= render "shared/world_map" %>
                  </div>
                </div>

                <div class="compare-panel hidden" data-results-compare-target="panel">
                  <div class="compare-panel-head">
                    <div>
                      <div class="compare-panel-title">Compare segments</div>
                      <div class="compare-panel-meta" data-results-compare-target="meta">Loading…</div>
                    </div>
                    <button type="button" class="compare-close-btn" aria-label="Close">✕</button>
                  </div>
                  <div class="compare-body" data-results-compare-target="body"></div>
                </div>
              </div>

              <%# A single horizontally-scrolling row along the bottom of the
                  screen — not a wrapped grid beside the map — so picking
                  regions never eats into the map's own space. Lives outside
                  .compare-stage-row so it spans the full width, under both
                  the map and the panel. ── %>
              <div class="compare-picker-wrap hidden" data-results-compare-target="pickerWrap">
                <div class="compare-picker-label">🌍 Segments — click to add or remove</div>
                <div class="compare-picker" data-results-compare-target="picker"></div>
              </div>
            </div>
          </div>
          <script type="application/json" id="results-region-map-data"><%= map_data.to_json.html_safe %></script>
        <% end %>

        <%# ── Filterable feed: stats + segment pills + per-question cards ── %>
        <%= turbo_frame_tag "results-feed" do %>

          <%# Stats strip %>
          <div style="display:flex;align-items:center;gap:16px;padding:2px 0 6px;">
            <%# The tally updates live as answers land; the breakdown below
                rebuilds on request. Only meaningful on the unsegmented view —
                a segment's count comes from its own filtered scope, which a
                broadcast carrying whole-Verto totals would contradict. %>
            <% if @active_segment && @active_segment[:id] != "overall" %>
              <div style="display:flex;align-items:baseline;gap:5px;">
                <span style="font-family:'Alata',sans-serif;font-size:34px;color:#01EACB;line-height:1;"><%= @total %></span>
                <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.35);">response<%= @total == 1 ? "" : "s" %></span>
              </div>
            <% else %>
              <%# The toggle lives OUTSIDE #results-live — that node is replaced
                  wholesale on every broadcast (see results_live partial) and
                  would wipe any state kept inside it. Off by default: opt-in,
                  not a reversal of why auto-rebuild was rejected (see the
                  partial's own comment). %>
              <div data-controller="results-autorefresh"
                   data-results-autorefresh-url-value="<%= survey_results_path(@survey, segment: @active_segment[:id]) %>"
                   data-action="turbo:before-stream-render->results-autorefresh#markDirty"
                   style="display:flex;align-items:center;gap:8px;">
                <%= turbo_stream_from(*ResultsActivity.stream_for(@survey)) %>
                <%= render "surveys/results_live",
                      survey: @survey, live: false,
                      **ResultsActivity.counts_for(@survey) %>
                <button type="button" data-results-autorefresh-target="toggle"
                        data-action="click->results-autorefresh#toggle"
                        style="font-family:'ABeeZee',sans-serif;font-size:11px;color:rgba(255,255,255,0.35);background:transparent;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:3px 8px;cursor:pointer;white-space:nowrap;">Auto ↻ off</button>
              </div>
            <% end %>
            <% if @active_segment && @active_segment[:id] != "overall" %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);">of <%= @overall_total %> overall</span>
            <% end %>
            <div style="width:1px;height:20px;background:rgba(255,255,255,0.1);"></div>
            <% if @survey.published_at %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);">Published <%= @survey.published_at.strftime("%b %-d, %Y") %></span>
            <% end %>
            <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
              <%= link_to play_survey_url(@survey.publish_token),
                    style: "font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);text-decoration:none;",
                    target: "_blank" do %>↗ Play link<% end %>

              <%# ── Download CSV (raw responses / aggregated summary) ── %>
              <% csv_item = "display:block;padding:8px 12px;border-radius:7px;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);text-decoration:none;white-space:nowrap;" %>
              <details class="results-export-menu" style="position:relative;">
                <summary style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);white-space:nowrap;transition:all 0.15s;">⤓ Download</summary>
                <div style="position:absolute;right:0;top:calc(100% + 6px);background:#272D4A;border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:6px;min-width:185px;z-index:30;box-shadow:0 10px 28px rgba(0,0,0,0.4);display:flex;flex-direction:column;">
                  <%= link_to "Raw responses (.csv)", survey_results_export_path(@survey, kind: "responses", segment: @active_segment[:id]),
                        data: { turbo: false }, style: csv_item,
                        onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                  <%= link_to "Summary (.csv)", survey_results_export_path(@survey, kind: "summary", segment: @active_segment[:id]),
                        data: { turbo: false }, style: csv_item,
                        onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                  <%= link_to "Raw responses (.xlsx)", survey_results_export_path(@survey, kind: "responses", segment: @active_segment[:id], format: "xlsx"),
                        data: { turbo: false }, style: csv_item,
                        onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                  <%= link_to "Summary (.xlsx)", survey_results_export_path(@survey, kind: "summary", segment: @active_segment[:id], format: "xlsx"),
                        data: { turbo: false }, style: csv_item,
                        onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                  <%# One respondent's own data, for a subject access or erasure
                      request. Admin-only, so it's only offered to admins. %>
                  <% if current_membership&.admin? %>
                    <div style="height:1px;background:rgba(255,255,255,0.1);margin:5px 8px;"></div>
                    <%= link_to t("respondent_data.menu_link"), survey_respondent_data_path(@survey),
                          style: csv_item,
                          onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                  <% end %>
                </div>
              </details>

              <%# ── Share results: a public, read-only link to this page
                  (SharedResultsController). Same dropdown chrome as Download
                  above; copy-link idiom cribbed from the test-link block in
                  surveys/show.html.erb. ── %>
              <details class="results-export-menu" style="position:relative;">
                <summary style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);white-space:nowrap;transition:all 0.15s;">🔗 Share results</summary>
                <div style="position:absolute;right:0;top:calc(100% + 6px);background:#272D4A;border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:14px;min-width:280px;z-index:30;box-shadow:0 10px 28px rgba(0,0,0,0.4);">
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.6);line-height:1.5;margin-bottom:10px;">
                    A read-only link to these results — no sign-in needed. Open-ended answers, contact details and exports stay hidden.
                  </div>
                  <% if @survey.results_share_token.present? %>
                    <input type="text" readonly id="results-share-url"
                           value="<%= shared_results_url(@survey.results_share_token) %>"
                           style="width:100%;padding:8px 12px;border-radius:10px;background:rgba(1,234,203,0.07);border:1px solid rgba(1,234,203,0.25);color:rgba(255,255,255,0.78);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);outline:none;" />
                    <div style="display:flex;gap:8px;margin-top:8px;">
                      <button type="button"
                              onclick="(navigator.clipboard?.writeText(document.getElementById('results-share-url').value) ?? Promise.reject()).then(()=>{this.textContent='Copied!';setTimeout(()=>this.textContent='Copy link',2000)}).catch(()=>{this.textContent='Copy failed — select &amp; copy';setTimeout(()=>this.textContent='Copy link',2000)})"
                              style="flex:1;padding:8px;border-radius:10px;background:transparent;color:rgba(255,255,255,0.78);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);border:1px solid rgba(255,255,255,0.2);cursor:pointer;">Copy link</button>
                      <%= link_to "↗ Open", shared_results_path(@survey.results_share_token), target: "_blank",
                            style: "flex:1;text-align:center;padding:8px;border-radius:10px;background:transparent;color:rgba(255,255,255,0.78);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);border:1px solid rgba(255,255,255,0.2);cursor:pointer;text-decoration:none;" %>
                    </div>

                    <%# Minting, pausing and revoking the link are admin calls
                        (ResultsSharesController), so only an admin is shown
                        the buttons — everyone else gets the address to pass
                        on, which is the part sharing actually needs. %>
                    <% if current_membership&.admin? %>
                      <% if @survey.results_share_active? %>
                        <%= button_to "Pause", results_share_survey_path(@survey), method: :patch, params: { active: "0" },
                              form: { style: "margin:8px 0 0;" },
                              style: "width:100%;padding:8px;border-radius:10px;background:transparent;color:rgba(255,255,255,0.55);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);border:1px solid rgba(255,255,255,0.12);cursor:pointer;" %>
                      <% else %>
                        <div style="margin-top:8px;padding:6px 10px;border-radius:8px;background:rgba(255,204,0,0.1);color:#FFCC00;font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);">Paused — the link keeps working once resumed.</div>
                        <%= button_to "Resume", results_share_survey_path(@survey), method: :patch, params: { active: "1" },
                              form: { style: "margin:8px 0 0;" },
                              style: "width:100%;padding:8px;border-radius:10px;background:rgba(1,234,203,0.15);color:#01EACB;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);border:1px solid rgba(1,234,203,0.3);cursor:pointer;" %>
                      <% end %>
                      <%= button_to "Reset link", results_share_survey_path(@survey), method: :post, params: { reset: "1" },
                            form: { style: "margin:6px 0 0;", data: { turbo_confirm: "Reset the link? The old one stops working immediately." } },
                            style: "width:100%;padding:8px;border-radius:10px;background:transparent;color:rgba(255,255,255,0.55);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);border:1px solid rgba(255,255,255,0.12);cursor:pointer;" %>
                      <%= button_to "Turn off sharing", results_share_survey_path(@survey), method: :delete,
                            form: { style: "margin:6px 0 0;", data: { turbo_confirm: "Turn off results sharing? The link stops working immediately." } },
                            style: "width:100%;padding:8px;border-radius:10px;background:transparent;color:rgba(255,110,110,0.75);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);border:1px solid rgba(255,110,110,0.2);cursor:pointer;" %>
                    <% elsif !@survey.results_share_active? %>
                      <div style="margin-top:8px;padding:6px 10px;border-radius:8px;background:rgba(255,204,0,0.1);color:#FFCC00;font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);"><%= t("results.share_paused_by_admin") %></div>
                    <% end %>
                  <% elsif current_membership&.admin? %>
                    <%= button_to "Enable results sharing", results_share_survey_path(@survey), method: :post,
                          form: { style: "margin:0;" },
                          style: "width:100%;padding:10px;border-radius:12px;background:#01EACB;color:#1C2034;font-family:'ABeeZee',sans-serif;font-size: var(--text-md);border:none;cursor:pointer;font-weight:600;" %>
                  <% else %>
                    <div style="padding:8px 10px;border-radius:8px;background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.45);font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);"><%= t("results.share_not_enabled") %></div>
                  <% end %>
                </div>
              </details>

              <%# ── Connect / Export to Google Sheets ── %>
              <% if google_sheets_configured? %>
                <% if Current.user&.google_connected? %>
                  <%= form_with url: survey_google_sheet_path(@survey, segment: @active_segment[:id]), method: :post,
                        data: { controller: "sheets-export", action: "submit->sheets-export#submit", turbo: false },
                        html: { style: "display:flex;align-items:center;gap:8px;margin:0;" } do %>
                    <button type="submit" data-sheets-export-target="button"
                            style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;background:rgba(1,234,203,0.12);border:1px solid rgba(1,234,203,0.32);padding:5px 12px;border-radius:8px;white-space:nowrap;transition:background 0.15s;"
                            onmouseover="this.style.background='rgba(1,234,203,0.2)'" onmouseout="this.style.background='rgba(1,234,203,0.12)'">Export to Google Sheets</button>
                    <span data-sheets-export-target="status" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.45);white-space:nowrap;"></span>
                  <% end %>
                <% else %>
                  <%= link_to "Connect Google Sheets", google_connect_path(survey_id: @survey.id, segment: @active_segment[:id]),
                        data: { turbo: false },
                        style: "font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;background:rgba(1,234,203,0.12);border:1px solid rgba(1,234,203,0.32);padding:5px 12px;border-radius:8px;text-decoration:none;white-space:nowrap;transition:background 0.15s;",
                        onmouseover: "this.style.background='rgba(1,234,203,0.2)'", onmouseout: "this.style.background='rgba(1,234,203,0.12)'" %>
                <% end %>
              <% end %>

              <%# ── AI Report: brief → generate → preview, edit in place, download
                  PDF, save to Google Drive. First open shows a 3-question brief
                  (goal / audience / length) that steers the AI away from a
                  generic, over-long report; the answers persist on the Verto so
                  regenerations reuse them. ── %>
              <div data-controller="report-export"
                   data-report-export-stream-url-value="<%= survey_results_report_stream_path(@survey) %>"
                   data-report-export-drive-url-value="<%= survey_google_drive_path(@survey) %>"
                   data-report-export-save-url-value="<%= survey_results_report_path(@survey) %>"
                   data-report-export-exists-value="<%= @survey.results_report.present? %>"
                   data-report-export-brief-value="<%= @survey.results_report_brief.presence || "{}" %>"
                   style="display:inline-flex;">
                <button type="button" data-action="click->report-export#open"
                        style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#1C2034;background:#01EACB;border:none;padding:5px 14px;border-radius:8px;white-space:nowrap;font-weight:600;">✨ AI Report</button>

                <div class="report-modal hidden" data-report-export-target="modal" data-action="click->report-export#backdrop">
                  <div class="report-modal-card" data-action="click->report-export#stop">
                    <div class="report-modal-head">
                      <span>✨ AI Report</span>
                      <button type="button" class="report-modal-x" data-action="click->report-export#close" aria-label="Close">✕</button>
                    </div>
                    <div class="report-modal-body">
                      <div data-report-export-target="status" class="report-modal-status"></div>

                      <%# Report brief — three questions that guide the AI. %>
                      <div class="report-brief hidden" data-report-export-target="brief">
                        <div class="report-brief-intro">Three quick questions so the report says what you need — nothing generic, no padding.</div>
                        <label class="report-brief-field">
                          What should this report achieve?
                          <input type="text" data-report-export-target="goal"
                                 placeholder="e.g. Show our funder the programme's impact on confidence" />
                        </label>
                        <label class="report-brief-field">
                          Who will read it?
                          <input type="text" data-report-export-target="audience"
                                 placeholder="e.g. Board members with 5 minutes, not analysts" />
                        </label>
                        <label class="report-brief-field">
                          How long should it be?
                          <select data-report-export-target="length">
                            <option value="short">Short — about a page</option>
                            <option value="standard" selected>Standard — two to three pages</option>
                            <option value="detailed">Detailed — full breakdown</option>
                          </select>
                        </label>
                        <div class="report-brief-field">
                          What should it include?
                          <div style="display:flex;flex-direction:column;gap:6px;margin-top:6px;">
                            <label style="display:flex;align-items:center;gap:8px;font-weight:normal;cursor:pointer;">
                              <input type="checkbox" checked value="key_findings" data-report-export-target="sectionBoxes" />
                              Key findings
                            </label>
                            <label style="display:flex;align-items:center;gap:8px;font-weight:normal;cursor:pointer;">
                              <input type="checkbox" checked value="breakdown" data-report-export-target="sectionBoxes" />
                              Question-by-question breakdown
                            </label>
                            <label style="display:flex;align-items:center;gap:8px;font-weight:normal;cursor:pointer;">
                              <input type="checkbox" checked value="patterns" data-report-export-target="sectionBoxes" />
                              Patterns &amp; recommendations
                            </label>
                          </div>
                          <span style="display:block;margin-top:4px;font-size:12px;opacity:0.65;">The executive summary is always included.</span>
                        </div>
                        <button type="button" class="report-foot-btn report-foot-primary" style="align-self:flex-start;"
                                data-action="click->report-export#generate">✨ Generate report</button>
                      </div>

                      <div data-report-export-target="body" class="report-doc"></div>
                      <textarea class="report-editor hidden" data-report-export-target="editor"
                                spellcheck="false" aria-label="Edit the report markdown"></textarea>
                    </div>
                    <div class="report-modal-foot">
                      <%# Both renders are built by a job (each spikes 100-200MB), so this
                          asks for one and collects it when it's ready rather than holding
                          the request open for it. Same create endpoint for both — see
                          report_export_controller.js#_requestRender. %>
                      <button type="button" class="report-foot-btn report-foot-primary"
                              data-action="click->report-export#downloadPdf"
                              data-report-export-target="pdfBtn"
                              data-report-export-render-url="<%= survey_report_renders_path(@survey) %>">⤓ Download PDF</button>
                      <%# Figures only, no AI step — works even before a report has ever
                          been generated for this Verto. %>
                      <button type="button" class="report-foot-btn"
                              data-action="click->report-export#downloadInfographic"
                              data-report-export-render-url="<%= survey_report_renders_path(@survey) %>">🖼 Share card (PDF)</button>
                      <% if google_sheets_configured? %>
                        <button type="button" class="report-foot-btn" data-action="click->report-export#saveDrive" data-report-export-target="driveBtn">Save to Google Drive</button>
                        <span class="report-foot-status" data-report-export-target="driveStatus"></span>
                      <% end %>
                      <%# Hand-editing the report is editing (ResultsReportsController#update
                          refuses a viewer), so a viewer isn't shown the way in. The
                          Stimulus controller treats both targets as optional. %>
                      <% if can_edit_vertos? %>
                        <button type="button" class="report-foot-btn hidden" data-action="click->report-export#edit" data-report-export-target="editBtn">✎ Edit</button>
                        <button type="button" class="report-foot-btn hidden" data-action="click->report-export#save" data-report-export-target="saveBtn">✓ Save changes</button>
                      <% end %>
                      <%# An explicit Regenerate rewrites the stored report under a new
                          brief, hand edits and all (ResultsReportStreamsController
                          refuses a viewer's once one exists); the first Generate still
                          comes from the brief above. %>
                      <% if can_edit_vertos? %>
                        <button type="button" class="report-foot-btn hidden" data-action="click->report-export#regenerate" data-report-export-target="regenBtn">↻ Regenerate</button>
                      <% end %>
                      <button type="button" class="report-foot-btn report-foot-close" data-action="click->report-export#close" style="margin-left:auto;">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%# OAuth round-trip feedback — flash isn't rendered on fullscreen pages %>
          <% if params[:google_connected] %>
            <div style="margin:0 0 10px;padding:9px 14px;border-radius:10px;background:rgba(1,234,203,0.1);border:1px solid rgba(1,234,203,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;">✓ Google connected. Click “Export to Google Sheets” to create your spreadsheet.</div>
          <% elsif params[:google_error] %>
            <div style="margin:0 0 10px;padding:9px 14px;border-radius:10px;background:rgba(255,30,111,0.1);border:1px solid rgba(255,30,111,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#FF6FA0;">Couldn’t connect to Google Sheets. Please try again.</div>
          <% end %>

          <%# ── Wave over wave (creator's view) ── Deliberately ABOVE the
              date/segment pills too, same reasoning as the leaderboard below:
              waves ARE the axis of comparison, so the pills must not also
              narrow them. %>
          <% if @wave_stats&.size.to_i >= 2 %>
            <div class="s-card" style="cursor:default;overflow:visible;margin-bottom:10px;">
              <div class="s-card-header" style="padding:9px 14px;gap:10px;">
                <span class="s-badge" style="background:rgba(97,91,245,0.18);color:#9d97ff;">🔁 Wave over wave</span>
                <%# The "Compare segments" trigger further down opens this same
                    panel already preselected to these waves — see the regions
                    box below, which mounts the results-compare controller
                    this card sits outside of (a second button here would have
                    no controller ancestor to dispatch to). %>
                <span style="margin-left:auto;font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.35);">↓ Compare below</span>
              </div>
              <div style="padding:10px 16px 12px;">
                <div style="display:flex;gap:20px;flex-wrap:wrap;<%= "margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,0.06);" if @wave_deltas.present? %>">
                  <% @wave_stats.each do |stat| %>
                    <div style="min-width:96px;">
                      <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.45);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:140px;"><%= stat[:wave].display_label %></div>
                      <div style="font-family:'Alata',sans-serif;font-size: var(--text-2xl);color:#fff;line-height:1.3;"><%= stat[:count] %></div>
                      <% if stat[:returning].positive? %>
                        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:#01EACB;"><%= pluralize(stat[:returning], "returner") %></div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <% if @wave_deltas.present? %>
                  <div style="display:flex;flex-direction:column;gap:6px;">
                    <% @wave_deltas.each do |d| %>
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= d[:question] %>">
                          <%= d[:question].truncate(44) %> <span style="color:rgba(255,255,255,0.35);">· <%= d[:label].truncate(20) %></span>
                        </span>
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);white-space:nowrap;color:<%= d[:delta] > 0 ? "#01EACB" : (d[:delta] < 0 ? "#FF6FA0" : "rgba(255,255,255,0.4)") %>;">
                          <%= d[:delta] > 0 ? "+" : "" %><%= d[:delta] %>pp
                        </span>
                      </div>
                    <% end %>
                    <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.35);margin-top:2px;">
                      Baseline (<%= @wave_stats.first[:wave].display_label %>) vs latest (<%= @wave_stats.last[:wave].display_label %>), leading option at baseline.
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# ── Responders (creator's view) ── Deliberately ABOVE the
              date/segment pills for the same reason as its neighbours: a
              responder's runs span waves, dates and segments — spanning them
              is what the code exists to do — so this must not read as
              filtered. Counts only: the grouped ANSWERS live in the export's
              Responder column, and the admin-gated respondent-data page is
              the per-person drill-down. Never on the public share page,
              which renders only _result_cards. %>
          <% if @responders.present? %>
            <div class="s-card" style="cursor:default;overflow:visible;margin-bottom:10px;">
              <div class="s-card-header" style="padding:9px 14px;gap:10px;">
                <span class="s-badge" style="background:rgba(12,167,255,0.15);color:#0CA7FF;">🔑 Responders</span>
                <span style="margin-left:auto;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:#01EACB;">
                  <%= @responders_total %> responder<%= @responders_total == 1 ? "" : "s" %>
                </span>
              </div>
              <div style="padding:10px 16px 12px;">
                <% @responders.each_with_index do |r, i| %>
                  <div style="display:flex;align-items:center;gap:10px;padding:5px 0;<%= 'border-top:1px solid rgba(255,255,255,0.06);' if i.positive? %>">
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:#fff;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= r[:name] %></span>
                    <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:#fff;white-space:nowrap;"><%= pluralize(r[:plays], "play") %></span>
                    <% if r[:waves] %>
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);min-width:86px;text-align:right;white-space:nowrap;"><%= r[:waves] %> of <%= @responder_wave_count %> wave<%= @responder_wave_count == 1 ? "" : "s" %></span>
                    <% end %>
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.45);min-width:78px;text-align:right;white-space:nowrap;"><%= r[:last_played].strftime("%-d %b %Y") %></span>
                  </div>
                <% end %>
                <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);">
                  <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                    Names are system-made and anonymous — never the code a respondent typed. The same names group the export's Responder column.
                  </span>
                  <% if @responders_total > @responders.size %>
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                      Showing the top <%= @responders.size %> of <%= @responders_total %>.
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <%# ── Leaderboard (creator's view) ── Deliberately ABOVE the
              date/segment pills: the board is whole-Verto (identities span
              the filters, and the retake policy already decides which runs
              count), so it must not read as filtered by the pills below. %>
          <% if @survey.leaderboard_active? && @leaderboard %>
            <div class="s-card" style="cursor:default;overflow:visible;margin-bottom:10px;">
              <div class="s-card-header" style="padding:9px 14px;gap:10px;">
                <span class="s-badge" style="background:rgba(245,158,11,0.15);color:#F59E0B;">🏆 Leaderboard</span>
                <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);">
                  <%= { "accumulate" => "Retakes add points",
                        "no_redo"    => "First run counts",
                        "restart"    => "Latest run counts" }[@survey.leaderboard_retake_policy] %><%= " · No retests" if @survey.no_retests? %><% if (rank_type = @survey.leaderboard_rank_type) %> · ranked by <%= rank_type["icon"] %> <%= rank_type["name"] %><% end %>
                </span>
                <span style="margin-left:auto;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:<%= @leaderboard_player_count > 0 ? '#01EACB' : 'rgba(255,255,255,0.2)' %>;">
                  <%= @leaderboard_player_count %> player<%= @leaderboard_player_count == 1 ? "" : "s" %>
                </span>
              </div>
              <div style="padding:10px 16px 12px;">
                <% if @leaderboard.empty? %>
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);padding:6px 0;">
                    No players on the board yet — finished plays appear here with their token totals.
                  </div>
                <% else %>
                  <% @leaderboard.each_with_index do |entry, i| %>
                    <div style="display:flex;align-items:center;gap:10px;padding:5px 0;<%= 'border-top:1px solid rgba(255,255,255,0.06);' if i.positive? %>">
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.75);min-width:1.8em;text-align:right;"><%= i + 1 %></span>
                      <span style="flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= @leaderboard_names[entry[:key_digest]] %></span>
                        <%# The breakdown mirrors the player's board: every type's total,
                            so a board ranked by one type still shows the others. %>
                        <% if @survey.token_types.size >= 2 && entry[:totals].is_a?(Hash) %>
                          <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <%= @survey.token_types.map { |tt| "#{tt['icon']} #{number_with_delimiter(entry[:totals][tt['id']].to_i)}" }.join(" · ") %>
                          </span>
                        <% end %>
                      </span>
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-md);color:#fff;white-space:nowrap;"><%= "#{rank_type['icon']} " if rank_type %><%= number_with_delimiter(entry[:total]) %></span>
                    </div>
                  <% end %>
                  <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);">
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                      Names are system-made and anonymous — they can't be traced back to a respondent.
                    </span>
                    <% if @leaderboard_player_count > @leaderboard.size %>
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                        Showing the top <%= @leaderboard.size %> of <%= @leaderboard_player_count %>.
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Date window. Narrows the base, so the segment counts below are
              counted within the window too — a range that only moved the charts
              while the pills kept whole-Verto totals would misreport one of them. %>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:0 0 8px;">
            <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-right:2px;">When</span>
            <% date_range_options.each do |opt| %>
              <% current = (@date_range.presence || "all") == opt[:id] %>
              <%# The window is deliberately kept when switching it, but the
                  segment is not carried across ranges blindly — a segment that
                  falls below the small-cell threshold in a narrower window
                  disappears, and linking to it would 404 the pill. %>
              <%= link_to opt[:label],
                    survey_results_path(@survey, range: (opt[:id] == "all" ? nil : opt[:id])),
                    class: "seg-pill", aria: { current: current.to_s } %>
            <% end %>
          </div>

          <%# Segment filter pills — partner shares, regions and demographics %>
          <% if @segments.size > 1 %>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:0 0 10px;">
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-right:2px;">View</span>
              <% @segments.each do |seg| %>
                <%= link_to survey_results_path(@survey, segment: seg[:id], range: @date_range),
                      class: "seg-pill", aria: { current: (seg[:id] == @active_segment[:id]).to_s } do %>
                  <%= seg[:label] %><span class="seg-pill-count"><%= seg[:count] %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>

        <%# ── Per-question cards ── extracted to a partial so the public
            shared-results page can reuse it (see _result_cards.html.erb). %>
        <%= render "surveys/result_cards", aggregated: @aggregated, total: @total,
              answers: { survey: @survey, segment: @active_segment[:id], range: @date_range } %>

        <% end %><%# end results-feed turbo-frame %>

      </div>
    </div><%# end scrollable feed %>

  </div><%# end middle column %>

  <%# ── Chat panel ── %>
  <div style="width:320px;flex-shrink:0;border-left:1px solid rgba(255,255,255,0.07);background:#161B2E;display:flex;flex-direction:column;overflow:hidden;position:relative;z-index:1;"
       data-controller="results-chat"
       data-results-chat-url-value="<%= survey_chat_path(@survey) %>"
       data-results-chat-theme-value="<%= @survey.theme.to_s.gsub('"', '&quot;') %>">

    <%# Chat header %>
    <div style="flex-shrink:0;padding:16px 18px 12px;border-bottom:1px solid rgba(255,255,255,0.07);">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-md);color:#fff;letter-spacing:0.03em;">Ask Verto</span>
        <span style="margin-left:auto;font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.25);background:rgba(1,234,203,0.12);border:1px solid rgba(1,234,203,0.2);border-radius:20px;padding:2px 8px;">AI</span>
      </div>
      <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);margin:6px 0 0;line-height:1.5;">Ask questions about your Verto results</p>
    </div>

    <%# Messages area %>
    <div data-results-chat-target="messages"
         style="flex:1;overflow-y:auto;padding:14px 12px;display:flex;flex-direction:column;gap:0;">
    </div>

    <%# Input area %>
    <div style="flex-shrink:0;border-top:1px solid rgba(255,255,255,0.07);padding:12px 12px;">
      <div style="display:flex;gap:8px;align-items:flex-end;">
        <textarea data-results-chat-target="input"
                  data-action="keydown->results-chat#keydown"
                  placeholder="Ask about your results…"
                  rows="2"
                  style="flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:9px 12px;color:rgba(255,255,255,0.8);font-family:'ABeeZee',sans-serif;font-size: var(--text-md);resize:none;outline:none;line-height:1.5;"
                  onfocus="this.style.borderColor='rgba(1,234,203,0.4)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
        <button data-results-chat-target="sendBtn"
                data-action="click->results-chat#send"
                style="flex-shrink:0;width:36px;height:36px;border-radius:10px;background:#01EACB;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s;"
                onmouseover="this.style.background='#00C4AB'"
                onmouseout="this.style.background='#01EACB'">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7h12M7 1l6 6-6 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

  </div><%# end chat panel %>

</div><%# end outer shell %>
