<style>
  .results-export-menu > summary { list-style: none; }
  .results-export-menu > summary::-webkit-details-marker { display: none; }
  .results-export-menu > summary::marker { content: ""; }
  .results-export-menu > summary:hover { color: #fff; border-color: rgba(255,255,255,0.3); }
  [data-results-autorefresh-target="toggle"].is-on { color: #01EACB; border-color: rgba(1,234,203,0.4); background: rgba(1,234,203,0.08); }
</style>

<%# Full-viewport app-shell — body stays overflow:hidden from fullscreen layout %>
<div style="height:100%;background:#1C2034;display:flex;overflow:hidden;position:relative;"
     data-controller="freeform-answers"
     data-action="keydown.esc@window->freeform-answers#closeOnEsc">

  <%# ── Freeform answers panel — one shell for the whole page, opened by the
      "View all answers" button on any freeform result card (_result_cards).
      Outside the results-feed frame on purpose: the frame is replaced on
      every refresh and segment switch, and the panel must survive that. The
      list is fetched from SurveyTextAnswersController, paged, so a Verto with
      thousands of answers costs the page nothing until someone asks. ── %>
  <div data-freeform-answers-target="modal" class="app-modal hidden" role="dialog" aria-modal="true">
    <div class="app-modal__backdrop" data-action="click->freeform-answers#close"></div>
    <div class="app-modal__panel freeform-modal">
      <div class="freeform-modal__head">
        <div style="min-width:0;">
          <div class="freeform-modal__eyebrow"><%= t("results.freeform_eyebrow") %></div>
          <div class="freeform-modal__question" data-freeform-answers-target="question"></div>
        </div>
        <button type="button" class="freeform-modal__close" data-action="click->freeform-answers#close"
                aria-label="<%= t("share_modal.close") %>">✕</button>
      </div>
      <div class="freeform-modal__tools">
        <input type="search" class="freeform-modal__search"
               placeholder="<%= t("results.freeform_search_placeholder") %>"
               data-freeform-answers-target="search"
               data-action="input->freeform-answers#search keydown.enter->freeform-answers#searchNow" />
        <button type="button" class="freeform-modal__copy" data-freeform-answers-target="copy"
                data-copy-label="<%= t("results.freeform_copy") %>"
                data-action="click->freeform-answers#copy"><%= t("results.freeform_copy") %></button>
      </div>
      <div class="freeform-modal__body">
        <div class="freeform-modal__list" data-freeform-answers-target="list"></div>
        <div class="freeform-modal__status" data-freeform-answers-target="status" aria-live="polite"></div>
        <button type="button" class="freeform-modal__more" hidden data-freeform-answers-target="more"
                data-action="click->freeform-answers#loadMore"><%= t("results.freeform_load_more") %></button>
      </div>
    </div>
  </div>

  <%# Subtle on-brand ambient orbs behind everything %>
  <div class="gen-orbs results-orbs" aria-hidden="true">
    <div class="gen-orb gen-orb-1"></div>
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
    <div class="gen-orb gen-orb-4"></div>
  </div>

  <%# ── Middle: top-bar + scrollable content ── %>
  <div style="flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden;position:relative;z-index:1;">

    <%# ── Top bar ── the page hides the global nav (@hide_main_nav), so this
        strip is the whole chrome and it wears the editor's convention: the
        way out as a glass pill at the inline-start edge, the Verto's name
        beside it. Read-only here — renaming stays in the editor, which is
        why these carry .is-static rather than the editor's contenteditable.
        The theme only joins the name when the two differ: the pair reads as
        name-then-subject, and most Vertos share both, which would otherwise
        print the same words twice. %>
    <div class="results-top-bar">
      <%= link_to root_path, class: "editor-leave-btn",
            title: t("results.leave_results"),
            "aria-label": t("results.leave_results") do %>
        <svg class="editor-leave-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M9.5 3.5 5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="editor-leave-label"><%= t("results.leave_results") %></span>
      <% end %>
      <span class="editor-verto-title is-static" title="<%= @survey.title %>"><%= @survey.title %></span>
      <% if @survey.theme.present? && @survey.theme != @survey.title %>
        <span class="editor-verto-title editor-verto-theme is-static" title="<%= @survey.theme %>"><%= @survey.theme %></span>
      <% end %>
      <%# A viewer has no editor to go back to — the pill above is their whole
          way out, so only an editor is offered the door back into it. %>
      <% if can_edit_vertos? %>
        <%= link_to t("results.editor"), survey_path(@survey),
              style: "margin-inline-start:auto;flex-shrink:0;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.4);text-decoration:none;padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);transition:all 0.15s;",
              onmouseover: "this.style.color='white';this.style.borderColor='rgba(255,255,255,0.3)'",
              onmouseout:  "this.style.color='rgba(255,255,255,0.4)';this.style.borderColor='rgba(255,255,255,0.1)'" %>
      <% end %>
    </div>

    <%# ── The Verto's own header ── outside the scrolling div on purpose, so
        the tally and the two filters are pinned under the top bar instead of
        scrolling away from the feed they describe. %>
    <%= render "surveys/results_header" %>

    <%# ── The stage below the header ── a positioned box holding the scrolling
        feed and the Ask Verto panel. The panel is absolute INSIDE this rather
        than fixed to the viewport, so it starts below the header whatever
        height the header happens to be — a viewport offset would have to
        guess, and guesses the filters' wrapping would break. The stage never
        scrolls (the feed inside it does), so the panel still holds still. %>
    <div class="results-stage">
    <%# Scrollable results feed. No horizontal padding of its own — the map
        band below is full-bleed, and the reading column re-applies the gutter
        for everything that is not the map. %>
    <div style="flex:1;overflow-y:auto;padding:0 0 48px;">

<%# ── The map, full width, under the filters ─────────────────────────────
    A band rather than a card: it is the first thing under the filters and the
    last thing before the summary, and its edges are masked away on all four
    sides so it dissolves into the page instead of ending on a border. The
    summary is then lifted onto that dissolve, which is what makes the two
    read as one surface rather than two stacked blocks.

    The view it opens on is FITTED to the countries that actually have
    responses (results_compare_controller#_fitHomeView) — a Europe-only study
    gets Europe, a global one gets the world. A fixed world view would spend
    most of a 1440px band on empty Pacific. ── %>
<%# ── Regions map — where responses came from (region-tagged Vertos) ──
    Also the compare-panel's mount point, so it appears whenever
    there's anything to compare even without a single tagged region:
    _setupMap already tolerates empty map data (results_compare_
    controller.js), the map just shows untinted in that case. %>
<% region_segments = @segments.select { |s| s[:id].to_s.start_with?("region_") } %>
<% wave_ids = @wave_stats&.size.to_i >= 2 ? @wave_stats.map { |s| "wave_#{s[:wave].position}" } : [] %>
<% if region_segments.any? || wave_ids.any? %>
  <%
    # cc → { count:, name:, segment_ids: [...] }: one region segment
    # per country (see ResolvesResultSegments), keyed here by its
    # lowercase map shape id.
    map_data = {}
    region_segments.each do |seg|
      next if seg[:country].blank?
      cc = seg[:country].downcase
      map_data[cc] ||= { count: 0, name: WorldRegions.name_for(seg[:country]), segment_ids: [] }
      map_data[cc][:count] += seg[:count]
      map_data[cc][:segment_ids] << seg[:id]
    end
  %>
  <div class="results-map-band" data-controller="results-compare"
       data-results-compare-url-value="<%= survey_results_compare_path(@survey) %>"
       data-results-compare-summarize-url-value="<%= survey_results_summarize_texts_path(@survey) %>"
       <%# Waves take priority as the default comparison when both exist
           — running waves usually means the owner is mid-study and
           wants that lens first; regions stay one click away in the
           same picker either way. %>
       data-results-compare-preselect-value="<%= wave_ids.any? ? (["overall"] + wave_ids).to_json : "" %>">
    <div class="regions-box-head">
      <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.5);">🌍 <%= region_segments.any? ? "Audience segments" : "Compare segments" %></span>
      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.35);">
        <%= region_segments.any? ? "Click a country on the map to compare segments of your audience" : "Compare waves, or any other segment, side by side" %>
      </span>
      <button type="button" class="compare-open-btn" style="margin-left:auto;"
              data-results-compare-target="openBtn"
              data-action="click->results-compare#toggle">⛶ Compare segments</button>
    </div>

    <%# ── Map stays visible & clickable at all times; the comparison
        panel docks beside it (never over it, so nothing on the map
        is ever hidden behind the panel). Compare mode takes this
        whole stage (map + panel) full-screen for real room to
        compare — see the controller for why it's this element (not
        the controller root above) that gets moved to <body>. ── %>
    <div class="regions-box-body" data-results-compare-target="stage">
      <div class="compare-stage-row">
        <div class="regions-map-col">
          <%# Positioned wrapper the controller zooms against — when
              every selected segment is in one country, the map zooms
              in on that country's shape for a closer look. ── %>
          <div class="compare-map-stage" data-results-compare-target="mapStage">
            <%= render "shared/world_map" %>
          </div>
        </div>

        <div class="compare-panel hidden" data-results-compare-target="panel">
          <div class="compare-panel-head">
            <div>
              <div class="compare-panel-title">Compare segments</div>
              <div class="compare-panel-meta" data-results-compare-target="meta">Loading…</div>
            </div>
            <button type="button" class="compare-close-btn" aria-label="Close">✕</button>
          </div>
          <div class="compare-body" data-results-compare-target="body"></div>
        </div>
      </div>

      <%# A single horizontally-scrolling row along the bottom of the
          screen — not a wrapped grid beside the map — so picking
          regions never eats into the map's own space. Lives outside
          .compare-stage-row so it spans the full width, under both
          the map and the panel. ── %>
      <div class="compare-picker-wrap hidden" data-results-compare-target="pickerWrap">
        <div class="compare-picker-label">🌍 Segments — click to add or remove</div>
        <div class="compare-picker" data-results-compare-target="picker"></div>
      </div>
    </div>
  </div>
  <script type="application/json" id="results-region-map-data"><%= map_data.to_json.html_safe %></script>
<% end %>

<%# The reading column: everything that is not the map. Lifted onto the map's
    bottom fade, which is what makes the two bleed into one another rather
    than stacking. %>
<div class="results-feed-col">

<%# ── Ask Verto summary ── the lead paragraph only, lifted onto the map's
    fade. The rest is a click away: this is the top of the page, and four
    paragraphs of prose between the map and the first question is a wall to
    scroll past for anyone who came for the numbers. ── %>
<div id="av-card" class="summary-card results-summary">
  <div class="summary-rainbow"></div>
  <div class="results-summary-head">
    <span class="results-summary-eyebrow"><%= t("results.ask_verto") %></span>
    <span id="av-thinking" class="gen-shimmer--brand results-summary-thinking"><%= t("results.analysing") %></span>
  </div>
  <div class="results-summary-body">
    <div id="av-text" class="results-summary-lead"></div>
    <div id="av-rest" class="results-summary-rest" hidden></div>
    <button type="button" id="av-more" class="results-summary-more" hidden
            aria-expanded="false" aria-controls="av-rest">
      <span class="results-summary-more-label">See more</span>
      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6.5 8 10.5l4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<script>
  (function() {
    const card    = document.getElementById("av-card")
    const leadEl  = document.getElementById("av-text")
    const restEl  = document.getElementById("av-rest")
    const moreBtn = document.getElementById("av-more")
    const thinkEl = document.getElementById("av-thinking")
    card.classList.add("is-generating")
    const stop = () => { card.classList.remove("is-generating"); thinkEl.style.display = "none" }

    // The text arrives as a stream, so the split has to be redone on every
    // chunk: the first paragraph is not knowable until the blank line after
    // it lands, and until then everything IS the first paragraph.
    let full = ""
    const paint = () => {
      const parts = full.split(/\n{2,}/)
      leadEl.textContent = parts[0] || ""
      const rest = parts.slice(1).join("\n\n")
      restEl.textContent = rest
      moreBtn.hidden = rest.length === 0
    }

    moreBtn.addEventListener("click", () => {
      const open = restEl.hasAttribute("hidden")
      restEl.toggleAttribute("hidden", !open)
      moreBtn.setAttribute("aria-expanded", String(open))
      moreBtn.classList.toggle("is-open", open)
      moreBtn.querySelector(".results-summary-more-label").textContent = open ? "See less" : "See more"
    })

    fetch(<%= survey_results_summary_path(@survey).to_json.html_safe %>)
      .then(async r => {
        // A 503 means every streaming slot is busy, not that insights
        // are broken — show the server's wording, which says to retry.
        if (!r.ok) throw new Error((await r.text()).trim())
        const reader = r.body.getReader()
        const dec    = new TextDecoder()
        let started  = false
        function pump() {
          return reader.read().then(({ done, value }) => {
            if (done) { stop(); return }
            if (!started) { started = true; stop() }
            full += dec.decode(value, { stream: true })
            paint()
            return pump()
          })
        }
        return pump()
      })
      .catch(err => {
        stop()
        leadEl.textContent = (err && err.message) || "Insights unavailable right now."
        leadEl.style.color = "rgba(255,255,255,0.2)"
      })
  })()
</script>

        <%# ── Filterable feed: stats + segment pills + per-question cards ── %>
        <%= turbo_frame_tag "results-feed" do %>

          <%# OAuth round-trip feedback — flash isn't rendered on fullscreen pages %>
          <% if params[:google_connected] %>
            <div style="margin:0 0 10px;padding:9px 14px;border-radius:10px;background:rgba(1,234,203,0.1);border:1px solid rgba(1,234,203,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;">✓ Google connected. Click “Export to Google Sheets” to create your spreadsheet.</div>
          <% elsif params[:google_error] %>
            <div style="margin:0 0 10px;padding:9px 14px;border-radius:10px;background:rgba(255,30,111,0.1);border:1px solid rgba(255,30,111,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#FF6FA0;">Couldn’t connect to Google Sheets. Please try again.</div>
          <% end %>

          <%# ── Wave over wave (creator's view) ── Deliberately ABOVE the
              date/segment pills too, same reasoning as the leaderboard below:
              waves ARE the axis of comparison, so the pills must not also
              narrow them. %>
          <% if @wave_stats&.size.to_i >= 2 %>
            <div class="s-card" style="cursor:default;overflow:visible;margin-bottom:10px;">
              <div class="s-card-header" style="padding:9px 14px;gap:10px;">
                <span class="s-badge" style="background:rgba(97,91,245,0.18);color:#9d97ff;">🔁 Wave over wave</span>
                <%# The "Compare segments" trigger further down opens this same
                    panel already preselected to these waves — see the regions
                    box below, which mounts the results-compare controller
                    this card sits outside of (a second button here would have
                    no controller ancestor to dispatch to). %>
                <span style="margin-left:auto;font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.35);">↓ Compare below</span>
              </div>
              <div style="padding:10px 16px 12px;">
                <div style="display:flex;gap:20px;flex-wrap:wrap;<%= "margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,0.06);" if @wave_deltas.present? %>">
                  <% @wave_stats.each do |stat| %>
                    <div style="min-width:96px;">
                      <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.45);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:140px;"><%= stat[:wave].display_label %></div>
                      <div style="font-family:'Alata',sans-serif;font-size: var(--text-2xl);color:#fff;line-height:1.3;"><%= stat[:count] %></div>
                      <% if stat[:returning].positive? %>
                        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:#01EACB;"><%= pluralize(stat[:returning], "returner") %></div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <% if @wave_deltas.present? %>
                  <div style="display:flex;flex-direction:column;gap:6px;">
                    <% @wave_deltas.each do |d| %>
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= d[:question] %>">
                          <%= d[:question].truncate(44) %> <span style="color:rgba(255,255,255,0.35);">· <%= d[:label].truncate(20) %></span>
                        </span>
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);white-space:nowrap;color:<%= d[:delta] > 0 ? "#01EACB" : (d[:delta] < 0 ? "#FF6FA0" : "rgba(255,255,255,0.4)") %>;">
                          <%= d[:delta] > 0 ? "+" : "" %><%= d[:delta] %>pp
                        </span>
                      </div>
                    <% end %>
                    <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.35);margin-top:2px;">
                      Baseline (<%= @wave_stats.first[:wave].display_label %>) vs latest (<%= @wave_stats.last[:wave].display_label %>), leading option at baseline.
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# ── Responders (creator's view) ── Deliberately ABOVE the
              date/segment pills for the same reason as its neighbours: a
              responder's runs span waves, dates and segments — spanning them
              is what the code exists to do — so this must not read as
              filtered. Counts only: the grouped ANSWERS live in the export's
              Responder column, and the admin-gated respondent-data page is
              the per-person drill-down. Never on the public share page,
              which renders only _result_cards. %>
          <% if @responders.present? %>
            <div class="s-card" style="cursor:default;overflow:visible;margin-bottom:10px;">
              <div class="s-card-header" style="padding:9px 14px;gap:10px;">
                <span class="s-badge" style="background:rgba(12,167,255,0.15);color:#0CA7FF;">🔑 Responders</span>
                <span style="margin-left:auto;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:#01EACB;">
                  <%= @responders_total %> responder<%= @responders_total == 1 ? "" : "s" %>
                </span>
              </div>
              <div style="padding:10px 16px 12px;">
                <% @responders.each_with_index do |r, i| %>
                  <div style="display:flex;align-items:center;gap:10px;padding:5px 0;<%= 'border-top:1px solid rgba(255,255,255,0.06);' if i.positive? %>">
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:#fff;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= r[:name] %></span>
                    <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:#fff;white-space:nowrap;"><%= pluralize(r[:plays], "play") %></span>
                    <% if r[:waves] %>
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);min-width:86px;text-align:right;white-space:nowrap;"><%= r[:waves] %> of <%= @responder_wave_count %> wave<%= @responder_wave_count == 1 ? "" : "s" %></span>
                    <% end %>
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.45);min-width:78px;text-align:right;white-space:nowrap;"><%= r[:last_played].strftime("%-d %b %Y") %></span>
                  </div>
                <% end %>
                <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);">
                  <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                    Names are system-made and anonymous — never the code a respondent typed. The same names group the export's Responder column.
                  </span>
                  <% if @responders_total > @responders.size %>
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                      Showing the top <%= @responders.size %> of <%= @responders_total %>.
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <%# ── Leaderboard (creator's view) ── Deliberately ABOVE the
              date/segment pills: the board is whole-Verto (identities span
              the filters, and the retake policy already decides which runs
              count), so it must not read as filtered by the pills below. %>
          <% if @survey.leaderboard_active? && @leaderboard %>
            <div class="s-card" style="cursor:default;overflow:visible;margin-bottom:10px;">
              <div class="s-card-header" style="padding:9px 14px;gap:10px;">
                <span class="s-badge" style="background:rgba(245,158,11,0.15);color:#F59E0B;">🏆 Leaderboard</span>
                <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);">
                  <%= { "accumulate" => "Retakes add points",
                        "no_redo"    => "First run counts",
                        "restart"    => "Latest run counts" }[@survey.leaderboard_retake_policy] %><%= " · No retests" if @survey.no_retests? %><% if (rank_type = @survey.leaderboard_rank_type) %> · ranked by <%= rank_type["icon"] %> <%= rank_type["name"] %><% end %>
                </span>
                <span style="margin-left:auto;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:<%= @leaderboard_player_count > 0 ? '#01EACB' : 'rgba(255,255,255,0.2)' %>;">
                  <%= @leaderboard_player_count %> player<%= @leaderboard_player_count == 1 ? "" : "s" %>
                </span>
              </div>
              <div style="padding:10px 16px 12px;">
                <% if @leaderboard.empty? %>
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);padding:6px 0;">
                    No players on the board yet — finished plays appear here with their token totals.
                  </div>
                <% else %>
                  <% @leaderboard.each_with_index do |entry, i| %>
                    <div style="display:flex;align-items:center;gap:10px;padding:5px 0;<%= 'border-top:1px solid rgba(255,255,255,0.06);' if i.positive? %>">
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.75);min-width:1.8em;text-align:right;"><%= i + 1 %></span>
                      <span style="flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= @leaderboard_names[entry[:key_digest]] %></span>
                        <%# The breakdown mirrors the player's board: every type's total,
                            so a board ranked by one type still shows the others. %>
                        <% if @survey.token_types.size >= 2 && entry[:totals].is_a?(Hash) %>
                          <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <%= @survey.token_types.map { |tt| "#{tt['icon']} #{number_with_delimiter(entry[:totals][tt['id']].to_i)}" }.join(" · ") %>
                          </span>
                        <% end %>
                      </span>
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-md);color:#fff;white-space:nowrap;"><%= "#{rank_type['icon']} " if rank_type %><%= number_with_delimiter(entry[:total]) %></span>
                    </div>
                  <% end %>
                  <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);">
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                      Names are system-made and anonymous — they can't be traced back to a respondent.
                    </span>
                    <% if @leaderboard_player_count > @leaderboard.size %>
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.55);">
                        Showing the top <%= @leaderboard.size %> of <%= @leaderboard_player_count %>.
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>


        <%# ── Per-question cards ── extracted to a partial so the public
            shared-results page can reuse it (see _result_cards.html.erb). %>
        <%= render "surveys/result_cards", aggregated: @aggregated, total: @total,
              answers: { survey: @survey, segment: @active_segment[:id], range: @date_range } %>

        <% end %><%# end results-feed turbo-frame %>

</div><%# end reading column %>
    </div><%# end scrollable feed %>

  <%# ── Ask Verto ── a floating CTA that opens the chat OVER the feed rather
      than beside it. It used to be a permanent 320px column, which charged
      every reader the width whether or not they ever asked anything — and the
      feed is the page. Both halves are position:fixed, so they hold the
      corner while the feed scrolls underneath (the shell doesn't scroll; the
      feed div inside it does, which is why this is fixed rather than sticky).
      The pill is the Ask page's own .ask-fab, so the product has one floating
      CTA rather than two that nearly match.
      No backdrop, deliberately: this is a panel over the page, not a modal —
      the numbers it is answering about stay readable and scrollable beside
      it. ── %>
  <div data-controller="results-chat"
       data-results-chat-url-value="<%= survey_chat_path(@survey) %>"
       data-results-chat-theme-value="<%= @survey.theme.to_s.gsub('"', '&quot;') %>"
       data-action="keydown.esc@window->results-chat#closeOnEsc">

    <%# Round, gradient, glowing: this is the one control on the page that
        opens an AI, and it wears the brand ramp the rest of the product's
        generating states use. The ramp is the RING and the glyph sits on a
        dark core — the ramp drifts through #FFFA77, and no single glyph
        colour stays legible across a moving rainbow.
        The label is a real element rather than an aria-label so there is one
        source of truth for the accessible name and the hover tooltip; it is
        faded rather than hidden, which keeps it in the accessibility tree. %>
    <button type="button" class="results-ask-fab"
            data-results-chat-target="fab"
            data-action="click->results-chat#toggle"
            aria-expanded="false" aria-controls="results-ask-panel">
      <span class="results-ask-fab-label"><%= t("results.ask_verto") %></span>
      <span class="results-ask-fab-core" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
          <path d="M12 2.6l1.9 5.6 5.6 1.9-5.6 1.9L12 17.6l-1.9-5.6L4.5 10.1l5.6-1.9L12 2.6Z"
                fill="currentColor"/>
          <path d="M18.4 15.1l.85 2.5 2.5.85-2.5.85-.85 2.5-.85-2.5-2.5-.85 2.5-.85.85-2.5Z"
                fill="currentColor" opacity="0.75"/>
        </svg>
      </span>
    </button>

    <div id="results-ask-panel" class="results-ask-panel"
         data-results-chat-target="panel"
         aria-label="<%= t("results.ask_verto") %>">

      <div class="results-ask-head">
        <div class="results-ask-head-row">
          <span class="results-ask-title">Ask Verto</span>
          <span class="results-ask-badge">AI</span>
          <button type="button" class="results-ask-close"
                  data-action="click->results-chat#close"
                  aria-label="<%= t("share_modal.close") %>">✕</button>
        </div>
        <p class="results-ask-sub">Ask questions about your Verto results</p>
      </div>

      <div class="results-ask-messages" data-results-chat-target="messages"></div>

      <div class="results-ask-composer">
        <textarea data-results-chat-target="input"
                  data-action="keydown->results-chat#keydown"
                  placeholder="Ask about your results…"
                  rows="2"></textarea>
        <button class="results-ask-send" data-results-chat-target="sendBtn"
                data-action="click->results-chat#send">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12M7 1l6 6-6 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div><%# end Ask Verto %>

    </div><%# end stage %>
  </div><%# end middle column %>

</div><%# end outer shell %>
