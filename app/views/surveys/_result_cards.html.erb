<%# Per-question result cards — extracted verbatim from surveys/results.html.erb
    (2026-08-17) so the public shared-results page (SharedResultsController)
    can reuse the exact same rendering the owner sees, minus the sections that
    can carry free-text PII.

    Redesigned 2026-09-21 onto the page's own dark surface. It used to be a
    120px type-gradient panel beside a WHITE one: a white sheet under the map's
    fade read as a separate document, and every answer on it had to be drawn in
    a second palette. Now the card is dark, and an answer is a ROW whose
    background IS its bar — the label sits on its share rather than next to it,
    so one row height carries the picture, the label, the percentage and the
    count without a four-column grid a long option name breaks.

    The pictures are the Verto's own: the card's panel photo beside the
    question, and each option's own photo on its row — see
    ResultsHelper#result_option_thumbs for why that map is built by index and
    read by label. Only where one EXISTS. A card with no art was briefly given
    a tile of its type's gradient instead, to keep the questions aligned down
    the feed; rendered against real photographs it read as a hole where a
    picture had failed, which is worse than a ragged left edge — and a deck
    with no art at all is then uniformly flush, rather than uniformly holed.

    Locals:
      aggregated — AggregatesSurveyResults#aggregate_results output
      total      — the active segment's response count (welcome_card's tally)
      shared     — when true, redacts open_ended texts, "other" free text and
                   contact_form's lead table to count-only lines. Defaults to
                   false so the owner's own results.html.erb, which renders
                   this unconditionally, doesn't have to pass it.
      answers    — { survey:, segment:, range: } for the "View all answers"
                   button on freeform cards (SurveyTextAnswersController),
                   carrying the segment and date range the page aggregated
                   under so the panel shows the same answers the card counted.
                   Omitted (the shared page, or any renderer without a page
                   filter to follow), no button is drawn.
      insights   — true where the page has a question-insights controller to
                   fill the readings in. The WHY half of the aside needs no
                   such thing — it is already on the card — so the shared page
                   gets the provenance without the analysis, which is the
                   right way round: why a question was asked is worth sharing
                   with whoever you sent the link to; the creator's reading of
                   their own numbers is theirs. %>
<%
  shared   = local_assigns.fetch(:shared, false)
  answers  = local_assigns[:answers]
  insights = local_assigns.fetch(:insights, false)
%>
<% aggregated.each_with_index do |result, idx| %>
  <% type      = result[:type]
     card_data = result[:card]
     total_ans = result[:total]
     card_meta = card_type_meta(type)
     thumb     = result_card_thumb_style(card_data)
     opt_thumbs = result_option_thumbs(card_data)
     # On the owner's page, a row of a card with counted answers is a BUTTON
     # that opens the "over time" tab on that answer (answer_timeline_controller
     # + SurveyTimelinesController), carrying the card's endpoint with the
     # page's segment already on it, the row's key and the words to show. The
     # shared page, and a card with nothing to count, keep plain rows.
     timeline = answers && AnswerTimeline.countable?(card_data)
     row_tag  = ->(key, label, statement = nil, zero = false) do
       classes = "rc-row#{' is-zero' if zero}"
       if timeline
         { tag: :button, type: "button", class: classes, title: t("results.timeline_open_hint"),
           data: { action: "click->answer-timeline#open",
                   answer_timeline_url_param: survey_results_timeline_path(answers[:survey], card_index: idx, segment: answers[:segment], statement: statement),
                   answer_timeline_key_param: key.to_s, answer_timeline_label_param: label.to_s,
                   answer_timeline_question_param: card_data["text"].to_s } }
       else
         { tag: :div, class: classes }
       end
     end %>

  <%# The id is the outline rail's anchor (surveys/_results_outline). Rendered
      here rather than added by JS so the rail's links work before any script
      has run, and on the shared page, which has no rail but does get
      linkable questions out of it. %>
  <div class="rc-card" id="rc-card-<%= idx %>">
    <%# The card's own surface, so the aside beside it can be a real sibling
        column rather than an absolutely positioned overlay. display:contents
        below the breakpoint, and on any card with no aside, so neither pays
        for a box it does not need. %>
    <div class="rc-main">

    <div class="rc-head">
      <span class="s-badge <%= card_meta[:badge_css] %>"><%= card_meta[:badge] %></span>
      <span class="rc-cardn">Card <%= idx + 1 %></span>
      <% if card_data["common_question_id"].present? %>
        <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:100px;background:rgba(97,91,245,0.18);color:#9d97ff;font-family:'Alata',sans-serif;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;"
              title="<%= t('common_questions.badge_tooltip', default: 'From a Common Questions set') %>">
          <%= t("common_questions.badge", default: "Common") %>
        </span>
      <% end %>
      <span class="rc-answers <%= "is-zero" if total_ans.to_i.zero? %>">
        <%= total_ans %> answer<%= total_ans == 1 ? "" : "s" %>
      </span>
    </div>

    <div class="rc-ask">
      <% if thumb %><div class="rc-thumb" style="<%= thumb %>"></div><% end %>
      <div class="rc-q"><%= card_data["text"] %></div>
    </div>

    <% if total_ans.to_i.zero? %>
      <div class="rc-empty">No responses yet</div>

    <% elsif type == "welcome_card" %>
      <div class="rc-big-line">
        <span class="rc-big"><%= total %></span>
        <span class="rc-big-word">respondent<%= total == 1 ? "" : "s" %> started</span>
      </div>

    <%# `scenario` belongs here and was missing: the aggregator has always
        tallied it (accumulate_value) and finalize_card has always returned it
        in the choice shape, but no branch drew the counts — so a scenario card
        reported "43 answers" over nothing at all. %>
    <% elsif %w[multiple_choice yes_no select_one_grid select_many select_many_grid scenario].include?(type) %>
      <% counts = result[:counts]; grand = [ counts.values.sum.to_f, 1.0 ].max %>
      <div class="rc-rows">
        <% counts.sort_by { |_, v| -v }.each do |label, count| %>
          <% pct = ((count / grand) * 100).round %>
          <% row = row_tag.call(label, label, nil, count.to_i.zero?) %>
          <%= content_tag(row[:tag], row.except(:tag)) do %>
            <div class="rc-fill" style="width:<%= pct %>%;"></div>
            <div class="rc-rowin">
              <% if (style = opt_thumbs[label.to_s]) %>
                <div class="rc-othumb" style="<%= style %>"></div>
              <% end %>
              <span class="rc-label" title="<%= label %>"><%= label %></span>
              <span class="rc-pct"><%= pct %>%</span>
              <span class="rc-n"><%= count %></span>
            </div>
          <% end %>
        <% end %>
      </div>

    <% elsif type == "prioritise" %>
      <%# counts[label] = sum of ranks; mean position = sum / total.
          Lower mean = higher priority, so sort ascending. The row's fill is
          that priority score, not a share of anything — the number beside it
          is the average position, which is what a ranking card reports. %>
      <% counts = result[:counts]; total_n = [ result[:total].to_i, 1 ].max %>
      <% ranked = counts.map { |label, sum| [ label, sum.to_f / total_n ] }.sort_by { |_, mean| mean } %>
      <% n = [ ranked.size, 1 ].max %>
      <div class="rc-rows">
        <% ranked.each_with_index do |(label, mean), i| %>
          <% pct = (((n - mean + 1) / n.to_f) * 100).clamp(0, 100).round %>
          <div class="rc-row">
            <div class="rc-fill" style="width:<%= pct %>%;background:rgba(97,91,245,0.3);"></div>
            <div class="rc-rowin">
              <span class="rc-rank"><%= i + 1 %></span>
              <% if (style = opt_thumbs[label.to_s]) %>
                <div class="rc-othumb" style="<%= style %>"></div>
              <% end %>
              <span class="rc-label" title="<%= label %>"><%= label %></span>
              <span class="rc-n">avg <%= mean.round(1) %></span>
            </div>
          </div>
        <% end %>
      </div>

    <% elsif %w[range nps].include?(type) %>
      <%# Every step of the scale, including the ones nobody picked: a gap in a
          scale is the finding, and dropping those rows would quietly change
          the shape being read. They are recessed instead (.is-zero). %>
      <% labels = Array(card_data["options"]).presence || (type == "nps" ? (0..10).map(&:to_s) : []) %>
      <% n = [ labels.size, 2 ].max; grand = [ result[:counts].values.sum.to_f, 1.0 ].max %>
      <div class="rc-rows is-compact">
        <% n.times do |i| %>
          <% count = result[:counts][i].to_i; label = labels[i] || "Step #{i + 1}"; pct = ((count / grand) * 100).round %>
          <% row = row_tag.call(i, label, nil, count.zero?) %>
          <%= content_tag(row[:tag], row.except(:tag)) do %>
            <div class="rc-fill" style="width:<%= pct %>%;"></div>
            <div class="rc-rowin">
              <% if (style = opt_thumbs[label.to_s]) %>
                <div class="rc-othumb" style="<%= style %>"></div>
              <% end %>
              <span class="rc-label" title="<%= label %>"><%= label %></span>
              <span class="rc-pct"><%= pct %>%</span>
              <span class="rc-n"><%= count %></span>
            </div>
          <% end %>
        <% end %>
      </div>

    <% elsif type == "rating" %>
      <% avg = result[:avg]; grand = [ result[:counts].values.sum.to_f, 1.0 ].max %>
      <div class="rc-stars">
        <div class="rc-stars-glyphs">
          <% 5.times do |i| %><span style="color:<%= i < avg.round ? '#FFCC00' : 'rgba(255,255,255,0.18)' %>"><%= i < avg.round ? "★" : "☆" %></span><% end %>
        </div>
        <span class="rc-avg"><%= avg %></span>
      </div>
      <div class="rc-rows is-compact">
        <% 5.downto(1) do |star| %>
          <% count = result[:counts][star].to_i; pct = ((count / grand) * 100).round %>
          <%# Teal bars, gold stars. Amber at the alpha a row fill needs comes
              out olive over this navy — yellow over blue does — so the gold
              stays on the glyphs and the average, where it is opaque. %>
          <% row = row_tag.call(star, "★" * star, nil, count.zero?) %>
          <%= content_tag(row[:tag], row.except(:tag)) do %>
            <div class="rc-fill" style="width:<%= pct %>%;"></div>
            <div class="rc-rowin">
              <span class="rc-label rc-stars-row"><%= "★" * star %></span>
              <span class="rc-pct"><%= pct %>%</span>
              <span class="rc-n"><%= count %></span>
            </div>
          <% end %>
        <% end %>
      </div>

    <% elsif type == "tap_card" %>
      <%# One block per swipe statement, captioned with the statement (and its
          own photo, which is what option_images holds on a tap card), then a
          row per answer on the card's OWN scale — TapScales, not a hardcoded
          yes/unsure/no, so a five-point card reports on five. Every response
          in the scale draws a row even at zero, which is also what keeps the
          denominator honest: a statement 40% of people were unsure about used
          to report as a straight majority because Unsure was in neither the
          bar nor the total (fixed 2026-08; don't reintroduce a filter here).

          The stacked bar this replaced still renders on the Common Question
          results page (shared/_tap_result_bars), which is a light surface. %>
      <% responses = TapScales.for_card(result[:card]) %>
      <% result[:counts].each do |label, tallies| %>
        <% next unless tallies.is_a?(Hash) %>
        <% tap_counts = responses.map { |r| tallies[r["key"]].to_i } %>
        <% tap_total  = [ tap_counts.sum.to_f, 1.0 ].max %>
        <div class="rc-group rc-rows is-compact">
          <div class="rc-group-head">
            <% if (style = opt_thumbs[label.to_s]) %>
              <div class="rc-othumb" style="<%= style %>"></div>
            <% end %>
            <span class="rc-group-label"><%= label %></span>
          </div>
          <% responses.each_with_index do |response, i| %>
            <% count = tap_counts[i]; pct = ((count / tap_total) * 100).round %>
            <% color = response["color"].presence || "#8B85FF" %>
            <%# The row's tint is the answer's own colour, so restyling an
                answer restyles its bar. Eight-digit hex, guarded — a colour
                that isn't one would otherwise paint "…3D" and fall back to
                nothing at all. %>
            <% tint = color.match?(/\A#[0-9a-fA-F]{6}\z/) ? "#{color}3D" : "rgba(1,234,203,0.22)" %>
            <% row = row_tag.call(response["key"], response["label"], label, count.zero?) %>
            <%= content_tag(row[:tag], row.except(:tag)) do %>
              <div class="rc-fill" style="width:<%= pct %>%;background:<%= tint %>;"></div>
              <div class="rc-rowin">
                <span class="rc-dot" style="background:<%= color %>;"></span>
                <span class="rc-label"><%= response["label"] %></span>
                <span class="rc-pct"><%= pct %>%</span>
                <span class="rc-n"><%= count %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

    <% elsif type == "open_ended" %>
      <% if shared %>
        <div class="rc-sub"><%= t("shared_results.hidden_answers", count: result[:texts].size) %></div>
      <% else %>
        <%# A preview of the latest few — the last ten the aggregator
            walked, which is arrival order for a Verto answered live —
            clamped by CSS rather than cut at a character count, and a
            door to the rest: the panel behind "View all answers"
            (freeform_answers_controller + SurveyTextAnswersController)
            pages through every answer in full, newest first, within the
            segment and date range this page is showing, and searches
            them. Before it, the card stopped at twenty truncated answers
            and a "+ N more" that led nowhere. %>
        <% preview = result[:texts].last(10).reverse %>
        <div style="display:flex;flex-direction:column;gap:5px;">
          <% preview.each do |text| %>
            <%# The demographic tail's answers are structured strings, not
                sentences — "DE|" is a person in Germany. See
                DemographicQuestions.display_answer; every other card's text
                comes back through it unchanged. %>
            <div class="freeform-preview-item"><div class="freeform-preview-item__text"><%= DemographicQuestions.display_answer(card_data, text) %></div></div>
          <% end %>
        </div>
        <%# The demographic tail used to be denied this button, on the grounds
            that its values are picks rather than answers anyone reads one by
            one. Two hundred and ninety-two birth months with no way to see
            past the newest ten is not that argument working — they are
            answers, and now that they are rendered as words they are
            readable ones. %>
        <% if result[:texts].any? && answers %>
          <button type="button" class="freeform-view-all"
                  data-action="click->freeform-answers#open"
                  data-freeform-answers-url-param="<%= survey_results_answers_path(answers[:survey], card_index: idx, segment: answers[:segment], range: answers[:range]) %>"
                  data-freeform-answers-question-param="<%= card_data["text"] %>">
            <%= t("results.view_all_answers", count: result[:texts].size) %> →
          </button>
        <% end %>
      <% end %>

    <% elsif type == "contact_form" %>
      <% if shared %>
        <div class="rc-sub"><%= t("shared_results.hidden_answers", count: Array(result[:entries]).size) %></div>
      <% else %>
        <%# Lead table — the submitted contact objects, newest last.
            Identifying data by design; the full set is in the CSV. %>
        <div class="rc-table-wrap">
          <table class="rc-table">
            <thead>
              <tr>
                <% Survey::CONTACT_FIELDS.each do |field| %>
                  <th><%= t("card.contact_#{field}") %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% Array(result[:entries]).first(50).each do |entry| %>
                <tr>
                  <% Survey::CONTACT_FIELDS.each do |field| %>
                    <td><%= entry[field].to_s.truncate(60) %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if Array(result[:entries]).size > 50 %>
            <div class="rc-more">+ <%= result[:entries].size - 50 %> more</div>
          <% end %>
        </div>
      <% end %>

    <% end %>

    <% if result[:other_texts].present? %>
      <div class="rc-section">
        <div class="rc-section-head">Other · <%= result[:other_texts].size %> free-text</div>
        <% if shared %>
          <div class="rc-sub"><%= t("shared_results.hidden_answers", count: result[:other_texts].size) %></div>
        <% else %>
          <%# The newest ten, in full, and the same panel the freeform cards
              open for the rest (kind=other on SurveyTextAnswersController):
              an "Other" written in is an answer like any other, and this
              section used to stop at twenty cut to 200 characters and a
              "+ N more" that led nowhere. Newest first, like the freeform
              preview — the aggregator walks in arrival order. %>
          <div class="rc-quotes">
            <% result[:other_texts].last(10).reverse.each do |text| %>
              <div class="rc-quote"><%= text %></div>
            <% end %>
          </div>
          <% if answers %>
            <div style="margin-top:8px;">
              <button type="button" class="freeform-view-all"
                      data-action="click->freeform-answers#open"
                      data-freeform-answers-url-param="<%= survey_results_answers_path(answers[:survey], card_index: idx, kind: "other", segment: answers[:segment], range: answers[:range]) %>"
                      data-freeform-answers-question-param="<%= card_data["text"] %>"
                      data-freeform-answers-eyebrow-param="<%= t("results.freeform_other_eyebrow") %>">
                <%= t("results.view_all_answers", count: result[:other_texts].size) %> →
              </button>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    </div><%# end rc-main %>

    <%# ── What this question's answers say, and why it was asked ────────────
        Beside the question rather than under the answers: the feed's right
        margin was empty on any screen wide enough for the outline rail, and
        twenty of these stacked under twenty charts would have added four
        thousand pixels to a page that has spent three rounds getting shorter.
        Below 1290px there is no margin and it drops back under the card.

        The WHY half is free — competency, condition and outcome are already
        on the card, written by the generator against Playverto's reading of
        the OECD "Acting in the world" sequence (config/competencies.yml), and
        shown in the editor's Why tab. Most decks carry none of it: the tagging
        only exists on cards that came through the generator or were optimised,
        so the half renders or doesn't, per card.

        The READING half is filled in by question-insights from one cached
        call. Rendered as an empty slot so there is a place to put it — the
        aside itself only exists if one of the two halves can appear. %>
    <% if CardTypes.question?(type) %>
      <% comp = Framework.competency?(card_data["competency"]) ? Framework.competency(card_data["competency"]) : nil
         cond = Framework.condition?(card_data["condition"])   ? Framework.condition(card_data["condition"])   : nil
         has_why = comp || cond || card_data["outcome"].present? %>
      <% if has_why || insights %>
        <aside class="rc-aside" aria-label="<%= t("results.insight_aside_label") %>">
          <% if insights %>
            <div class="rc-tell" data-question-insights-target="slot" data-index="<%= idx %>" hidden>
              <div class="rc-tell-head"><%= t("results.insight_heading") %></div>
              <p class="rc-tell-body"></p>
            </div>
            <div class="rc-tell-wait gen-shimmer--brand" data-question-insights-target="wait" hidden><%= t("results.insight_reading") %></div>
          <% end %>

          <% if has_why %>
            <div class="rc-why">
              <div class="rc-why-head"><%= t("results.why_heading") %></div>
              <% if comp || cond %>
                <div class="rc-why-badges">
                  <% [ comp, cond ].compact.each do |meta| %>
                    <span class="rc-why-badge" style="--why-accent:<%= meta["accent"] %>;"
                          title="<%= meta["blurb"] %>">
                      <span class="rc-why-dot"></span><%= meta["label"] %>
                    </span>
                  <% end %>
                </div>
              <% end %>
              <% if card_data["outcome"].present? %>
                <p class="rc-why-body"><%= card_data["outcome"] %></p>
              <% end %>
            </div>
          <% end %>
        </aside>
      <% end %>
    <% end %>

  </div><%# end rc-card %>
<% end %><%# end per-question cards loop %>
