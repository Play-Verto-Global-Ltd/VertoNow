<%# Media picker modal — opened from the "+ Add media" CTA on each card's left panel. %>
<div class="media-modal-backdrop"
     data-media-picker-target="backdrop"
     data-action="click->media-picker#backdropClick"
     hidden>
  <div class="media-modal" data-media-picker-target="modal">

    <div class="media-modal-head">
      <%# The head stays put while a stage takes over the body, so it is the one
          thing telling a creator which of the modal's jobs they are in. It used
          to read "Add media" through the crop stage as well, which is how you
          end up cropping under a heading for something you are not doing.
          media-picker swaps it per stage and puts it back on close. %>
      <div class="media-modal-title"
           data-media-picker-target="modalTitle"
           data-default-label="Add media"
           data-background-label="<%= t("editor.header_background", default: "Header background") %>"
           data-mobile-background-label="<%= t("editor.mobile_background", default: "Mobile background") %>"
           data-reposition-label="<%= t("editor.reposition", default: "Reposition") %>"
           data-crop-label="<%= t("editor.reposition_crop", default: "Crop & zoom") %>">Add media</div>
      <button type="button" class="media-modal-close"
              data-action="click->media-picker#close"
              aria-label="Close">✕</button>
    </div>

    <div class="media-modal-tabs" role="tablist">
      <button type="button" class="media-modal-tab"
              role="tab" aria-selected="true"
              data-tab="upload"
              data-media-picker-target="tab"
              data-action="click->media-picker#switchTab">Upload</button>
      <button type="button" class="media-modal-tab"
              role="tab" aria-selected="false"
              data-tab="library"
              data-media-picker-target="tab"
              data-action="click->media-picker#switchTab">Verto Library</button>
    </div>

    <div class="media-modal-body">
      <%# Upload pane %>
      <div data-media-picker-target="pane" data-pane="upload">
        <label class="media-upload-zone"
               data-media-picker-target="dropzone"
               data-action="dragover->media-picker#dragover dragleave->media-picker#dragleave drop->media-picker#drop">
          <span class="media-upload-zone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4"></path>
              <path d="M7 9l5-5 5 5"></path>
              <path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path>
            </svg>
          </span>
          <div>Click to choose an image, or drag &amp; drop</div>
          <%# GIF is on the list and it is kept as a GIF: media-picker#_readFile
              stores the original bytes rather than re-encoding through a
              canvas, which would keep one frame and freeze the animation. %>
          <div class="media-upload-hint">PNG, JPG, GIF, WebP or SVG — large images are resized automatically, GIFs keep their animation</div>
          <input type="file" accept="image/*" hidden
                 data-media-picker-target="fileInput"
                 data-action="change->media-picker#fileChosen" />
        </label>
        <div class="media-upload-error"
             data-media-picker-target="uploadError"
             style="margin-top:10px;color:#FF1E6F;font-family:'ABeeZee',sans-serif;font-size:13px;line-height:1.4;"
             hidden></div>
        <%# Admin opt-in: also file this upload in the org's brand library so
            it becomes pickable in every Verto. Off by default — the library
            caps at Organisation::MAX_ASSETS and one-off card art shouldn't
            silt it up. %>
        <% if current_membership&.admin? %>
          <label style="display:flex;align-items:center;gap:8px;margin-top:12px;cursor:pointer;font-family:'ABeeZee',sans-serif;font-size:13px;color:rgba(255,255,255,0.75);">
            <input type="checkbox" data-media-picker-target="saveToLibrary"
                   style="width:15px;height:15px;accent-color:#01EACB;" />
            <%= t("js.editor.save_to_library") %>
          </label>
        <% end %>

        <%# Paste-a-LottieFiles-URL — card mode only (media-picker toggles it
            with the Photos/Videos switch). The URL goes to card_lottie, which
            fetches, scrubs and stores the JSON; only the same-origin stored
            path ever lands on the card. %>
        <div class="media-lottie-section" data-media-picker-target="lottieSection" hidden>
          <div class="media-lottie-label"><%= t("editor.lottie_section", default: "Animation (Lottie)") %></div>
          <div class="media-lottie-row">
            <input type="url" class="media-lottie-input"
                   data-media-picker-target="lottieInput"
                   placeholder="<%= t("editor.lottie_placeholder", default: "Paste a LottieFiles link, e.g. https://lottie.host/….json") %>"
                   aria-label="<%= t("editor.lottie_section", default: "Animation (Lottie)") %>" />
            <button type="button" class="media-lottie-btn"
                    data-media-picker-target="lottieBtn"
                    data-action="click->media-picker#applyLottie"><%= t("editor.lottie_apply", default: "Use animation") %></button>
          </div>
          <div class="media-lottie-hint"><%= t("editor.lottie_hint", default: "Direct .json links from lottiefiles.com or lottie.host. The animation replaces the card's photo or video.") %></div>
          <div class="media-upload-error" data-media-picker-target="lottieError"
               style="margin-top:8px;color:#FF1E6F;font-family:'ABeeZee',sans-serif;font-size:13px;line-height:1.4;" hidden></div>
        </div>


      </div>

      <%# Library pane %>
      <div data-media-picker-target="pane" data-pane="library" hidden>
        <%# Pexels stock search. Results render at the ratio of the slot being
            filled (portrait for cards, landscape for the background). The
            Photos/Videos toggle is hidden for the background (videos can't be
            a Verto backdrop). %>
        <div class="media-search">
          <div class="media-search-toggle" data-media-picker-target="mediaToggle" role="tablist">
            <button type="button" class="media-search-toggle-btn is-active"
                    role="tab" aria-selected="true" data-media="photos"
                    data-media-picker-target="mediaTab"
                    data-action="click->media-picker#switchMedia">Photos</button>
            <button type="button" class="media-search-toggle-btn"
                    role="tab" aria-selected="false" data-media="videos"
                    data-media-picker-target="mediaTab"
                    data-action="click->media-picker#switchMedia">Videos</button>
          </div>
          <input type="search"
                 class="media-search-input"
                 placeholder="Search stock photos…"
                 data-media-picker-target="searchInput"
                 data-action="input->media-picker#searchPexels keydown->media-picker#searchKeydown" />
          <p class="media-search-hint"><%= t("js.editor.stock_search_hint") %></p>
        </div>
        <section class="media-library-section"
                 data-media-picker-target="searchSection" hidden>
          <h4 class="media-library-section-label">Stock photos</h4>
          <div class="media-library-status"
               data-media-picker-target="searchStatus"></div>
          <div class="media-library-grid"
               data-media-picker-target="searchGrid"></div>
          <button type="button" class="media-load-more"
                  data-media-picker-target="loadMore"
                  data-action="click->media-picker#loadMoreStock"
                  hidden><%= t("js.editor.load_more") %></button>
        </section>

        <% groups = verto_library_images %>
        <% brand_assets = current_organisation&.ordered_assets.to_a %>
        <% library_admin = current_membership&.admin? %>
        <% if groups.any? || brand_assets.any? || library_admin %>
          <div class="media-library-sections">
            <%# The account's OWN uploaded brand assets (Organisation#assets),
                shown first so a creator reaches for their brand before the
                recommendations or the shared library. Same tile shape →
                pickLibraryItem handles selection unchanged. Admins also get
                an add-to-library tile (upload straight into the library). %>
            <% if brand_assets.any? || library_admin %>
              <section class="media-library-section">
                <h4 class="media-library-section-label"><%= t("editor.brand_library", default: "Your brand library") %></h4>
                <div class="media-library-status" data-media-picker-target="brandStatus"></div>
                <div class="media-library-grid" data-media-picker-target="brandGrid">
                  <% if library_admin %>
                    <button type="button"
                            class="media-library-item media-library-add"
                            title="<%= t("js.editor.add_to_library") %>"
                            data-action="click->media-picker#chooseLibraryFile"
                            aria-label="<%= t("js.editor.add_to_library") %>">＋</button>
                    <input type="file" hidden accept="image/*"
                           data-media-picker-target="libraryFileInput"
                           data-action="change->media-picker#libraryFileChosen" />
                  <% end %>
                  <% brand_assets.each do |att| %>
                    <%# Tile shows a small variant; the FULL-size original is
                        what data-url applies to the card when picked.

                        The tile IS a <button>, so the remove × cannot live
                        inside it — it gets a positioned cell of its own around
                        both. The cell is what the grid lays out and what lifts
                        on hover; see .media-library-cell in application.css. %>
                    <div class="media-library-cell">
                      <button type="button"
                              class="media-library-item"
                              title="<%= att.blob.filename %>"
                              style="background-image:url('<%= as_thumb_path(att) %>');"
                              data-url="<%= rails_blob_path(att.blob, only_path: true) %>"
                              data-asset-id="<%= att.id %>"
                              data-media-picker-target="libraryItem"
                              data-action="click->media-picker#pickLibraryItem"
                              aria-selected="false"></button>
                      <% if library_admin %>
                        <button type="button"
                                class="media-library-del"
                                title="<%= t("js.editor.remove_from_library") %>"
                                aria-label="<%= t("js.editor.remove_from_library") %>"
                                data-delete-url="<%= organisation_asset_path(current_organisation, att.id, format: :json) %>"
                                data-action="click->media-picker#deleteBrandAsset">×</button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </section>
            <% end %>
            <section class="media-library-section"
                     data-media-picker-target="recommendedSection" hidden>
              <h4 class="media-library-section-label"
                  data-media-picker-target="recommendedLabel">Recommended</h4>
              <div class="media-library-grid"
                   data-media-picker-target="recommendedGrid"></div>
            </section>
            <% groups.each do |folder, files| %>
              <section class="media-library-section">
                <h4 class="media-library-section-label">
                  <%= folder.presence&.tr("-", " ")&.capitalize || "Library" %>
                </h4>
                <div class="media-library-grid">
                  <% files.each do |rel| %>
                    <% url = asset_path("verto-library/#{rel}") %>
                    <button type="button"
                            class="media-library-item"
                            title="<%= rel %>"
                            style="background-image:url('<%= url %>');"
                            data-url="<%= url %>"
                            data-media-picker-target="libraryItem"
                            data-action="click->media-picker#pickLibraryItem"
                            aria-selected="false"></button>
                  <% end %>
                </div>
              </section>
            <% end %>
          </div>
        <% else %>
          <div class="media-library-empty">
            The library is empty. Drop image files into
            <code style="color:#01EACB;">app/assets/images/verto-library/</code>
            to populate this picker.
          </div>
        <% end %>
      </div>

      <%# Per-card media SETTINGS, shared by both source tabs. They live
          outside the panes on purpose: they describe the card, not where
          its picture came from, and inside the Upload pane they were
          invisible whenever the modal opened on the Verto Library (which
          it does by default). %>
      <%# Mobile header position. A card's image is a 9:16 portrait but the
          mobile header is a ~3:1 band, so `cover` shows only its middle
          stripe — a face near the top of the photo simply isn't there on a
          phone. Dragging this preview picks which stripe. Width stays full
          and there is no horizontal axis, by request: "not left or right —
          keep the width full and sticky — but to drag the image up and down
          to choose the perfect spot for mobile headers." %>
      <div class="media-focal-section" data-media-picker-target="focalSection" hidden>
        <div class="media-lottie-label"><%= t("editor.focal_label", default: "Mobile header position") %></div>
        <div class="media-focal-frame"
             data-media-picker-target="focalFrame"
             data-action="pointerdown->media-picker#focalStart">
          <div class="media-focal-img" data-media-picker-target="focalImg"></div>
          <span class="media-focal-hint"><%= t("editor.focal_hint", default: "Drag up or down") %></span>
        </div>
        <div class="media-lottie-hint"><%= t("editor.focal_note", default: "Only affects the header on phones — the full image is kept, so you can change this any time.") %></div>
      </div>
      <%# The backdrop settings — ONE section for two slots, and which slot it
          is aimed at is the modal's state (media-picker#_bgSlot), never the
          card's type:
            "panel"  — the HEADER backdrop, card.media_bg: behind an animation
                       (a pasted Lottie, or a range card's reaction set), or a
                       card carrying no media at all, where the backdrop IS the
                       panel's design and on a phone earns it a header strip.
                       Behind a photo or a video there is nothing to see, so
                       for that slot the section stays hidden rather than
                       offering a control that does nothing — media-picker
                       toggles it in _syncAnimationBg, off the same rule
                       ApplicationHelper#card_takes_backdrop? states.
            "mobile" — the MOBILE BACKGROUND, card.mobile_bg: behind the
                       question and answers on a phone, on every type.
          The label and hint swap with the slot (data-*-label / data-*-hint),
          so the creator is always told which of the two designs the colour
          they are about to pick belongs to. %>
      <div class="media-animbg-section" data-media-picker-target="animBgSection" hidden>
        <div class="media-lottie-label"
             data-media-picker-target="animBgLabel"
             data-panel-label="<%= t("editor.card_bg", default: "Card background") %>"
             data-mobile-label="<%= t("editor.mobile_background", default: "Mobile background") %>"><%= t("editor.card_bg", default: "Card background") %></div>
        <div class="media-animbg-row">
          <input type="color" class="media-animbg-color"
                 data-media-picker-target="animBgColor"
                 data-action="input->media-picker#setAnimBgColor"
                 aria-label="<%= t("editor.animation_bg_colour", default: "Background colour") %>" />
          <button type="button" class="media-animbg-btn"
                  data-action="click->media-picker#openAnimBgImage"><%= t("editor.animation_bg_image", default: "Use an image") %></button>
          <button type="button" class="media-animbg-btn is-clear"
                  data-media-picker-target="animBgClear"
                  data-panel-label="<%= t("editor.animation_bg_clear", default: "Reset to brand colour") %>"
                  data-mobile-label="<%= t("editor.mobile_bg_clear", default: "Remove background") %>"
                  data-action="click->media-picker#clearAnimBg"><%= t("editor.animation_bg_clear", default: "Reset to brand colour") %></button>
        </div>
        <div class="media-lottie-hint"
             data-media-picker-target="animBgHint"
             data-panel-hint="<%= t("editor.card_bg_hint", default: "Sits behind this card's panel — an animation, or nothing at all — and on a phone it is the card's whole top half. Without one the card uses your brand's panel colour.") %>"
             data-mobile-hint="<%= t("editor.mobile_bg_hint", default: "Behind the question and answers on a phone — below the header where this card has one. A colour, an image or a GIF. It never changes the header itself.") %>"><%= t("editor.card_bg_hint", default: "Sits behind this card's panel — an animation, or nothing at all — and on a phone it is the card's whole top half. Without one the card uses your brand's panel colour.") %></div>
      </div>
      <%# Slow push-in/out loop on the card's own photo or Lottie — never
          video (its own motion is enough) or range (already animates via
          its reaction set). media-picker toggles it in _syncAnimateAsset. %>
      <div class="media-animate-section" data-media-picker-target="animateAssetSection" hidden>
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-family:'ABeeZee',sans-serif;font-size:13px;color:rgba(255,255,255,0.75);">
          <input type="checkbox" data-media-picker-target="animateAssetToggle"
                 data-action="change->media-picker#toggleAnimateAsset"
                 style="width:15px;height:15px;accent-color:#01EACB;" />
          <%= t("editor.animate_asset", default: "Animate asset") %>
        </label>
        <div class="media-lottie-hint"><%= t("editor.animate_asset_hint", default: "A slow, gentle push in and out on loop.") %></div>
      </div>
    </div>

    <div class="media-modal-foot">
      <button type="button" class="media-clear-btn"
              data-media-picker-target="clearBtn"
              data-action="click->media-picker#clearImage"
              hidden>Remove current media</button>
      <button type="button" class="media-btn-ghost"
              data-action="click->media-picker#close">Cancel</button>
      <button type="button" class="media-btn-primary"
              data-media-picker-target="applyBtn"
              data-action="click->media-picker#applyImage"
              disabled>Apply</button>
    </div>

    <%# Reposition stage — the entry point for "Reposition" on a card panel and
        for the chip beside a tap statement's image. Unlike the crop stage it
        re-encodes nothing: it stores WHERE the media sits in the frame, which
        is the only reframing a cross-origin photo or a video can have, and is
        why every image on a card can now be moved rather than only uploads.
        The frame is sized to the real slot the media fills, so the drag is
        what the card will show. "Crop & zoom" hands off to the stage below,
        and is present only for a same-origin still. %>
    <div class="media-pos-stage" data-media-picker-target="posStage" hidden>
      <div class="media-pos-frame"
           data-media-picker-target="posFrame"
           data-action="pointerdown->media-picker#posDragStart pointermove->media-picker#posDrag pointerup->media-picker#posDragEnd pointercancel->media-picker#posDragEnd">
        <div class="media-pos-img" data-media-picker-target="posImg" hidden></div>
        <video class="media-pos-video" data-media-picker-target="posVideo"
               muted loop playsinline preload="metadata" hidden></video>
        <%# Where the card's own furniture will sit over this picture — for a
            tap statement, the statement band and the response strip. Built
            from the live card's measurements by _renderPosChrome, because the
            strip changes shape with the answer count. %>
        <div class="media-pos-chrome" data-media-picker-target="posChrome" hidden></div>
      </div>
      <%# Punching in past cover-fit. Its real job is to create slack: a picture
          whose shape already matches the frame hides nothing on that axis, so
          a drag there does nothing until there is something to reveal. Nothing
          is re-encoded — this winds back to 1 whenever the creator likes. %>
      <div class="media-crop-controls">
        <span class="media-crop-zoom-icon" aria-hidden="true">−</span>
        <input type="range" class="media-crop-zoom" min="1" max="3" step="0.01" value="1"
               data-media-picker-target="posZoom"
               aria-label="<%= t("editor.crop_zoom", default: "Zoom") %>"
               data-action="input->media-picker#posZoomChanged" />
        <span class="media-crop-zoom-icon" aria-hidden="true">+</span>
      </div>
      <%# Two hints rather than one built in JS, the same way the crop stage
          carries its legacy note: the strings stay in the locale files and out
          of the browser payload. The video one says plainly why there is no
          Crop button beside it. %>
      <div class="media-pos-hint" data-media-picker-target="posHint"><%= t("editor.reposition_hint", default: "Drag the picture to choose what the frame shows, and zoom in to move it further. The whole image is kept, so you can change this any time.") %></div>
      <div class="media-pos-hint" data-media-picker-target="posHintVideo" hidden><%= t("editor.reposition_hint_video", default: "Drag the video to choose what the frame shows, and zoom in to move it further. Videos can be repositioned but not cropped.") %></div>
      <div class="media-pos-actions">
        <button type="button" class="media-btn-ghost media-pos-crop-btn"
                data-media-picker-target="posCropBtn"
                data-action="click->media-picker#posToCrop"
                hidden><%= t("editor.reposition_crop", default: "Crop & zoom") %></button>
        <button type="button" class="media-btn-ghost"
                data-action="click->media-picker#posCancel"><%= t("editor.crop_cancel", default: "Cancel") %></button>
        <button type="button" class="media-btn-primary"
                data-action="click->media-picker#posApply"><%= t("editor.reposition_apply", default: "Save position") %></button>
      </div>
    </div>

    <%# Crop stage — shown after choosing an upload for a fixed-ratio slot
        (card / background / tap-option art), in place of the tabs/body/foot
        above, before the pick is applied. Uploads only: library and Pexels
        picks arrive pre-cropped server-side (PexelsClient::CROP_FOR). Drag to
        reposition, slider to zoom; "Skip" keeps the plain uncropped image. %>
    <div class="media-crop-stage" data-media-picker-target="cropStage" hidden>
      <div class="media-crop-frame"
           data-media-picker-target="cropFrame"
           data-action="pointerdown->media-picker#cropDragStart pointermove->media-picker#cropDrag pointerup->media-picker#cropDragEnd pointercancel->media-picker#cropDragEnd">
        <img class="media-crop-img" data-media-picker-target="cropImg" alt="" draggable="false" />
      </div>
      <div class="media-crop-controls">
        <span class="media-crop-zoom-icon" aria-hidden="true">−</span>
        <input type="range" class="media-crop-zoom" min="1" max="3" step="0.01" value="1"
               data-media-picker-target="cropZoom"
               aria-label="<%= t("editor.crop_zoom", default: "Zoom") %>"
               data-action="input->media-picker#cropZoomChanged" />
        <span class="media-crop-zoom-icon" aria-hidden="true">+</span>
      </div>
      <div class="media-crop-hint" data-media-picker-target="cropHint"><%= t("editor.crop_hint", default: "Drag to reposition, use the slider to zoom") %></div>
      <%# The Adjust flow's hint for a card whose uncropped original was never
          kept (pre-feature uploads, Skip'd uploads): the stored image is all
          there is, so widening past it has no pixels to reach. Said here
          rather than silently doing nothing at the slider's floor. %>
      <div class="media-crop-hint" data-media-picker-target="cropHintLegacy" hidden><%= t("editor.crop_adjust_legacy_hint", default: "Drag to reposition or zoom in. The uncropped original wasn't kept for this photo, so it can't be zoomed back out.") %></div>
      <div class="media-crop-actions">
        <%# In the Adjust flow the controller swaps Skip's label for Cancel —
            nothing is pending there, so skipping IS backing out. %>
        <button type="button" class="media-btn-ghost"
                data-media-picker-target="cropSkipBtn"
                data-skip-label="<%= t("editor.crop_skip", default: "Skip") %>"
                data-cancel-label="<%= t("editor.crop_cancel", default: "Cancel") %>"
                data-action="click->media-picker#cropSkip"><%= t("editor.crop_skip", default: "Skip") %></button>
        <button type="button" class="media-btn-primary"
                data-action="click->media-picker#cropApply"><%= t("editor.crop_apply", default: "Use this crop") %></button>
      </div>
    </div>

  </div>
</div>
