<%# Card right-panel renderer — shared by editor (surveys/show),
    preview (surveys/_preview_card), and player (player/_play_card).

    Locals:
      card — the card hash (must respond to `[]` for "type", "options", etc.)
      mode — :editor, :preview, or :player (default: :preview)
      card_index — this card's position in the deck. Player only, and only used
        to place the tokenisation intro and to tell the location search which
        card's narrowing to apply; nil everywhere else.

    The :editor mode adds inline edit chrome: contenteditable text,
    "card-editor" controller alongside "picker", per-option delete buttons,
    "Add option" / "Add statement" rows, and the tap-stack statement pager
    (which takes the place of the respondent's reset row). The other modes
    render the same widgets read-only.
%>
<%
  mode    ||= :preview
  card_index = defined?(card_index) ? card_index : nil
  editable = (mode == :editor)
  type     = card["type"].to_s
  render_type = type
  is_q     = CardTypes.question?(type)
  ce_attr  = editable ? "contenteditable=\"true\"".html_safe : "".html_safe

  # Quiz: in the editor, a quiz Verto lets the creator mark each question's
  # correct answer. `quiz` may arrive as a local (a freshly added card has no
  # @survey yet); otherwise fall back to the survey flag. Controls are hidden on
  # translation tabs by CSS, so a correct answer is only ever set in the primary
  # language it's stored against.
  quiz_on      = local_assigns.key?(:quiz) ? local_assigns[:quiz] : @survey&.quiz?
  quiz_mode    = editable && is_q && !!quiz_on
  correct_vals = Array(card["correct"]).map(&:to_s)
  correct_map  = card["correct"].is_a?(Hash) ? card["correct"] : {}
  # Editor-only: the player's own reveal (player_controller.js#_tintOptions)
  # tints options from the server's graded response, not this attribute — so
  # gating it here means the correct answer never sits in the player's HTML
  # at all (not just hidden by CSS), whether marked correct or not.
  mark_correct = ->(label) { editable && correct_vals.include?(label.to_s) }

  # Tokenisation: same "local wins, else the survey flag" precedent as quiz,
  # so a freshly added card (no @survey yet) still renders its token controls.
  # `token_types` is this Verto's defined types; `tokens_map`/`token_award` are
  # this card's stored per-option / flat award config.
  tokens_on   = local_assigns.key?(:tokenisation) ? local_assigns[:tokenisation] : @survey&.tokenisation_enabled?
  token_mode  = editable && is_q && !!tokens_on
  token_types = @survey&.token_types || []
  tokens_map  = card["tokens"].is_a?(Hash) ? card["tokens"] : {}
  token_award = card["token_award"].is_a?(Hash) ? card["token_award"] : {}
  # Choice-shaped cards default to a per-option award but can opt into a flat
  # award for completing the question at all — see TokenGrading.completion_award?.
  token_award_mode = card["token_award_mode"].to_s == "completion" ? "completion" : "per_answer"

  # "Show the points on each answer": a badge per option naming what it is
  # worth, rendered server-side and only for respondents (mode == :player
  # covers /play, owner preview and Test Mode; the editor shows the amount
  # inputs instead, the dashboard mini-preview shows neither). Only choice
  # types have per-option amounts — flat awards (range, rating…) and
  # completion-mode cards earn for answering at all, so there is nothing per
  # option to show — and tap cards are out for now: their awards are per
  # statement × response direction, a table the swipe card has no room for.
  show_amounts = mode == :player && !!tokens_on && !!@survey&.token_amounts_shown? &&
                 token_types.any? && TokenGrading::CHOICE.include?(type) &&
                 TokenGrading.awarding?(card) && !TokenGrading.completion_award?(card)
  # Always a SIBLING of the label, never inside .pick-text/.choice-label: the
  # player falls back to the label's textContent to identify an option
  # (_canonicalOf), and a badge inside it would corrupt that. Not aria-hidden —
  # the amount is part of the choice — but with a spoken label that says the
  # token's name rather than its emoji.
  token_badge = lambda do |canon_label|
    next "".html_safe unless show_amounts
    amounts = tokens_map[canon_label.to_s]
    next "".html_safe unless amounts.is_a?(Hash)
    parts = token_types.filter_map do |tt|
      n = amounts[tt["id"]].to_i
      [ "#{tt['icon']} #{number_with_delimiter(n)}", "#{number_with_delimiter(n)} #{tt['name']}" ] unless n.zero?
    end
    next "".html_safe if parts.empty?
    tag.span(parts.map(&:first).join(" · "), class: "token-option-badge",
             aria: { label: parts.map(&:last).join(", ") })
  end

  # The amounts go UNDER the option's words, not beside them. The chip is
  # flex-shrink:0 and nowrap, so on a row it never yields and the label pays for
  # it in wrapped lines — which is fine for "Blue" and not fine for an option
  # carrying the sentence that explains the trade-off it represents. A creator
  # putting that sentence there is doing the right thing; the row was the thing
  # in the wrong.
  #
  # Only wrapped when there IS a chip. The editor builds these same rows in
  # JavaScript (lib/choice_templates.js) and builds them flat; badges never
  # render there anyway (show_amounts is player-only), so leaving the unbadged
  # shape exactly as it was keeps the two in step.
  label_stack = lambda do |canon_label, label_html|
    chip = token_badge.call(canon_label)
    chip.blank? ? label_html : tag.div(safe_join([ label_html, chip ]), class: "choice-list-labels")
  end

  # Logic / answer-branching: every option-bearing card can route each answer
  # to a different card, flow or end screen (LogicGraph::ROUTABLE). Editor-only
  # chrome (like the quiz/token controls); the player follows the same routes
  # from the cards JSON. The branch rows render once, generically, after the
  # type sections below.
  logic_on     = local_assigns.key?(:logic) ? local_assigns[:logic] : @survey&.logic?
  logic_mode   = editable && LogicGraph::ROUTABLE.include?(type) && !!logic_on
  logic_block  = card["logic"].is_a?(Hash) ? card["logic"] : {}
  logic_routes = logic_block["routes"].is_a?(Array) ? logic_block["routes"] : []
  # The encoded select value ("card:<cid>" / "end:<id>" / "") for one option.
  logic_route_value = lambda do |label|
    route = logic_routes.find { |r| r.is_a?(Hash) && r.dig("match", "value").to_s == label.to_s }
    to    = route.is_a?(Hash) ? route["to"] : nil
    next "" unless to.is_a?(Hash)
    next "card:#{to['card']}" if to["card"].to_s != ""
    next "end:#{to['end']}"   if to["end"].to_s != ""
    ""
  end
  logic_default = logic_block["default"]
  logic_default_value =
    if logic_default.is_a?(Hash) && logic_default["card"].to_s != "" then "card:#{logic_default['card']}"
    elsif logic_default.is_a?(Hash) && logic_default["end"].to_s != "" then "end:#{logic_default['end']}"
    else "" end

  # Picker-style lists carry an extra card-editor controller in :editor
  # mode so the per-card "delete option" / "add option" actions resolve.
  picker_controllers = editable ? "picker card-editor" : "picker"

  # Accessibility for the respondent-facing picker (P2-4). The options are <li>
  # elements with a click handler: perfectly usable with a mouse or a thumb, and
  # completely unusable with a keyboard or a screen reader — not focusable, and
  # announced as plain list items with nothing conveying that they are choices
  # or which one is chosen. That covers multiple_choice, select_many, yes_no and
  # both grids, i.e. most of what a respondent is ever asked.
  #
  # Only applied outside the editor: there the same <li> holds contenteditable
  # option text, and making it a focusable radio would fight the caret.
  # The keydown hook only belongs where the item is focusable. The controller
  # also guards on contenteditable, but not shipping the binding at all in the
  # editor is one fewer thing that can misfire while someone types.
  # html_safe because ERB would otherwise escape the arrows to &gt; inside the
  # attribute. The browser decodes them either way — verified in Chromium — but
  # leaving the rendered source identical to the literal it replaced keeps it
  # greppable, and keeps any test matching on "click->picker#pick" working.
  pick_actions = (editable ? "click->picker#pick" : "click->picker#pick keydown->picker#pickOnKey").html_safe

  pick_a11y = lambda do |multi_mode, checked = false|
    next "".html_safe if editable

    tag.attributes(
      role:         multi_mode ? "checkbox" : "radio",
      tabindex:     0,
      "aria-checked": checked.to_s
    )
  end

  # Language: `display` holds the text/options for the locale being shown
  # (falls back to primary); `canon` holds the PRIMARY option labels, which is
  # what answers are stored against so results align across languages. The
  # editor always renders the primary card; the player passes the chosen locale.
  locale         ||= nil
  default_locale ||= SupportedLocales::DEFAULT
  display          = localized_card(card, locale, default_locale)
  canon            = Array(card["options"])
  # Card CONTENT follows the card's own language (the passed locale, else the
  # Verto's primary) — never the platform/UI locale, so a card never mixes
  # languages (e.g. an English question with Spanish Yes/No).
  display_locale   = (locale.presence || default_locale).to_s

  # The "how to answer" caption (e.g. "Choose one") is per-type source data
  # from config/card_types.yml, translated the same way as everything else on
  # the card: it follows display_locale, not the platform/UI locale. The
  # editor swaps this client-side when a translation tab is switched — see
  # survey_editor_controller.js _writeCard, fed by the #card-eyebrows-i18n
  # blob emitted in surveys/show.html.erb.
  # A capped multi-select names its ceiling instead of its type — the how-to
  # line IS how a respondent learns the rule (the player refuses the extra tap
  # in silence). Read straight from the card, so the two JS renderers that
  # rewrite this element client-side have the same input; see lib/card_eyebrow.js.
  # Re-checked against the card's own options rather than trusted, exactly as
  # Survey#max_choices_at does for the answers that come back: a ceiling at or
  # above the option count is no ceiling, and a respondent must never be told
  # about a rule this page won't enforce.
  max_choices = Survey::MULTI_SELECT_TYPES.include?(type) ? card["max_choices"].to_i : 0
  max_choices = 0 unless max_choices.between?(Survey::MIN_MAX_CHOICES, Array(card["options"]).length - 1)
  eyebrow = if max_choices.positive?
    t("card.eyebrow_max", n: max_choices, locale: display_locale, default: "Choose up to %{n}")
  else
    t("card.eyebrow.#{type}", locale: display_locale,
      default: CardTypes.eyebrow(type).presence || type.tr("_", " "))
  end

  # A tap card's response scale — the 2-6 answers each statement is judged on,
  # resolved for the language this card is being shown in. Computed up here
  # rather than inside the tap_card branch because the quiz and tokenisation
  # blocks further down need it too, and they are a long way from that branch.
  # Empty on every other type, so those blocks simply render nothing.
  tap_responses = type == "tap_card" ?
    TapScales.for_card(card, locale: locale, default_locale: default_locale) : []
%>

<div class="split-right<%= ' split-right--book' if Survey::PAGED_TYPES.include?(type) %>">

  <%# Re-open the intro modal, on a card that has one: the modal interrupts
      once and never again (going back and forward lands on a shut one), so
      without this the words are gone the moment somebody taps past them — and
      they are the words explaining the question they are now looking at.
      Hidden until the modal has actually been dismissed, so it never sits over
      an open one.

      Rendered on EVERY editor card, and hidden there for the life of the
      page: the editor's Preview overlay clones this markup and turns it into
      the respondent's view (preview_verto#_playeriseCardModal), so a pill the
      editor never rendered would be a pill Preview could never show — and
      "preview as a respondent" would quietly differ from what a respondent
      gets. Unconditional rather than gated on card_has_modal?, because in the
      editor a card GAINS a modal after this page was rendered; the clone drops
      the pill again wherever it found no words. Building it in JS instead
      would be a second copy of this button, free to drift from it. %>
  <% if mode == :editor || (mode == :player && card_has_modal?(card)) %>
    <button type="button" class="card-modal-reopen" hidden
            data-role="card-modal-reopen"
            data-action="click->player#reopenCardModal">
      <%= card_modal_icon(13) %>
      <span><%= t("player.modal_reopen", locale: display_locale, default: "Read again") %></span>
    </button>
  <% end %>

  <%# Creator's logo, centred at the top of the right (content) panel on the
      welcome card — player and editor (the editor's Preview overlay clones
      the editor DOM, so without the editor branch the promised "your logo on
      every preview" never appeared), and only when a logo is uploaded.
      Dashboard mini-previews (:preview) stay logo-free on purpose. %>
  <% if (mode == :player || mode == :editor) && type == "welcome_card" && brand_logo_for(@survey&.organisation, :light) %>
    <div class="split-right-logo">
      <%# Sized by WIDTH, not height: "about 30% of the card" is how the brief
          reads and how a logo actually scales against a panel. The max-height
          is the guard for a square or portrait mark, which at 30% width would
          otherwise tower over the title it sits above; object-fit (added by
          brand_logo_tag) keeps either shape undistorted inside that box. %>
      <%# direct: the public player draws it from the bucket (PlayerAssetUrls);
          editor and preview keep the same-origin proxy. %>
      <%= brand_logo_tag @survey.organisation, style: "width:30%;height:auto;max-height:72px;", on: :light,
                         direct: local_assigns[:mode] == :player %>
    </div>
  <% end %>

  <%# Question heading group — wrapped so the player mobile theme can drop
      a single white panel behind the eyebrow + title + subtitle when a
      themed mobile background is in play. %>
  <div class="q-header">
    <% if is_q %>
      <div class="q-eyebrow"><%= eyebrow %></div>
    <% end %>

    <div class="q-title" <%= ce_attr %> <%= "data-rich-text".html_safe if editable %>><%= rich_card_text(card, display, "text") %></div>

    <%# The body copy under the heading, at .q-subtitle's smaller size.
        Rendered for a welcome card in the EDITOR even when there is none yet:
        the node IS the field (the serialiser reads this element — see
        survey-editor#_readCard), so a front card that had only a heading gave
        a creator nowhere to type body copy, and every line they wrote ended up
        in the heading at heading size. "I would also consider here the main
        header in current font size, and the remainder body copy in a smaller
        font, as per enterprise, fully editable as all text is in the editor."
        Empty and contenteditable it shows a placeholder; empty and not (the
        player, and the preview overlay, which strips contenteditable) it is
        display: none, so nothing changes for a card without body copy. %>
    <% if display["description"].present? || (editable && type == "welcome_card") %>
      <div class="q-subtitle" <%= ce_attr %> <%= "data-rich-text".html_safe if editable %><% if editable %> data-placeholder="<%= t("card.body_placeholder", default: "Add body copy (optional)") %>"<% end %>><%= rich_card_text(card, display, "description") %></div>
    <% end %>
  </div>

  <div class="mt-2"<%= " data-card-component".html_safe if editable %>>
    <% case render_type
       when "multiple_choice", "select_many" %>
      <% items = Array(display["options"]) %>
      <% multi = (type == "select_many") %>
      <ul class="choice-list choice-list--<%= multi ? 'multi' : 'single' %>"
          <%= editable ? "".html_safe : tag.attributes(role: multi ? "group" : "radiogroup") %>
          data-controller="<%= picker_controllers %>"
          data-picker-mode-value="<%= multi ? 'multi' : 'single' %>"
          data-picker-max-value="<%= multi ? max_choices : 0 %>">
        <% items.each_with_index do |opt, i| %>
          <% style = option_style_at(card, i) %>
          <li class="choice-list-item pick-item"
              data-picker-target="item"
              data-action="<%= pick_actions %>"
              data-canonical="<%= canon[i] %>"
              data-correct="<%= mark_correct.call(canon[i]) %>"
              data-selected="false"
              <%= option_style_data_attrs(style) if editable %>
              <%= pick_a11y.call(multi) %>>
            <div class="choice-list-tile choice-bg-<%= (i % 6) + 1 %>" aria-hidden="true" style="<%= option_tile_style(style) %>"><%= option_tile_icon(style, canon[i], index: i) %></div>
            <% label = capture do %><span class="pick-text choice-list-label" <%= ce_attr %> <%= "data-rich-text".html_safe if editable %>><%= rich_option_text(card, opt, i) %></span><% end %>
            <%= label_stack.call(canon[i], label) %>
            <span class="choice-list-tick <%= multi ? 'pick-square' : 'pick-dot' %>">✓</span>
            <% if quiz_mode %>
              <button type="button" class="mark-correct" data-picker-mode="<%= multi ? 'multi' : 'single' %>"
                      data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
            <% end %>
            <% if editable %>
              <button type="button" class="option-style-btn"
                      data-action="click->option-style#open" title="<%= t('card.style_option') %>">🎨</button>
              <button type="button" class="pick-item-delete"
                      data-action="click->card-editor#deleteOption"
                      title="<%= t("card.remove_option", default: "Delete card") %>"
                      aria-label="<%= t("card.remove_option", default: "Delete card") %>">×</button>
            <% end %>
          </li>
        <% end %>
        <% if editable %>
          <li class="pick-add-btn"
              data-action="click->card-editor#addPickOption"
              data-card-editor-add>
            <span>＋</span> <%= t("card.add_option") %>
          </li>
        <% end %>
      </ul>

    <% when "prioritise" %>
      <%# Drag-to-rank list: respondents arrange the options top (highest
          priority) to bottom. The stored answer is the ordered list of
          canonical labels. Reuses the pick-item list chrome (edit/add/delete)
          but a `prioritise` controller handles reordering; in the player the
          initial order is shuffled so the authored order isn't a default bias. %>
      <% items = Array(display["options"]) %>
      <ul class="choice-list prioritise-list"
          data-controller="<%= editable ? 'prioritise card-editor' : 'prioritise' %>"
          <%= 'data-prioritise-shuffle-value="true"'.html_safe if mode == :player %>>
        <% items.each_with_index do |opt, i| %>
          <% style = option_style_at(card, i) %>
          <li class="choice-list-item pick-item prioritise-item"
              data-prioritise-target="item"
              data-canonical="<%= canon[i] %>"
              <%= option_style_data_attrs(style) if editable %>
              data-action="pointerdown->prioritise#start">
            <%# Rank badge rides the tile's corner (see .prioritise-item
                .prioritise-rank) — its old flex slot was label width. %>
            <div class="choice-list-tile choice-bg-<%= (i % 6) + 1 %>" style="<%= option_tile_style(style) %>"><span class="prioritise-rank" data-prioritise-target="rank"><%= i + 1 %></span><%= option_tile_icon(style, canon[i], keyword_fallback: false, index: i) %></div>
            <span class="pick-text choice-list-label" <%= ce_attr %> <%= "data-rich-text".html_safe if editable %>><%= rich_option_text(card, opt, i) %></span>
            <span class="prioritise-grip" aria-hidden="true">⋮⋮</span>
            <% if editable %>
              <button type="button" class="option-style-btn"
                      data-action="click->option-style#open" title="<%= t('card.style_option') %>">🎨</button>
              <button type="button" class="pick-item-delete"
                      data-action="click->card-editor#deleteOption"
                      title="<%= t("card.remove_option", default: "Delete card") %>"
                      aria-label="<%= t("card.remove_option", default: "Delete card") %>">×</button>
            <% end %>
          </li>
        <% end %>
        <% if editable %>
          <li class="pick-add-btn"
              data-action="click->card-editor#addPickOption"
              data-card-editor-add>
            <span>＋</span> <%= t("card.add_option") %>
          </li>
        <% end %>
      </ul>

    <% when "yes_no" %>
      <ul class="choice-list choice-list--yesno"
          <%= editable ? "".html_safe : tag.attributes(role: "radiogroup") %>
          data-controller="picker"
          data-picker-mode-value="single">
        <% [["Yes", 1], ["No", 4]].each_with_index do |(canon_label, bg), i| %>
          <% style = option_style_at(card, i) %>
          <li class="choice-list-item pick-item"
              data-picker-target="item"
              data-action="<%= pick_actions %>"
              data-canonical="<%= canon_label %>"
              data-correct="<%= mark_correct.call(canon_label) %>"
              data-selected="false"
              <%= option_style_data_attrs(style) if editable %>
              <%= pick_a11y.call(false) %>>
            <div class="choice-list-tile choice-bg-<%= bg %>" aria-hidden="true" style="<%= option_tile_style(style) %>"><%= option_tile_icon(style, canon_label, keyword_fallback: false, index: i) %></div>
            <% label = capture do %><span class="pick-text choice-list-label" <%= ce_attr %>><%= t("card.#{canon_label.downcase}", locale: display_locale, default: canon_label) %></span><% end %>
            <%= label_stack.call(canon_label, label) %>
            <span class="choice-list-tick pick-dot">✓</span>
            <% if quiz_mode %>
              <button type="button" class="mark-correct" data-picker-mode="single"
                      data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
            <% end %>
            <% if editable %>
              <button type="button" class="option-style-btn"
                      data-action="click->option-style#open" title="<%= t('card.style_option') %>">🎨</button>
            <% end %>
          </li>
        <% end %>
      </ul>

    <% when "select_one_grid", "select_many_grid" %>
      <% opts = Array(display["options"]) %>
      <%# Always two columns — three shrinks the tiles and labels too far,
          whatever the option count (keep in step with type_panel's gridHtml). %>
      <% multi = (type == "select_many_grid") %>
      <ul class="choice-grid choice-grid--<%= multi ? 'multi' : 'single' %> choice-grid-2"
          <%= editable ? "".html_safe : tag.attributes(role: multi ? "group" : "radiogroup") %>
          data-controller="picker"
          data-picker-mode-value="<%= multi ? 'multi' : 'single' %>"
          data-picker-max-value="<%= multi ? max_choices : 0 %>">
        <% opts.each_with_index do |opt, i| %>
          <% style = option_style_at(card, i) %>
          <li class="choice-card"
              data-picker-target="item"
              data-action="<%= pick_actions %>"
              data-canonical="<%= canon[i] %>"
              data-correct="<%= mark_correct.call(canon[i]) %>"
              data-selected="false"
              <%= option_style_data_attrs(style) if editable %>
              <%= pick_a11y.call(multi) %>>
            <div class="choice-card-bg choice-bg-<%= (i % 6) + 1 %>" style="<%= option_tile_style(style) %>">
              <%= option_tile_icon(style, canon[i], index: i) %>
              <div class="choice-overlay"></div>
              <div class="choice-tick">✓</div>
              <%= token_badge.call(canon[i]) %>
              <% if quiz_mode %>
                <button type="button" class="mark-correct mark-correct-grid" data-picker-mode="<%= multi ? 'multi' : 'single' %>"
                        data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
              <% end %>
              <% if editable %>
                <button type="button" class="option-style-btn option-style-btn-grid"
                        data-action="click->option-style#open" title="<%= t('card.style_option') %>">🎨</button>
              <% end %>
            </div>
            <div class="choice-label" <%= ce_attr %> <%= "data-rich-text".html_safe if editable %>><%= rich_option_text(card, opt, i) %></div>
          </li>
        <% end %>
      </ul>

    <% when "tap_card" %>
      <% option_images = Array(card["option_images"]) %>
      <div class="rotate-wrap"
           data-controller="<%= editable ? 'tap-stack card-editor' : 'tap-stack' %>"
           data-action="tap-stack:reset->tap-stack#reset tap-stack:goto->tap-stack#goto">
        <div class="rotate-card-stack">
          <% Array(display["options"]).each_with_index do |opt, i| %>
            <% img = option_images[i] %>
            <%# The picture as longhands plus this statement's own reposition —
                see option_media_style, and .rotate-card-media for why the
                `background` shorthand can't carry either. %>
            <% bg_style = option_media_style(card, i, img) %>
            <%# Players can also drag the card off (tap-stack#dragStart); the
                editor's statements are contenteditable, where a drag would
                fight text selection, so the action is player-only. %>
            <div class="rotate-card"
                 data-tap-stack-target="card"
                 data-canonical="<%= canon[i] %>"
                 <%= editable ? "".html_safe : 'data-action="pointerdown->tap-stack#dragStart"'.html_safe %>>
              <div class="rotate-card-media"<%= ' data-controller="bg-image-healer"'.html_safe if img.present? %> style="<%= bg_style %>"></div>
              <%# Statement sits in a dark band at the TOP of the card. %>
              <div class="rotate-card-statement"><span <%= ce_attr %>><%= opt %></span></div>
              <% if editable %>
                <button type="button" class="tap-card-image-btn"
                        data-action="click->media-picker#openTapOption"
                        data-media-picker-option-index="<%= i %>"
                        title="<%= t("editor.change_statement_image_title", default: "Change this statement's image") %>"
                        aria-label="<%= t("editor.change_statement_image_title", default: "Change this statement's image") %>">
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <path d="M21 15l-5-5L5 21"></path>
                    </svg>
                  </span>
                </button>
                <%# Right beside "Change this statement's image", because the
                    picture a creator wants to move is the one they can already
                    see — asked for in exactly those terms. Only rendered where
                    there IS a picture: on the gradient fallback there is
                    nothing to reposition. media_picker#_syncTapAdjustBtn
                    toggles it as statements gain and lose images without a
                    server render. %>
                <button type="button" class="tap-card-adjust-btn"
                        data-action="click->media-picker#openAdjust"
                        data-media-picker-option-index="<%= i %>"
                        title="<%= t("editor.reposition_statement_title", default: "Reposition or crop this statement's image") %>"
                        aria-label="<%= t("editor.reposition_statement_title", default: "Reposition or crop this statement's image") %>"
                        <%= "hidden".html_safe if img.blank? %>>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3v18M3 12h18"></path>
                      <path d="M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3"></path>
                    </svg>
                  </span>
                </button>
                <button type="button" class="tap-card-delete"
                        data-action="click->card-editor#deleteOption"
                        title="<%= t("card.remove_option", default: "Delete card") %>"
                        aria-label="<%= t("card.remove_option", default: "Delete card") %>">×</button>
              <% end %>
            </div>
          <% end %>

          <%# End-of-deck face: answered cards fade out, and without this the
              stack kept its full footprint as a transparent void under the
              button scrim. tap-stack#layout toggles .is-complete on
              .rotate-wrap; CSS does the rest (see .rotate-complete). %>
          <div class="rotate-complete">
            <span class="rotate-complete-check"><%= tap_response_icon("yes") %></span>
            <span class="rotate-complete-text"><%= t("card.tap_done") %></span>
          </div>

          <%# Controls live INSIDE the card: the response strip and the
              remaining-cards dots. The strip is 2-6 answers wide (TapScales) —
              a card with no stored `responses` gets the historic No / Unsure /
              Yes, which is why every deck predating configurable scales renders
              unchanged. The controller builds the dots.
              Up to four responses the strip is a row over a bottom scrim; at
              five and up it fans across the whole card, so the wrapper has to
              stop being a bottom strip and cover the photo. %>
          <div class="rotate-card-controls<%= " rotate-card-controls--fan" if TapScales.fan?(tap_responses.length) %>"
               data-tap-stack-target="controls">
            <%= render "shared/tap_responses", responses: tap_responses, editable: editable %>
            <div class="rotate-dots" data-tap-stack-target="dots"></div>
          </div>
        </div>

        <%# One row per mode, because the two modes want opposite things from
            the deck. A respondent has answers to take back, so they get Reset.
            A creator has a deck to WALK, and until this row existed had no way
            to: the editor's response strip is entirely spoken for (see
            tap-stack#forward), so tapping never advanced the stack, and every
            statement after the first was unreachable — unreadable, unedittable,
            and out of reach of its own image and delete buttons, which only the
            top card receives pointer events for.

            Shaped like the scenario card's editor nav row, the other type whose
            content hides behind a page turn: a creator shouldn't have to learn
            two pagers. %>
        <% if editable %>
          <div class="tap-nav-row">
            <button type="button" class="tap-nav-btn"
                    data-tap-stack-target="prevBtn"
                    data-action="click->tap-stack#back"
                    title="<%= t("js.editor.tap.prev_statement", default: "Previous statement") %>"
                    aria-label="<%= t("js.editor.tap.prev_statement", default: "Previous statement") %>">‹</button>
            <span class="tap-nav-count" data-tap-stack-target="counter" aria-live="polite"></span>
            <button type="button" class="tap-nav-btn"
                    data-tap-stack-target="nextBtn"
                    data-action="click->tap-stack#forward"
                    title="<%= t("js.editor.tap.next_statement", default: "Next statement") %>"
                    aria-label="<%= t("js.editor.tap.next_statement", default: "Next statement") %>">›</button>
          </div>
          <button type="button" class="tap-add-btn"
                  data-action="click->card-editor#addTapOption">＋ <%= t("card.add_statement") %></button>
        <% else %>
          <div class="rotate-reset-row">
            <button type="button" class="rotate-reset-btn"
                    data-action="click->tap-stack#reset">↺ <%= t("card.reset") %></button>
          </div>
        <% end %>
      </div>

    <% when "scenario" %>
      <%# Book-style narrative choice: the creator writes the situation across
          several pages; the respondent (or, in the editor, the creator)
          turns through them one at a time via scenario_controller.js, landing
          on an ordinary single-select .choice-list as the book's final
          "page" — reused verbatim from multiple_choice, so grading/tokens/
          branching/results all treat a scenario answer exactly like one. %>
      <% pages = Array(display["pages"]) %>
      <% pages = [{}] if pages.empty? %>
      <% items = Array(display["options"]) %>
      <%# --scenario, because consent_gate renders the same book and must NOT
          get the scenario's centring: a story is a few lines and reads better
          centred in its page, an information sheet is a wall of terms and
          reads worse. Nothing else distinguishes the two wraps. %>
      <div class="book-wrap book-wrap--scenario"
           data-controller="<%= editable ? 'scenario card-editor' : 'scenario' %>"
           data-scenario-editable-value="<%= editable %>">
        <div class="book-stack" data-scenario-target="stack">
          <% pages.each_with_index do |page, i| %>
            <div class="book-page" data-scenario-target="page" data-page-id="<%= page['id'].to_s %>">
              <div class="book-page-scroll">
                <div class="book-page-kicker" data-scenario-target="kicker">
                  <%= t("js.editor.scenario.page_of", n: i + 1, total: pages.size, default: "Page #{i + 1} of #{pages.size}") %>
                </div>
                <div class="book-page-text" <%= ce_attr %>
                     data-scenario-target="pageText"
                     <%= "data-rich-text".html_safe if editable %>
                     <% if editable %>data-placeholder="<%= t('js.editor.scenario.page_placeholder', default: 'Write this page…') %>"<% end %>><%= rich_page_text(card, page) %></div>
              </div>
              <div class="book-page-corner"><%= i + 1 %></div>
              <div class="book-page-fade"></div>
            </div>
          <% end %>

          <div class="book-page is-answer" data-scenario-target="page">
            <div class="book-page-scroll">
              <div class="book-page-kicker">
                <%= editable ? t("js.editor.scenario.answer_kicker", default: "Answer options") : t("js.editor.scenario.choose_kicker", default: "Make your choice") %>
              </div>
              <%# The same radiogroup/radio + keyboard layer as multiple_choice
                  (P2-4): this list is a hand-copied MC block, and leaving the
                  helpers off left it pointer-only and role-less — the one
                  answer list a screen reader heard as a bare text list. %>
              <ul class="choice-list choice-list--single"
                  <%= editable ? "".html_safe : tag.attributes(role: "radiogroup") %>
                  data-controller="<%= picker_controllers %>"
                  data-picker-mode-value="single">
                <% items.each_with_index do |opt, i| %>
                  <% style = option_style_at(card, i) %>
                  <li class="choice-list-item pick-item"
                      data-picker-target="item"
                      data-action="<%= pick_actions %>"
                      data-canonical="<%= canon[i] %>"
                      data-correct="<%= mark_correct.call(canon[i]) %>"
                      <%= option_style_data_attrs(style) if editable %>
                      data-selected="false"
                      <%= pick_a11y.call(false) %>>
                    <div class="choice-list-tile choice-bg-<%= (i % 6) + 1 %>" aria-hidden="true" style="<%= option_tile_style(style) %>"><%= option_tile_icon(style, canon[i], index: i) %></div>
                    <% label = capture do %><span class="pick-text choice-list-label" <%= ce_attr %> <%= "data-rich-text".html_safe if editable %>><%= rich_option_text(card, opt, i) %></span><% end %>
                    <%= label_stack.call(canon[i], label) %>
                    <span class="choice-list-tick pick-dot">✓</span>
                    <% if quiz_mode %>
                      <button type="button" class="mark-correct" data-picker-mode="single"
                              data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
                    <% end %>
                    <% if editable %>
                      <button type="button" class="option-style-btn"
                              data-action="click->option-style#open" title="<%= t('card.style_option') %>">🎨</button>
                      <button type="button" class="pick-item-delete"
                              data-action="click->card-editor#deleteOption"
                              title="<%= t("card.remove_option", default: "Delete card") %>"
                              aria-label="<%= t("card.remove_option", default: "Delete card") %>">×</button>
                    <% end %>
                  </li>
                <% end %>
                <% if editable %>
                  <li class="pick-add-btn" data-action="click->card-editor#addPickOption" data-card-editor-add>
                    <span>＋</span> <%= t("card.add_option") %>
                  </li>
                <% end %>
              </ul>
            </div>
            <div class="book-page-fade"></div>
          </div>
        </div>

        <% if editable %>
          <div class="book-edit-tools" data-scenario-target="editTools">
            <button type="button" class="book-tool-btn danger" data-scenario-target="delPageBtn"
                    data-action="click->scenario#deletePage"><%= t("js.editor.scenario.delete_page", default: "✕ Delete this page") %></button>
            <button type="button" class="book-tool-btn" data-scenario-target="addPageBtn"
                    data-action="click->scenario#addPage"><%= t("js.editor.scenario.add_page", default: "＋ Add page") %></button>
          </div>
        <% end %>

        <%# In the player the dots live INSIDE the nav row, between the two
            chevrons, so the three read as ONE pager capsule (‹ · · · ›)
            rather than a dot strip floating above a pair of anonymous
            circles — the owner's pick from the three mocked treatments. The
            editor keeps the dots above the row: its row carries the
            full-width "Next page ›" button, which a capsule cannot hold. %>
        <% if editable %>
          <div class="book-dots" data-scenario-target="dots"></div>
        <% end %>

        <div class="book-nav-row">
          <button type="button" class="book-chevron" data-scenario-target="prevBtn"
                  data-action="click->scenario#back" aria-label="<%= t('js.editor.scenario.prev_page', default: 'Previous page') %>">‹</button>
          <% if editable %>
            <button type="button" class="next-btn" data-scenario-target="nextBtn"
                    data-action="click->scenario#next"><%= t("js.editor.scenario.next_page_btn", default: "Next page ›") %></button>
          <% else %>
            <div class="book-dots" data-scenario-target="dots"></div>
            <button type="button" class="book-chevron" data-scenario-target="nextBtn"
                    data-action="click->scenario#next" aria-label="<%= t('js.editor.scenario.next_page', default: 'Next page') %>">›</button>
          <% end %>
        </div>
        <div class="book-live" data-scenario-target="live" aria-live="polite"></div>
      </div>

    <% when "consent_gate" %>
      <%# Multi-page consent. Same book as a scenario — the creator writes the
          information sheet across pages, the respondent turns through them —
          but the final page is Agree / Decline instead of a choice list, and
          agreement is recorded on the response (consent_agreed_at) rather than
          stored as an answer. Reuses scenario_controller.js verbatim, so page
          turns, dots, add/delete-page and the id-keyed translations all behave
          exactly as they do for a scenario. %>
      <% pages = Array(display["pages"]) %>
      <% pages = [ {} ] if pages.empty? %>
      <div class="book-wrap"
           data-controller="scenario"
           data-scenario-editable-value="<%= editable %>">
        <div class="book-stack" data-scenario-target="stack">
          <% pages.each_with_index do |page, i| %>
            <div class="book-page" data-scenario-target="page" data-page-id="<%= page['id'].to_s %>">
              <div class="book-page-scroll">
                <div class="book-page-kicker" data-scenario-target="kicker">
                  <%= t("js.editor.scenario.page_of", n: i + 1, total: pages.size, default: "Page #{i + 1} of #{pages.size}") %>
                </div>
                <div class="book-page-text" <%= ce_attr %>
                     data-scenario-target="pageText"
                     <% if editable %>data-placeholder="<%= t('editor.consent_page_placeholder', default: 'Write this consent screen…') %>"<% end %>><%= page["text"] %></div>
              </div>
              <div class="book-page-corner"><%= i + 1 %></div>
              <div class="book-page-fade"></div>
            </div>
          <% end %>

          <%# Final page: the agreement itself. In the editor it's an inert
              replica (same markup, no actions) so the creator sees where the
              story lands without being able to consent on a respondent's
              behalf. %>
          <div class="book-page is-answer" data-scenario-target="page">
            <div class="book-page-scroll">
              <div class="book-page-kicker">
                <%= t("editor.consent_agreement_kicker", default: "Agreement") %>
              </div>
              <div <%= mode == :player ? 'data-player-target=consentMain'.html_safe : "" %> class="play-consent-main">
                <div class="play-consent-actions" <%= 'aria-hidden="true" style="pointer-events:none;"'.html_safe if editable %>>
                  <button type="button" class="play-consent-agree" <%= 'tabindex="-1"'.html_safe if editable %>
                          <% if mode == :player %>data-action="click->player#agreeConsent"<% end %>><%= t("player.consent_agree") %></button>
                  <button type="button" class="play-consent-decline" <%= 'tabindex="-1"'.html_safe if editable %>
                          <% if mode == :player %>data-action="click->player#declineConsent"<% end %>><%= t("player.consent_decline") %></button>
                </div>
              </div>
              <% if mode == :player %>
                <div class="play-consent-declined hidden" data-player-target="consentDeclined">
                  <%= t("player.consent_declined") %>
                </div>
              <% end %>
            </div>
            <div class="book-page-fade"></div>
          </div>
        </div>

        <% if editable %>
          <div class="book-edit-tools" data-scenario-target="editTools">
            <button type="button" class="book-tool-btn danger" data-scenario-target="delPageBtn"
                    data-action="click->scenario#deletePage"><%= t("js.editor.scenario.delete_page", default: "✕ Delete this page") %></button>
            <button type="button" class="book-tool-btn" data-scenario-target="addPageBtn"
                    data-action="click->scenario#addPage"><%= t("js.editor.scenario.add_page", default: "＋ Add page") %></button>
          </div>
        <% end %>

        <%# In the player the dots live INSIDE the nav row, between the two
            chevrons, so the three read as ONE pager capsule (‹ · · · ›)
            rather than a dot strip floating above a pair of anonymous
            circles — the owner's pick from the three mocked treatments. The
            editor keeps the dots above the row: its row carries the
            full-width "Next page ›" button, which a capsule cannot hold. %>
        <% if editable %>
          <div class="book-dots" data-scenario-target="dots"></div>
        <% end %>

        <div class="book-nav-row">
          <button type="button" class="book-chevron" data-scenario-target="prevBtn"
                  data-action="click->scenario#back" aria-label="<%= t('js.editor.scenario.prev_page', default: 'Previous page') %>">‹</button>
          <% if editable %>
            <button type="button" class="next-btn" data-scenario-target="nextBtn"
                    data-action="click->scenario#next"><%= t("js.editor.scenario.next_page_btn", default: "Next page ›") %></button>
          <% else %>
            <div class="book-dots" data-scenario-target="dots"></div>
            <button type="button" class="book-chevron" data-scenario-target="nextBtn"
                    data-action="click->scenario#next" aria-label="<%= t('js.editor.scenario.next_page', default: 'Next page') %>">›</button>
          <% end %>
        </div>
        <div class="book-live" data-scenario-target="live" aria-live="polite"></div>
      </div>

    <% when "range" %>
      <% labels = Array(display["options"]) %>
      <% n = [labels.size, 2].max %>
      <% axis = resolved_slider_axis(card) %>
      <% stored_axis = card["slider_axis"].to_s.presence || "auto" %>
      <% next_axis = { "auto" => "horizontal", "horizontal" => "vertical", "vertical" => "auto" }[stored_axis] %>
      <% top_down = slider_top_down?(card) %>
      <% v_edge = top_down ? "top" : "bottom" %>
      <%# Keyboard + screen-reader access, matching the NPS slider's existing
          pattern (P2-4). Without it the range card is drag-only: pointerdown
          is the sole way to answer. Editor excluded — the labels underneath
          are contenteditable there. %>
      <div class="slider-wrap"
           data-controller="slider"
           data-slider-steps-value="<%= n %>"
           data-slider-axis-value="<%= axis %>"
           <%# Only an `auto` card lets slider#fitLabels turn the scale
               vertical when the words won't fit horizontally at the type's
               floor — an explicit horizontal is the creator's call and is
               left alone. %>
           data-slider-auto-value="<%= stored_axis == "auto" %>"
           data-slider-top-down-value="<%= top_down %>"
           <%= editable ? "".html_safe : tag.attributes(
                 tabindex: 0, role: "slider",
                 "aria-valuemin": 0, "aria-valuemax": n - 1,
                 "aria-orientation": axis) %>
           data-action="<%= (editable ? "" : "keydown->slider#key").html_safe %>">
        <div class="slider-track-wrap">
          <div class="slider-track"
               data-slider-target="track"
               data-action="pointerdown->slider#start">
            <% n.times do |i| %>
              <% pos = (i.to_f / (n - 1) * 100).round(2) %>
              <div class="s-dot" data-slider-target="dot"
                   style="<%= axis == "vertical" ? "#{v_edge}:#{pos}%" : "left:#{pos}%" %>"></div>
            <% end %>
            <div class="slider-thumb" data-slider-target="thumb"
                 style="<%= axis == "vertical" ? "#{v_edge}:50%;" : "left:50%;" %>">
              <div class="s-line"></div><div class="s-line"></div><div class="s-line"></div>
            </div>
          </div>
        </div>
        <div class="slider-labels">
          <%# Players can tap a label to jump to that step; editor labels are
              contenteditable, so they never carry the action. %>
          <% labels.each do |opt| %>
            <span class="slider-label-text" data-slider-target="label" <%= ce_attr %>
                  <%# A creator typing a longer word into a stop is the same
                      event, to the fit, as the panel getting narrower. %>
                  <%= (editable ? 'data-action="input->slider#refit"' : 'data-action="click->slider#jump"').html_safe %>><%= opt %></span>
          <% end %>
        </div>
        <% if editable %>
          <button type="button" class="slider-axis-toggle"
                  data-action="click->type-panel#setSliderAxis"
                  title="<%= t("editor.slider_axis_#{next_axis}", default: "Change layout") %>">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-3-6.7"></path>
              <path d="M21 3v6h-6"></path>
            </svg>
          </button>
        <% end %>
      </div>
      <% if editable %>
        <%# Reaction-animation theme for this Range card. Changing it swaps the
            left-panel Lottie live (survey-editor#setRangeTheme) and persists as
            the card's `range_theme`. %>
        <% cur_theme = range_theme_slug(card) %>
        <%# The animation is now changed from the "Change animation" CTA on the
            left panel (animation-picker modal), like every other asset — this
            <select> stays as the hidden apply path the modal drives through
            survey-editor#setRangeTheme, so there is one code path. %>
        <div class="range-theme-picker" hidden>
          <label class="range-theme-label"><%= t("editor.animation_theme", default: "Animation") %></label>
          <select class="range-theme-select" data-action="change->survey-editor#setRangeTheme">
            <% range_theme_groups.each do |category, opts| %>
              <optgroup label="<%= category %>">
                <% opts.each do |label, slug| %>
                  <option value="<%= slug %>" <%= "selected" if slug == cur_theme %>><%= label %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>
        </div>
      <% end %>

    <% when "nps" %>
      <%# NPS — a vertical "liquid container" the respondent drags to fill to
          their number. Defaults to the classic 0–10 (the reactive Lottie now
          lives on Range). Labels are editable and drive the step count, so a
          creator can keep 0–10, use a shorter 4/5-point scale, or swap in an
          agree/emotion range. The container silhouette is the card's own
          `nps_shape` where the creator picked one and the Verto-themed default
          otherwise (nps_shape_slug). column-reverse stacks index 0 at the
          bottom, matching the fill rising from the bottom. The stored answer is
          the 0-indexed position. %>
      <% labels = Array(display["options"]).presence || nps_default_labels %>
      <% n = [labels.size, NpsHelper::NPS_MIN_STEPS].max %>
      <% shape = nps_shape_slug(card, @survey) %>
      <%# Off the classic 0-10? Then the scale is the creator's to build, and
          each stop gets a × with an ＋ under the column. On the classic the
          stops are the scale rather than copy, so they are neither removable
          nor retypable — "an NPS is 0-10" is the type's whole contract, and the
          switch in the card-settings island is the one place it comes off. %>
      <% custom_scale = nps_custom_scale?(card) %>
      <% scale_editable = editable && custom_scale %>
      <div class="nps-slider<%= " is-custom-scale" if scale_editable %>"
           data-controller="<%= editable ? 'nps-slider card-editor' : 'nps-slider' %>"
           data-nps-slider-steps-value="<%= n %>"
           data-nps-slider-axis-value="vertical"
           data-action="pointerdown->nps-slider#start keydown->nps-slider#key"
           tabindex="0" role="slider"
           aria-valuemin="0" aria-valuemax="<%= n - 1 %>">
        <div class="nps-slider-stage" style="<%= nps_stage_style(shape) %>">
          <%# The two anchor lines beside the scale's ends — "I have no say at
              all" beside the bottom stop, "I am a decision maker" beside the
              top — so a respondent knows what the numbers mean. A SIBLING
              column to the digits, not two more rows in it: card-editor
              rebuilds .nps-slider-labels wholesale (setNpsClassic) and counts
              its rows as stops (addNpsStop/_syncNpsSteps), and the slider
              indexes its label targets by step. The CSS gives this column the
              digit column's exact track (height, column-reverse, the vessel's
              insets), which is what keeps the two ends level with the first
              and last stop whatever the step count. Rendered on the player
              only when there are words; always in the editor, so the creator
              has somewhere to type. No whitespace inside the text span — the
              editor's placeholder is an :empty::before. %>
          <% low_anchor = display["nps_low_label"].to_s; high_anchor = display["nps_high_label"].to_s %>
          <% if editable || low_anchor.present? || high_anchor.present? %>
            <div class="nps-anchors">
              <% [ [ "low", low_anchor ], [ "high", high_anchor ] ].each do |which, words| %>
                <span class="nps-anchor-row"><span class="nps-anchor-text nps-anchor-<%= which %>" data-role="nps-anchor-<%= which %>" <%= ce_attr %><% if editable %> data-placeholder="<%= t("card.nps_#{which}_placeholder") %>"<% end %>><%= words %></span></span>
              <% end %>
            </div>
          <% end %>
          <div class="slider-labels nps-slider-labels">
            <%# The ROW is the flex item, in the player as well as the editor.
                The column lays its stops out with `space-between` over a fixed
                height and every item zero-height, so whatever carries the ×
                has to be the thing that gets those properties — and rendering
                the wrapper only in the editor would mean the two surfaces laid
                the same scale out differently, which is the exact class of bug
                the preview audit was about. So the wrapper is always there and
                only the × comes and goes. %>
            <% labels.each do |opt| %>
              <span class="nps-label-row">
                <% if scale_editable %>
                  <button type="button" class="nps-label-delete"
                          data-action="click->card-editor#deleteNpsStop"
                          title="<%= t("card.remove_option", default: "Delete card") %>"
                          aria-label="<%= t("card.remove_option", default: "Delete card") %>">×</button>
                <% end %>
                <span class="slider-label-text" data-nps-slider-target="label"
                      <%= ce_attr if scale_editable %>><%= opt %></span>
              </span>
            <% end %>
          </div>
          <%= render_nps_control(shape: shape, steps: n) %>
        </div>
        <%# Outside .nps-slider-labels deliberately: that column divides a fixed
            height between its stops, so an ＋ inside it would be one more stop
            as far as the layout is concerned and would move every label. %>
        <% if scale_editable %>
          <button type="button" class="nps-scale-add"
                  data-action="click->card-editor#addNpsStop"
                  data-card-editor-nps-add>
            <span aria-hidden="true">＋</span> <%= t("card.add_scale_point", default: "Add a point") %>
          </button>
        <% end %>
      </div>
      <% if editable %>
        <%# The container this card fills, driven by the "Change animation" CTA
            on the left panel — the same arrangement Range uses: a hidden
            <select> is the one apply path, so the visual picker and any
            keyboard/SR use go through survey-editor#setNpsShape together and
            can't drift. Hidden rather than absent because the modal needs
            something to drive, and _stripEditorChrome has to find something to
            remove. %>
        <div class="nps-shape-picker" hidden>
          <label class="range-theme-label"><%= t("editor.animation_theme", default: "Animation") %></label>
          <select class="nps-shape-select" data-action="change->survey-editor#setNpsShape">
            <% nps_shape_groups.each do |category, opts| %>
              <optgroup label="<%= category %>">
                <% opts.each do |label, slug| %>
                  <option value="<%= slug %>" <%= "selected" if slug == shape %>><%= label %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>
        </div>
      <% end %>

    <% when "rating" %>
      <%# Every star carries its own label, and every label is rendered — the two
          end captions sit under the ends as they always have, and the ones in
          between are revealed as a single centred caption when that star is
          tapped or hovered. Rendering all of them is not just the feature that
          was asked for ("we will need to see the answer that each star
          contains"): the editor's autosave rebuilds a card's options FROM THE
          DOM, so while only two labels existed, a five-label rating card was
          silently rewritten to two the first time anything on the deck was
          edited. The middle three are the data — hiding them cost them. %>
      <% rating_defaults = Array(t("defaults.rating", default: [ "Poor", "Fair", "Good", "Great", "Excellent" ])) %>
      <% labels    = Array(display["options"]).presence || rating_defaults %>
      <%# Always five stars. The count is the card type's contract, not a
          function of how many labels happen to be stored: answers are recorded
          as a star NUMBER and results count 1..5, so a two-label card (the old
          min/max shape, still all over existing decks) is a five-star card with
          two end captions — not a two-star card. `full_ladder` is what tells
          the two apart, and only a full ladder has a caption to show per star. %>
      <% stars       = Survey::RATING_STARS %>
      <% full_ladder = labels.size >= stars %>
      <% icon      = rating_icon(@survey) %>
      <% rating_actions = (editable ? "click->rating#pick mouseover->rating#hover mouseout->rating#unhover" :
                                       "click->rating#pick mouseover->rating#hover mouseout->rating#unhover keydown->rating#pickOnKey").html_safe %>
      <div class="rating-wrap rating-kind-<%= icon[:kind] %>" data-controller="rating">
        <div class="rating-stars" <%= editable ? "".html_safe : tag.attributes(role: "radiogroup") %>>
          <% stars.times do |i| %>
            <%# Radio rather than slider semantics: discrete, individually
                labelled choices is what a rating is, and it's what a screen
                reader user expects from stars (P2-4). The star's own label is
                the accessible name where there is one — "3 of 5" tells a screen
                reader user nothing about what 3 means. %>
            <span class="rating-star"
                  data-rating-target="star"
                  data-rating-index="<%= i %>"
                  data-rating-on="<%= icon[:on] %>"
                  data-rating-off="<%= icon[:off] %>"
                  <%= editable ? "".html_safe : tag.attributes(
                        role: "radio", tabindex: 0, "aria-checked": "false",
                        "aria-label": (full_ladder ? labels[i].presence : nil) ||
                          t("card.rating_star", number: i + 1, total: stars, locale: display_locale, default: "#{i + 1} of #{stars}")) %>
                  data-action="<%= rating_actions %>"><%= icon[:off] %></span>
          <% end %>
        </div>
        <div class="rating-labels">
          <%# The ends are always visible; the middle ones share one centred slot
              so the row stays a two-ended scale at rest. Every label is a real
              node either way, which is what keeps them in the deck. %>
          <span class="rating-label" data-rating-target="endLabel" <%= ce_attr %>><%= labels.first %></span>
          <span class="rating-mid-labels" data-rating-target="midLabels">
            <% if full_ladder %>
              <% (1..(stars - 2)).each do |i| %>
                <span class="rating-label rating-label-mid"
                      data-rating-target="midLabel"
                      data-rating-index="<%= i %>" <%= ce_attr %>><%= labels[i] %></span>
              <% end %>
            <% end %>
          </span>
          <span class="rating-label" data-rating-target="endLabel" <%= ce_attr %>><%= labels.last %></span>
        </div>
      </div>

    <% when "open_ended" %>
      <% if card["input"] == "date" %>
        <%# Date-flavoured open question — a native picker instead of free text. %>
        <div class="freeform-wrap">
          <input type="date" class="freeform-date"
                 max="<%= Date.current.iso8601 %>"
                 aria-label="<%= card["text"] %>" />
        </div>
      <% elsif card["input"] == "month" %>
        <%# Month-flavoured open question (the "When were you born?" demographic)
            — month + year only, no day. Two plain numeric fields rather than a
            native <input type="month">: that control's inline segments are
            rendered by the browser/OS and can show a spelled-out month name
            (e.g. "May") instead of digits, which isn't universal across the
            app's 19 locales. Two digit-only fields read the same everywhere. %>
        <div class="freeform-wrap">
          <div class="freeform-monthyear" data-controller="month-year">
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2"
                   class="freeform-month" placeholder="02"
                   aria-label="<%= card["text"] %> — month"
                   data-month-year-target="month" />
            <span class="freeform-monthyear-sep">/</span>
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4"
                   class="freeform-year" placeholder="1995"
                   aria-label="<%= card["text"] %> — year"
                   data-month-year-target="year" />
          </div>
          <div class="freeform-date-hint">MM / YYYY</div>
        </div>
      <% elsif card["input"] == "location" %>
        <%# Location-flavoured open question (the "Where do you live?"
            demographic) — satnav-style search-and-pick via OpenStreetMap
            Nominatim instead of free text, so location data groups reliably
            (structured city/region/country) instead of by whatever a
            respondent happened to type. This is the ONE universal source of
            a Verto's region data (see PlayerController#sync_region_from_answers!).
            See NominatimClient for the privacy note (never lat/long, never a
            raw address — only the resolved city/region/country is kept).
            The answer itself is a plain "CC|Label" string, read generically
            like any other open_ended card (see player_controller.js#_read). %>
        <div class="freeform-wrap">
          <div class="welcome-location-search" data-controller="location-search"
               <% if @survey.publish_token.present? %>
                 data-location-search-url-value="<%= player_location_search_url(@survey.publish_token) %>"
               <% end %>
               <%# Which card this is, so the search runs under the creator's
                   narrowing saved on it (LocationScope) — the server reads the
                   scope off the saved card, never from the request. %>
               <% unless card_index.nil? %>data-location-search-card-value="<%= card_index %>"<% end %>>
            <div class="location-search-input-wrap">
              <input type="text" autocomplete="off" maxlength="80" class="location-search-field"
                     placeholder="<%= t(LocationScope.placeholder_key(card["location_places"])) %>"
                     data-location-search-target="input"
                     data-action="input->location-search#search keydown->location-search#keydown" />
              <ul class="location-search-results" data-location-search-target="results" hidden></ul>
            </div>
            <input type="hidden" class="location-search-value" data-location-search-target="value" />
            <div class="location-search-selected" data-location-search-target="selected" hidden>
              <span data-location-search-target="selectedText"></span>
              <button type="button" class="location-search-change" data-action="click->location-search#change">
                <%= t("player.region_search_change") %>
              </button>
            </div>
            <div class="location-search-credit"><%= t("player.region_search_credit") %></div>
            <%# There was an optional typed postcode field here, off by default.
                It is gone: a postcode is precise enough to identify a household,
                which made it the one thing this card collected that no amount
                of small-cell suppression downstream would have made safe. The
                card now asks for a place and nothing finer. %>
          </div>
        </div>
      <% else %>
        <%# Per-card free-text cap (Survey#free_text_limit_at). Was hardcoded to
            200 with no maxlength and no server check — the counter turned pink
            and the answer saved in full anyway. %>
        <% char_limit = card["char_limit"].to_i %>
        <% char_limit = Survey::DEFAULT_FREE_TEXT_LIMIT unless char_limit.positive? %>
        <div class="freeform-wrap"
             data-controller="freeform"
             data-freeform-max-value="<%= char_limit %>">
          <textarea class="freeform-textarea"
                    placeholder="<%= t("card.answer_placeholder") %>"
                    maxlength="<%= char_limit %>"
                    data-freeform-target="input"
                    data-action="input->freeform#update"></textarea>
          <div class="freeform-counter" data-freeform-target="counter">0/<%= char_limit %> <%= t("card.characters") %></div>
          <% if editable %>
            <label class="freeform-limit-row">
              <span><%= t("card.char_limit_label", default: "Answer length") %></span>
              <select data-char-limit
                      data-freeform-target="limit"
                      data-action="change->freeform#setLimit change->survey-editor#markDirty">
                <% Survey::FREE_TEXT_LIMIT_PRESETS.each do |preset| %>
                  <option value="<%= preset %>" <%= "selected" if preset == char_limit %>>
                    <%= t("card.char_limit_option", n: preset, default: "#{preset} characters") %>
                  </option>
                <% end %>
                <%# A limit typed in before the presets existed, or set by an
                    import — keep it selectable rather than silently rewriting it. %>
                <% unless Survey::FREE_TEXT_LIMIT_PRESETS.include?(char_limit) %>
                  <option value="<%= char_limit %>" selected>
                    <%= t("card.char_limit_option", n: char_limit, default: "#{char_limit} characters") %>
                  </option>
                <% end %>
              </select>
            </label>
          <% end %>
        </div>
      <% end %>

    <%# contact_form had its branch here. The type is retired (CardTypes.retired?)
        — the player skips it and the editor drops it on save — so a deck can
        only still hold one if it is locked against edits, and then only its
        title is ever rendered. There is deliberately nothing to fall through
        to: no fields means nothing left that could take an entry. %>

    <% when "welcome_card" %>
      <%# Welcome card — in the player it hosts the intake (compare promise +
          region picker), moved here from the old top banners. %>
      <% if mode == :player %><%= render "player/welcome_intake" %><% end %>

    <% when "token_checkpoint" %>
      <%# Points Checkpoint — a milestone screen revealing points collected so
          far. No answer is captured; player_controller.js fills this in
          client-side (from the cards already answered) the moment this card
          becomes active. %>
      <% if mode == :player %>
        <div class="token-checkpoint-body" data-player-target="tokenCheckpointBody"></div>
      <% else %>
        <div class="token-checkpoint-placeholder"><%= t("card.token_checkpoint_placeholder") %></div>
      <% end %>

    <% when "points_intro" %>
      <%# The points intro, on a card of its own. The pills used to render
          inside whichever card token_intro_index named, and the fixed-height
          card paid for them out of its own content (.mt-2 is the panel's only
          shrinkable child). While this card is in the deck token_intro_index
          returns nil, so the inline copy renders nowhere and the intro exists
          exactly once. Tokenisation off ⇒ nothing to advertise ⇒ no pills. %>
      <% if mode == :player %>
        <%= render "player/token_intro" if @survey&.tokenisation_enabled? %>
      <% else %>
        <div class="token-checkpoint-placeholder"><%= t("card.points_intro_placeholder") %></div>
      <% end %>

    <% when "respondent_code" %>
      <%# The respondent code, as a card the creator can place anywhere.
          Identical mechanics to the survey-level pre-screen it supersedes
          (player/show.html.erb, rendered only when respondent_code_prescreen?):
          the same input target, the same two actions, the same promise in the
          note. What differs is only WHERE it sits, which is the whole ask.

          The code is held in memory by player_controller and rides the next
          ordinary save — it is never written to storage, and the server keeps
          only its HMAC. In the editor this is an inert replica: aria-hidden and
          untabbable, so a creator can see where it lands without typing a
          respondent's code on their behalf. %>
      <% if mode == :player %>
        <input type="text" class="respondent-code-input"
               data-player-target="respondentCode"
               maxlength="<%= Survey::MAX_RESPONDENT_CODE %>"
               autocomplete="off" spellcheck="false"
               aria-label="<%= display["text"].presence || t("player.respondent_code_title") %>"
               placeholder="<%= t("player.respondent_code_placeholder") %>" />
        <div class="respondent-code-note"><%= t("player.respondent_code_note") %></div>
        <div class="play-consent-actions">
          <button type="button" class="play-consent-agree"
                  data-action="click->player#submitRespondentCode"><%= t("player.respondent_code_continue") %></button>
        </div>
      <% else %>
        <div aria-hidden="true" style="pointer-events:none;">
          <input type="text" class="respondent-code-input" tabindex="-1" readonly
                 placeholder="<%= t("player.respondent_code_placeholder") %>" />
          <div class="respondent-code-note"><%= t("player.respondent_code_note") %></div>
          <div class="play-consent-actions">
            <button type="button" class="play-consent-agree" tabindex="-1"><%= t("player.respondent_code_continue") %></button>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# The tokenisation intro sits outside the type switch, because a creator
        can pin it to any card — it's no longer welded to the welcome card.
        Matched on deck index, not cid: a deck that never went through the
        editor's save path has no cids, and the intro still has to show up. %>
    <% if mode == :player && card_index.present? && @survey&.token_intro_index == card_index %>
      <%= render "player/token_intro" %>
    <% end %>
  </div>

  <%# Quiz: the correct-answer controls for this card. List/grid/yes-no mark the
      correct option(s) inline (above); here we cover swipe directions, scale /
      rating / open-text answers, and the per-card explanation. Hidden on
      translation tabs (CSS), so answers are only set in the primary language. %>
  <% if quiz_mode %>
    <div class="quiz-correct-block" data-quiz-block>
      <div class="quiz-correct-title"><span class="quiz-correct-star">★</span> <%= t("card.mark_correct") %></div>
      <div class="quiz-correct-hint">
        <%= t(case type
              when "open_ended"          then "card.accepted_answers_hint"
              when "range", "nps", "rating" then "card.correct_scale_hint"
              when "tap_card"            then "card.correct_tap_hint"
              else "card.correct_pick_hint" end) %>
      </div>

      <% case type
         when "tap_card" %>
        <%# One button per response, not the old fixed ✕/✓ pair: on a five-point
            scale "correct" may well be "Strongly agree", which a yes/no toggle
            has no way to say. %>
        <% Array(display["options"]).each_with_index do |opt, i| %>
          <% dir = correct_map[canon[i]].to_s %>
          <div class="quiz-tap-row" data-statement="<%= canon[i] %>" data-correct-dir="<%= dir %>">
            <span class="quiz-tap-label"><%= opt %></span>
            <% tap_responses.each do |response| %>
              <button type="button"
                      class="quiz-tap-btn<%= ' is-on' if dir == response["key"] %>"
                      style="--tap-response-color: <%= response["color"] %>;"
                      data-dir="<%= response["key"] %>"
                      title="<%= response["label"] %>"
                      aria-label="<%= response["label"] %>"
                      data-action="click->survey-editor#toggleTapCorrect"><%= tap_response_mark(response, index: i) %></button>
            <% end %>
          </div>
        <% end %>

      <% when "range", "nps" %>
        <%# Both store the 0-indexed scale position, so grade against the index. %>
        <% scale_labels = Array(display["options"]).presence || (type == "nps" ? nps_default_labels : %w[1 2 3 4 5]) %>
        <select class="quiz-correct-select" data-quiz-correct data-action="change->survey-editor#markDirty">
          <option value="">—</option>
          <% scale_labels.each_with_index do |lbl, i| %>
            <option value="<%= i %>" <%= "selected" if card["correct"].to_s == i.to_s %>><%= lbl %></option>
          <% end %>
        </select>

      <% when "rating" %>
        <select class="quiz-correct-select" data-quiz-correct data-action="change->survey-editor#markDirty">
          <option value="">—</option>
          <% (1..5).each do |n| %>
            <option value="<%= n %>" <%= "selected" if card["correct"].to_s == n.to_s %>><%= n %> ★</option>
          <% end %>
        </select>

      <% when "open_ended" %>
        <textarea class="quiz-correct-textarea" data-quiz-accepted rows="2"
                  data-controller="autogrow"
                  data-action="input->survey-editor#markDirty"
                  placeholder="<%= t('card.accepted_answers') %>"><%= Array(card["correct"]).join("\n") %></textarea>
      <% end %>

      <textarea class="quiz-correct-textarea quiz-explanation" data-quiz-explanation rows="2"
                data-controller="autogrow"
                data-action="input->survey-editor#markDirty"
                placeholder="<%= t('card.explanation_placeholder') %>"><%= card["explanation"] %></textarea>
    </div>
  <% end %>

  <%# Tokenisation: for types with no single inline "answer" to key a token
      amount off (tap_card's per-statement/per-direction awards, and the flat
      awards on scale/open/prioritise cards, and one row per option for
      list/grid/yes-no). Rendered once per card (not inline per option) so
      it relocates as a single unit into the editor's Tokenomics sidebar tab
      — see type-panel controller's registerCard. Hidden on translation tabs
      (CSS), so amounts are only ever set in the primary language. %>
  <% if token_mode %>
    <% choice_shaped = TokenGrading::CHOICE.include?(type) %>
    <% if type == "tap_card" || TokenGrading::FLAT.include?(type) || choice_shaped %>
      <div class="token-award-block" data-token-block>
        <div class="token-award-title"><span>🪙</span> <%= t("card.token_award_title") %></div>

        <%# Explicit off. "Off" used to be implicit — all-zero amounts, which the
            serialiser dropped, so a deliberately-unawarded question was
            indistinguishable from one not set up yet. Absent means enabled, so
            existing decks are untouched. %>
        <label class="token-enabled-row">
          <input type="checkbox" data-token-enabled
                 <%= "checked" unless card["tokens_enabled"] == false %>
                 data-action="change->survey-editor#markDirty" />
          <span><%= t("card.token_enabled_label", default: "This question awards points") %></span>
        </label>

        <% if type == "tap_card" %>
          <%# One column of amounts per response on this card's scale, not the
              fixed yes/unsure/no three — a six-point scale awards on six. %>
          <% Array(display["options"]).each_with_index do |opt, i| %>
            <div class="token-tap-row" data-statement="<%= canon[i] %>">
              <span class="token-award-label"><%= opt %></span>
              <% tap_responses.each do |response| %>
                <% dir = response["key"] %>
                <div class="token-inputs" data-direction="<%= dir %>">
                  <% token_types.each do |tt| %>
                    <input type="number" class="token-amount-input"
                           data-token-statement="<%= canon[i] %>" data-token-direction="<%= dir %>" data-token-id="<%= tt['id'] %>"
                           value="<%= tokens_map.dig(canon[i], dir, tt['id']) || 0 %>"
                           title="<%= "#{tt['name']} — #{response['label']}" %>"
                           data-action="input->survey-editor#markDirty" />
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% elsif choice_shaped %>
          <% option_labels = type == "yes_no" ? [["Yes", 1], ["No", 4]].map { |label, _bg| [label, t("card.#{label.downcase}", locale: display_locale, default: label)] } : Array(display["options"]).each_with_index.map { |opt, i| [canon[i], opt] } %>
          <div class="token-mode-toggle">
            <button type="button" class="token-mode-btn<%= ' is-active' if token_award_mode == 'per_answer' %>"
                    data-mode="per_answer" data-action="click->survey-editor#setTokenAwardMode">Per answer</button>
            <button type="button" class="token-mode-btn<%= ' is-active' if token_award_mode == 'completion' %>"
                    data-mode="completion" data-action="click->survey-editor#setTokenAwardMode">Completing the question</button>
          </div>

          <div data-token-mode-section="per_answer"<%= ' hidden'.html_safe unless token_award_mode == 'per_answer' %>>
            <% option_labels.each do |canon_label, shown_label| %>
              <div class="token-award-row" data-canonical="<%= canon_label %>">
                <span class="token-award-label"><%= shown_label %></span>
                <div class="token-inputs">
                  <% token_types.each do |tt| %>
                    <input type="number" class="token-amount-input" data-token-id="<%= tt['id'] %>"
                           value="<%= tokens_map.dig(canon_label, tt['id']) || 0 %>"
                           title="<%= tt['name'] %>"
                           data-action="input->survey-editor#markDirty" />
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <div data-token-mode-section="completion"<%= ' hidden'.html_safe unless token_award_mode == 'completion' %>>
            <div class="token-award-row">
              <span class="token-award-label"><%= t("card.token_award_hint") %></span>
              <% token_types.each do |tt| %>
                <input type="number" class="token-amount-input" data-token-id="<%= tt['id'] %>"
                       value="<%= token_award[tt['id']] || 0 %>"
                       title="<%= tt['name'] %>"
                       data-action="input->survey-editor#markDirty" />
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="token-award-row">
            <span class="token-award-label"><%= t("card.token_award_hint") %></span>
            <% token_types.each do |tt| %>
              <input type="number" class="token-amount-input" data-token-id="<%= tt['id'] %>"
                     value="<%= token_award[tt['id']] || 0 %>"
                     title="<%= tt['name'] %>"
                     data-action="input->survey-editor#markDirty" />
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# Answer-branching rows, rendered ONCE for any routable type (hidden in
      the card by CSS; type_panel relocates them into the Logic modal's branch
      slot for the selected card). Canonicals mirror lib/routable_types.js:
      option labels for choice types, numeric positions for the scales (range
      0-4 step, rating 1-N stars; nps labels already are "0".."10"). Multi-pick
      types match "their answer includes it" (first match wins) and prioritise
      matches the top-ranked choice — the hint line says so. %>
  <% if logic_mode %>
    <%
      logic_rows =
        case type
        when "yes_no"
          [ "Yes", "No" ].map do |cl|
            { canonical: cl, label: t("card.#{cl.downcase}", locale: display_locale, default: cl),
              selected: logic_route_value.call(cl) }
          end
        when "range"
          Array(display["options"]).each_with_index.map do |opt, i|
            { canonical: i.to_s, label: "#{i + 1} · #{opt}", selected: logic_route_value.call(i.to_s) }
          end
        when "rating"
          # A rating is a fixed 5-star visual (the stored options are just its
          # end captions — see verto_rules' countCheck), so the answer is
          # always 1..5 regardless of how many labels exist.
          rating_labels = Array(display["options"])
          Array.new(5) do |i|
            { canonical: (i + 1).to_s,
              label: "#{i + 1}★#{rating_labels[i].present? ? " #{rating_labels[i]}" : ""}",
              selected: logic_route_value.call((i + 1).to_s) }
          end
        else
          Array(display["options"]).each_with_index.map do |opt, i|
            { canonical: canon[i], label: opt, selected: logic_route_value.call(canon[i]) }
          end
        end
      logic_hint =
        case type
        when "select_many", "select_many_grid"
          "Fires when their answer includes it — the first matching answer wins."
        when "prioritise"
          "Routes on their top-ranked choice."
        end
    %>
    <%= render "shared/logic_branch_block",
          owner_cid: card["cid"],
          rows: logic_rows,
          default_selected: logic_default_value,
          hint: logic_hint %>
  <% end %>

  <%# "Other" free-text — a standalone answer the creator can toggle per card.
      Rendered for every question type (not welcome). In the editor it's always
      present (hidden on welcome) so the toggle survives a type switch. The
      "Allow other"/"Required" switches themselves live in the Answer Type
      tab's Card settings (show.html.erb .card-flags), not here — so they
      don't distort the card's visual design; only the respondent-facing
      "+Other" CTA/panel stays in the card itself. %>
  <% if editable || (is_q && card["allow_other"]) %>
    <div class="other-block" data-controller="other"<%= ' hidden'.html_safe if (editable && !is_q) %>>
      <div class="other-cta-wrap" data-other-target="wrap"<%= ' hidden'.html_safe unless card["allow_other"] %>>
        <button type="button" class="other-cta-btn" data-other-target="btn"
                data-action="click->other#toggle"<%= ' disabled'.html_safe if editable %>>＋ <%= t("card.other") %></button>
        <%# The Other box is free text by another name, so it takes the card's
            limit too — and the server clamps it alongside the answer value. %>
        <% other_limit = card["char_limit"].to_i %>
        <% other_limit = Survey::DEFAULT_FREE_TEXT_LIMIT unless other_limit.positive? %>
        <div class="other-panel" data-other-target="panel" hidden
             data-controller="freeform" data-freeform-max-value="<%= other_limit %>">
          <textarea class="freeform-textarea other-textarea"
                    placeholder="<%= t("card.other_placeholder") %>"
                    maxlength="<%= other_limit %>"
                    data-other-input
                    data-freeform-target="input"
                    data-action="input->freeform#update"></textarea>
          <div class="freeform-counter" data-freeform-target="counter">0/<%= other_limit %> <%= t("card.characters") %></div>
        </div>
      </div>
    </div>
  <% end %>

</div>
