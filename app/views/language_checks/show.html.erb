<% content_for :title, "#{@survey.theme} · #{t("language_check.title")} · Playverto" %>

<div class="lc-page" data-controller="modal" data-action="keydown.esc@window->modal#closeOnEsc">
  <div class="lc-wrap lc-wrap--rail">

    <div class="lc-top">
      <a class="lc-back" href="<%= survey_path(@survey) %>">← <%= t("language_check.back_to_editor") %></a>
      <div class="lc-top-row">
        <div>
          <h1 class="lc-title"><%= t("language_check.title") %></h1>
          <p class="lc-sub"><%= t("language_check.subtitle", title: @survey.theme.presence || @survey.title.to_s) %></p>
        </div>
        <%# Sending the page out is the point of the screen, so the way to do it
            is at the top where it is found — but it is a once-per-reviewer act
            next to a board someone works down for twenty minutes, so it lives
            behind a modal rather than taking permanent space. %>
        <button type="button" class="lc-btn lc-btn--approve lc-send-btn"
                data-action="click->modal#open" aria-haspopup="dialog"
                aria-controls="language-check-share-modal">
          <%= t("language_check.links_title") %>
          <% if @links.any? %><span class="lc-send-count"><%= @links.count { |l| l.active? } %></span><% end %>
        </button>
      </div>
    </div>

    <div class="lc-layout">
      <%= render "language_checks/languages_rail",
                 survey: @survey, locales: @locales, coverage: @coverage,
                 addable: @addable, editable: @editable, runs: @runs,
                 retranslatable: @retranslatable %>

      <div class="lc-main">
        <% if @locales.size < 2 %>
          <%# A one-language Verto has nothing to check against. The rail beside
              this is where the second language is added, so point at it rather
              than sending the creator back to the editor. %>
          <div class="lc-blank">
            <p><%= t("language_check.single_language_title") %></p>
            <p class="lc-blank-sub"><%= t("language_check.single_language_rail_body") %></p>
          </div>
        <% else %>
          <%= render "language_checks/board",
                     survey: @survey, cards: @cards, locales: @locales,
                     checks: @checks, notes: @notes, editable: @editable,
                     post_url: survey_language_check_lines_path(@survey),
                     filter: params[:filter].presence || "all", owner: true %>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "language_checks/share_modal", survey: @survey, links: @links, locales: @locales %>
</div>
