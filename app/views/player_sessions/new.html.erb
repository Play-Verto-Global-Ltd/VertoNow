<%# Signing back in with the password chosen at the end of a Verto. Same shell
    and same classes as player_sign_ins/show — a respondent who has seen one of
    these pages should recognise the other.

    No "forgot your password?" link, and that is not an oversight: there is no
    respondent password reset. PlayerSessionsController#link is the recovery
    route and it needs working SMTP, so a button offering it today would be the
    same silent nothing this whole change was made to remove. %>
<div class="you-page">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <div class="you-shell you-shell-narrow">
    <div class="you-mark"><%= image_tag "playverto.svg", alt: "Playverto", width: 120 %></div>

    <div class="you-card">
      <h1 class="you-h1"><%= t("player_session.title") %></h1>
      <p class="you-sub"><%= t("player_session.body") %></p>
      <%# Where a confirmation link opened on a signed-out device lands, so it
          has to be able to say what just happened — and a failed sign-in
          sets an alert that this page had nowhere to draw. %>
      <%= render "you/flash" %>

      <%# Google first, and for a reason beyond convenience: there is no
          respondent password reset, so for somebody who signed up this way it
          is not an alternative door, it is the only one. Their row has no
          password_digest at all — the form below would tell them their
          password was wrong about an account that has never had one.

          A live page with a live token, so the CSRF-protected POST can go
          straight out from here; the end-of-Verto card cannot do that, which
          is what PlayerJoinsController exists for. %>
      <% if (providers = SocialAuth.player_enabled).any? %>
        <% providers.each do |p| %>
          <%= button_to "/auth/#{p.key}", data: { turbo: false },
                form: { style: "margin:0;" }, class: "you-btn you-btn-google" do %>
            <%= render "shared/google_mark" if p.key.to_s.start_with?("google") %>
            <span><%= t("auth.social_continue", provider: p.label) %></span>
          <% end %>
        <% end %>
        <div class="you-divider" aria-hidden="true"><span><%= t("auth.social_divider") %></span></div>
      <% end %>

      <%# Same path as the GET, different verb — the route has no name of its
          own, so the form posts back to where it was rendered. %>
      <%= form_with url: new_player_session_path, method: :post, data: { turbo: false },
                    html: { style: "margin:0;" } do |f| %>
        <%= f.email_field :email_address, required: true,
              autocomplete: "email", inputmode: "email", spellcheck: false,
              autocapitalize: "off", class: "you-input",
              placeholder: t("player.join_email_placeholder"),
              aria: { label: t("player.join_email_placeholder") } %>
        <%# Same toggle the end-of-Verto card has, for a stronger reason: there
            is no respondent password reset, so somebody mistyping here has no
            way to find out that is what went wrong. The message they get says
            the address and password don't match, which is deliberately the
            same answer a wrong address gets. %>
        <div class="password-field you-password-field" <%= tag.attributes(data: password_visibility_data) %>>
          <%= f.password_field :password, required: true,
                autocomplete: "current-password", class: "you-input",
                placeholder: t("player_session.password_placeholder"),
                aria: { label: t("player_session.password_placeholder") },
                data: { password_visibility_target: "input" } %>
          <%= render "shared/password_toggle" %>
        </div>
        <%= f.submit t("player_session.cta"), class: "you-btn you-btn-primary" %>
      <% end %>

      <p class="you-fine"><%= t("player_session.fine") %></p>
    </div>
  </div>
</div>
