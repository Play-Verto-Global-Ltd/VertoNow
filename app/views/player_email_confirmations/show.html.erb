<%# Where the confirmation mail's button lands. Signed in or not — see
    PlayerEmailConfirmationsController#show. Opened twice, or a week late, it
    says so instead of claiming to have done it again. %>
<div class="you-page">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <div class="you-shell you-shell-narrow">
    <div class="you-mark"><%= image_tag "playverto.svg", alt: "Playverto", width: 120 %></div>
    <div class="you-card">
      <% if @already %>
        <h1 class="you-h1"><%= t("player_email_confirmation.already_title") %></h1>
        <p class="you-sub"><%= t("player_email_confirmation.already_body") %></p>
      <% else %>
        <h1 class="you-h1"><%= t("player_email_confirmation.confirmed_title") %></h1>
        <p class="you-sub"><%= t("player_email_confirmation.confirmed_body") %></p>
      <% end %>
      <%= link_to t("player_email_confirmation.cta"), you_path, class: "you-btn" %>
    </div>
  </div>
</div>
