<%# An expired link, or one whose address has changed since it was sent. No
    resend here and no address echoed back: this page is reachable by anyone
    holding a string, and a resend that answered for an address would be an
    enumeration oracle. The resend lives on /you, inside the account. %>
<div class="you-page">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <div class="you-shell you-shell-narrow">
    <div class="you-mark"><%= image_tag "playverto.svg", alt: "Playverto", width: 120 %></div>
    <div class="you-card">
      <h1 class="you-h1"><%= t("player_email_confirmation.invalid_title") %></h1>
      <p class="you-sub"><%= t("player_email_confirmation.invalid_body", days: (Player::CONFIRMATION_LIFETIME / 1.day).to_i) %></p>
      <%= link_to t("player_email_confirmation.cta"), you_path, class: "you-btn" %>
    </div>
  </div>
</div>
