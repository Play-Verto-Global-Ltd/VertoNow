<% content_for :title, "#{@survey.theme} · Playverto" %>
<% content_for :theme_color, BrandPalette.resolve(@survey.brand_palette)["bg"] %>
<%# Shared /play (and /test) links unfurl as nothing in WhatsApp/Slack/etc.
    without these — social recruitment is a real distribution channel for a
    Verto, and Test Mode is explicitly built to be a no-signup shareable link
    too. Skipped only for the owner's own dashboard preview (@preview without
    @test_mode) — that's an authed iframe, never a shared URL. %>
<% unless @preview && !@test_mode %>
  <% content_for :head do %>
    <%# The creator's own share copy where they have written it, and exactly what
        these tags said before it existed where they haven't — Survey#share_title_text
        falls back to "theme · Playverto", share_description_text to the editing
        brief and then the theme. A Verto nobody has written share copy for
        unfurls as it always did. %>
    <%= tag.meta property: "og:title", content: @survey.share_title_text %>
    <%= tag.meta property: "og:description", content: @survey.share_description_text.to_s.truncate(200) %>
    <%= tag.meta property: "og:type", content: "website" %>
    <%= tag.meta property: "og:site_name", content: "Playverto" %>
    <%= tag.meta property: "og:url", content: request.base_url + request.path %>
    <%# Always present. Survey#share_image_path falls back through the Verto's
        own imagery to a theme-matched picture from the committed library, so
        there is no branch here and no Verto that unfurls as a grey nothing.
        Absolutised against this request, because og:image must be absolute and
        only the request knows the host — a Pexels URL is already absolute and
        URI.join leaves it alone. %>
    <% share_image = URI.join(request.base_url, @survey.share_image_path).to_s %>
    <%= tag.meta property: "og:image", content: share_image %>
    <%= tag.meta property: "og:image:alt", content: @survey.share_image_alt %>
    <%= tag.meta name: "twitter:image", content: share_image %>
    <%# summary_large_image rather than summary now there is reliably an image
        worth the room. %>
    <%= tag.meta name: "twitter:card", content: "summary_large_image" %>
  <% end %>
<% end %>
<%
  # Retired card types are skipped, not renumbered. Each surviving card keeps
  # the index it holds in @survey.cards — that index IS the answer key
  # (data-card-index below), so the deck is paired with its own positions and
  # iterated as pairs rather than re-enumerated. Dropping a card and letting
  # the rest slide up by one would re-point every answer after it.
  # Card imagery drawn straight from the bucket when uploads live there
  # (PlayerAssetUrls): map BEFORE each_with_index so the indexes — the answer
  # keys — are untouched.
  cards   = Array(@survey.cards).map { |c| PlayerAssetUrls.direct_card(c) }.each_with_index.reject { |c, _| CardTypes.retired?(c["type"]) }
  total_q = cards.count { |c, _| CardTypes.question?(c["type"]) }
  prev_q  = 0

  # Owner preview (from the dashboard): the exact respondent experience but
  # with blank recording endpoints, so stepping through never creates a
  # Response. Drafts have no publish_token, so their URLs must stay blank too.
  # Live visitors keep the token they arrived with (publish or share), so
  # progress/submit resolve the same attribution context.
  preview_mode    = @preview == true
  # Test Mode (@test_mode, via /test/:token) blanks the token itself:
  # params[:token] is the TEST token, not a play token, and every optional
  # endpoint URL below (results/regions/quiz/share) derives from play_token —
  # nil kills the whole URL family at the source, so an unauthenticated
  # tester's page carries no live endpoint at all.
  play_token      = @test_mode ? nil : (params[:token].presence || @survey.publish_token)
  progress_url    = preview_mode ? "" : progress_survey_url(play_token)
  submit_url      = preview_mode ? "" : submit_survey_url(play_token)
  consent_url     = preview_mode ? "" : consent_survey_url(play_token)
  # play_settings is the send link this respondent arrived through, if any,
  # else the Verto — so a link that pins comparison off gets no results URL at
  # all, not a hidden button (ApplicationController#play_settings).
  results_url     = play_settings.compare_results? && play_token.present? ? player_results_url(play_token) : ""
  show_comparison = play_settings.compare_results? && results_url.present?
  # The public play link respondents can pass on via the Share button on the
  # thank-you screen. Blank in owner preview (and for token-less drafts).
  # Creators can switch Share off; it defaults on, because it has been on for
  # every published Verto up to now.
  share_url       = preview_mode || play_token.blank? || !play_settings.share_button? ? "" : play_survey_url(play_token)

  # Every Verto captures region data via the "Where do you live?" demographic
  # question, so the post-finish map is always available — it just needs a
  # reachable token (drafts in preview have none) and the creator's say-so
  # (regions_enabled, also default on for the same reason).
  regions_url = play_token.present? && play_settings.regions_map? ? player_regions_url(play_token) : ""

  # Quiz mode: each graded card is scored server-side as the player advances.
  # The grade/state endpoints need a reachable token, so they're blank in owner
  # preview (and for token-less drafts) — preview instead grades client-side
  # from correct answers embedded only on the owner's preview page. The scores
  # ("how you compare") endpoint is a read and likewise needs a live token.
  quiz_mode      = @survey.quiz?
  live_quiz      = quiz_mode && !preview_mode && play_token.present?
  grade_url      = live_quiz ? grade_survey_url(play_token) : ""
  quiz_state_url = live_quiz ? quiz_state_survey_url(play_token) : ""
  scores_url     = live_quiz ? player_scores_url(play_token) : ""
  graded_set     = quiz_mode ? @survey.graded_card_indices.to_set : Set.new

  # Ask-once recall: entering the code fills in answers this person already
  # gave to this deck's ask-once questions somewhere else. Off unless the
  # creator turned it on, on the card itself — it hands back a DIFFERENT
  # person's answers if a code is guessed, so it is never on by default. Blank
  # in owner preview and Test Mode for the same reason grade_url is: neither
  # has any business reading a real respondent's answers.
  recall_url = (@survey.respondent_code_recall? && !preview_mode && play_token.present?) ?
                 recall_survey_url(play_token) : ""

  # No retests on a code-collecting Verto: the code step asks whether this code
  # has already finished the current wave. Blank on the device basis (the local
  # marker decides there) and, like every endpoint above, in owner preview and
  # Test Mode.
  eligibility_url = (@survey.retest_basis == "code" && !preview_mode && play_token.present?) ?
                      eligibility_survey_url(play_token) : ""

  # Tokenisation: a card's token config is public (rendered straight into the
  # page), so the running total is computed entirely client-side — no
  # grade-style round trip needed. The server only recomputes the
  # authoritative total at progress/submit time (PlayerController#apply_token_totals).
  token_mode         = @survey.tokenisation_enabled?
  token_awarding_set = token_mode ? @survey.token_awarding_indices.to_set : Set.new

  # Leaderboard: only meaningful with tokens to rank (leaderboard_active?).
  # The URL derives from play_token like every optional endpoint above, so
  # owner preview and Test Mode carry no live endpoint and the board simply
  # doesn't render there.
  leaderboard_mode = token_mode && @survey.leaderboard_enabled?
  leaderboard_url  = leaderboard_mode && !preview_mode && play_token.present? ? player_leaderboard_url(play_token) : ""

  # Respondent accounts: the end-screen ask. Blank in owner preview and Test
  # Mode like every other live endpoint — a creator checking their own Verto
  # must not be able to mail themselves a sign-in link from it, and Test Mode's
  # "no live endpoint may reach this page" test asserts every *-url-value is
  # empty there.
  join_url = @survey.join_prompt? && !preview_mode && play_token.present? ? join_survey_url(play_token) : ""
  # Derived FROM join_url rather than rebuilt beside it, so the preview and
  # Test Mode blanking above is inherited rather than re-stated — a second copy
  # of that condition is a second chance to get it wrong, and the thing it
  # guards is a live endpoint reaching a page that must not have one.
  join_google_url = join_url.present? && SocialAuth.player_enabled? ? join_google_survey_url(play_token) : ""

  # Answer-branching: a card's routing config is public (like token config), so
  # the player follows the graph entirely client-side from the same cards JSON.
  logic_mode = @survey.logic?
%>
<%# No inline height here — `.preview-overlay`'s own CSS (position:fixed +
    inset:0, backed by the JS-measured --app-100vh custom property on mobile)
    handles sizing. A hardcoded "height:100vh;" here previously overrode that
    CSS unconditionally (inline styles beat any class rule), which is the
    classic mobile WebKit bug: 100vh locks to the viewport with the browser's
    toolbar hidden, so on first paint (toolbar visible) the bottom of the
    page — including the Next button — rendered below the visible fold with
    no way to scroll to it. %>
<div class="preview-overlay flex flex-col<%= " forms-mode" if @survey.forms_mode? %>"
     style="<%= verto_backdrop_style_attr(@survey) %>"
     dir="<%= SupportedLocales.dir(@display_locale) %>"
     data-controller="player"
     <%# The tap stack announces its last statement (tap-stack:complete) and
         its Reset; the player answers with a paced auto-advance — the
         respondent has nothing left to do on the card, so after a natural
         beat the deck moves on for them (guards live in tapStackCompleted). %>
     data-action="tap-stack:complete->player#tapStackCompleted tap-stack:cleared->player#cancelAutoAdvance"
     data-player-forms-value="<%= @survey.forms_mode? %>"
     data-player-progress-url-value="<%= progress_url %>"
     data-player-submit-url-value="<%= submit_url %>"
     data-player-consent-url-value="<%= consent_url %>"
     data-player-results-url-value="<%= results_url %>"
     data-player-regions-url-value="<%= regions_url %>"
     data-player-locale-value="<%= @display_locale %>"
     data-player-share-url-value="<%= share_url %>"
     <%# The creator's share copy, carried into the native share sheet. Both
         were being dropped on the floor: the sheet got document.title and the
         URL, so the headline and the "message respondents send" line the
         editor collects went nowhere. Blank when share is off or there is no
         link to pass on, exactly like share_url itself. %>
     data-player-share-title-value="<%= share_url.present? ? @survey.share_title_text : "" %>"
     data-player-share-text-value="<%= share_url.present? ? @survey.share_message_text : "" %>"
     data-player-show-comparison-value="<%= show_comparison %>"
     data-player-quiz-value="<%= quiz_mode %>"
     data-player-grade-url-value="<%= grade_url %>"
     data-player-quiz-state-url-value="<%= quiz_state_url %>"
     data-player-scores-url-value="<%= scores_url %>"
     data-player-recall-url-value="<%= recall_url %>"
     data-player-tokenisation-value="<%= token_mode %>"
     data-player-token-types-value="<%= @survey.token_types.to_json %>"
     <%# The creator's sentence above the final tally. Carried as a value
         rather than server-rendered beside .token-result-card, because that
         card is built by _renderTokenScore and is skipped entirely on a Verto
         with no token types — a sibling would be a note explaining totals that
         never arrive. Empty when unset, which is how the render decides. %>
     data-player-tokens-result-note-value="<%= @survey.token_result_note_text %>"
     data-player-token-reveal-value="<%= @survey.token_reveal_enabled? %>"
     data-player-token-back-nav-value="<%= @survey.token_back_nav_enabled? %>"
     data-player-leaderboard-value="<%= leaderboard_mode %>"
     data-player-leaderboard-url-value="<%= leaderboard_url %>"
     data-player-join-url-value="<%= join_url %>"
     data-player-join-google-url-value="<%= join_google_url %>"
     data-player-contact-value="<%= @survey.contact_form_enabled? %>"
     data-player-no-going-back-value="<%= @survey.no_going_back? %>"
     data-player-no-retests-value="<%= @survey.retest_basis %>"
     data-player-wave-value="<%= @survey.current_wave&.position || 1 %>"
     data-player-eligibility-url-value="<%= eligibility_url %>"
     data-player-logic-value="<%= logic_mode %>"
     data-player-end-screens-value="<%= @survey.end_screens_list.to_json %>"
     data-player-forward-label-value="<%= t('player.visit_website') %>"
     <%# Where the hidden press-and-hold hatch goes (player/_test_mode_hatch).
         Blank in owner preview and in Test Mode itself, so the hatch is inert
         there twice over — the partial isn't rendered, and the controller has
         nowhere to send anyone. Blank is also what Test Mode's "no live endpoint
         may reach this page" test already asserts of every *-url-value. %>
     <%# The survey-level consent gate renders as a bottom banner over the
         first question (player/_consent_banner). This attribute is the whole
         state machine: while present the deck is inert and dimmed and the
         footer nav is hidden (CSS keys off it); agreeing removes it. %>
     <%= "data-consent-pending".html_safe if @survey.show_consent_gate? %>
     data-player-test-mode-url-value="<%= preview_mode ? "" : live_test_survey_url(play_token) %>">

  <% if @test_mode %>
    <%# Test Mode used to be a strip across the top, and a strip is height:
        ~31px off every card, on the one surface where the card is already
        competing with a notch. It is a yellow ring around the whole viewport
        now, drawn by .play-test-frame at the foot of this overlay — out of
        flow, so it costs the card nothing.
        The sentence survives here, clipped. A ring says "something is
        different"; it cannot say "nothing you enter is saved", and that is
        the only place a tester is told so. Visually hidden rather than
        deleted, and rather than `display: none`, which would take it from a
        screen reader too. The ⚗ glyph is gone with the strip: it was never
        aria-hidden, so it was being announced as a word. %>
    <p class="play-test-note"><%= t("player.test_mode_banner") %></p>
  <% elsif preview_mode %>
    <div class="play-banner play-banner-preview">
      <span class="play-banner-text">▶ <%= t("player.preview_banner") %></span>
      <%= link_to t("player.exit_preview"), root_path, class: "play-banner-link" %>
    </div>
  <% end %>

  <%# Publishing org's logo, centred above the deck — desktop only. On a phone
      the same logo rides the utility bar below instead (.player-bar-logo),
      which costs the card no height of its own because that strip is already
      drawn; the thank-you card's own copy stands down there.
      Only drawn when there IS a logo: an org that hasn't uploaded one gets no
      masthead rather than our wordmark in their slot, and the wrapper is
      skipped along with it because its own 18px of padding would otherwise
      hold an empty band open above the deck. %>
  <% if (masthead = brand_logo_tag(@survey.organisation, style: "height:36px;width:auto;max-width:50%;", direct: true)) %>
    <div class="player-brand-header"><%= masthead %></div>
  <% end %>

  <%# Slim top-utility bar: the content-language switcher (multilingual Vertos
      only) alongside the text-size control (always — a reading preference,
      not a per-Verto one). %>
  <div class="player-lang-bar">
    <%# Nothing to see — literally. See the partial. Rendered FIRST so its
        margin-right:auto parks it at the leading edge and every visible control
        below keeps the exact position it has today, multilingual or not. %>
    <% unless preview_mode %>
      <%= render "player/test_mode_hatch" %>
    <% end %>
    <%# The publishing org's logo, centred in the bar — phones only (the
        desktop masthead above already carries it). The bar was a band of
        backdrop above the card holding a language pill and, on a
        monolingual Verto, nothing visible at all: "I was going to say remove
        the black bar at the top as it feels weird, but maybe the Unleash
        Football logo could sit small in the middle of the bar, so it looks
        like it serves more of a purpose?".
        Centred by position rather than by flex order, so the hatch and the
        language pill keep the exact places they have today. Renders nothing
        for an org with no logo, and the bar then collapses as before. %>
    <%= brand_logo_tag @survey.organisation, class: "player-bar-logo",
          style: "height:24px;width:auto;max-width:45%;", direct: true %>
    <% if @survey.multilingual? %>
      <%= render "player/content_lang_switcher" %>
    <% end %>
    <%= render "player/font_scale_control" %>
  </div>

  <%# inert while the consent banner is pending: the first question is VISIBLE
      from the first paint — that is the point of the banner — but nothing in
      the deck may be answerable, focusable or read by AT until a choice is
      made. The player controller removes it together with the attribute. %>
  <div class="preview-body"<%= " inert".html_safe if @survey.show_consent_gate? %>>
    <%# The survey-level consent gate is NOT a card any more. It used to be a
        full-screen pseudo-card pinned here, ahead of the deck; it is now the
        bottom banner rendered after the footer (player/_consent_banner), so
        the respondent lands straight on the first question. show_consent_gate?
        rather than consent_required?: a Verto that collects personal data (the
        auto-appended birth date / location / gender tail) but has no
        creator-authored gate still gets one, with default wording. See
        Survey#default_consent_gate? for why this is enforced here rather than
        at publish. %>

    <%# Respondent-code gate — under the consent banner when both are on, before
        the first question. It carries NO data-card-index, so it never becomes an
        answer and never shifts the answer keys, which align to @survey.cards positions.
        The code is sent with the next save and immediately hashed; the plaintext
        is never stored, logged, or returned. %>
    <%# The FIRST card target ships .active from the server. Cards are
        display:none until .active, and the class used to be applied only by
        the player controller's first _update() — so on a cold cache over slow
        wifi the respondent stared at an empty brand background for the whole
        module waterfall (measured 6.5s at 400ms RTT) and read it as broken.
        The controller re-runs the toggle at boot, so this is purely the
        first paint arriving with the HTML; JS still owns navigation. %>

    <%# Contact gate — a leading pseudo-card like the respondent-code gate
        below: it carries NO data-card-index, so what's typed here can never
        become an answer or shift the answer keys. The details ride the
        ordinary saves into their own table (ContactDetail), keyed by the same
        per-survey digest that names this device on the leaderboard — that
        digest is the only link between the volunteered identity and the
        pseudonymous responses. First visit only: submitting OR skipping
        marks the device done and return visits start past it. A Verto with
        this gate cannot also ask the neurodiversity question
        (Survey#contact_form_excludes_neurodiversity). %>
    <% if @survey.contact_form_enabled? %>
      <div class="preview-card active"
           data-player-target="card"
           data-card-type="contact_gate_card">
        <div class="split-card">
          <div class="split-left"><div class="panel-progress"><div class="panel-progress-fill" style="width:5%;"></div></div></div>
          <div class="split-right">
            <div class="play-consent-main">
              <div class="q-header">
                <div class="q-title"><%= t("player.contact_title") %></div>
              </div>
              <div class="play-consent-body contact-gate-body"><%= t("player.contact_body") %></div>
              <%# One flex child, not four: .play-consent-main's 16px gap
                  between every input plus each input's own 14px margin made
                  the gate a tower. Inside a wrapper the inputs space
                  themselves and the gap is paid once. %>
              <div class="contact-gate-fields">
                <input type="text" class="respondent-code-input" data-player-target="contactName"
                       autocomplete="name" maxlength="<%= ContactDetail::MAX_FIELD %>"
                       aria-label="<%= t("player.contact_name") %>" placeholder="<%= t("player.contact_name") %>" />
                <input type="email" class="respondent-code-input" data-player-target="contactEmail"
                       autocomplete="email" inputmode="email" maxlength="<%= ContactDetail::MAX_FIELD %>"
                       aria-label="<%= t("player.contact_email") %>" placeholder="<%= t("player.contact_email") %>" />
                <input type="text" class="respondent-code-input" data-player-target="contactCompany"
                       autocomplete="organization" maxlength="<%= ContactDetail::MAX_FIELD %>"
                       aria-label="<%= t("player.contact_company") %>" placeholder="<%= t("player.contact_company") %>" />
                <input type="text" class="respondent-code-input" data-player-target="contactIndustry"
                       maxlength="<%= ContactDetail::MAX_FIELD %>"
                       aria-label="<%= t("player.contact_industry") %>" placeholder="<%= t("player.contact_industry") %>" />
              </div>
              <div class="respondent-code-note"><%= t("player.contact_note") %></div>
              <div class="play-consent-legal">
                <%= link_to t("player.consent_privacy_link"), privacy_path,
                            target: "_blank", rel: "noopener" %>
              </div>
              <div class="play-consent-actions">
                <button type="button" class="play-consent-agree"
                        data-action="click->player#submitContactDetails"><%= t("player.contact_continue") %></button>
                <button type="button" class="play-consent-decline"
                        data-action="click->player#skipContactDetails"><%= t("player.contact_skip") %></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%# The survey-level PRE-SCREEN. Rendered only when the deck has no
        respondent_code card of its own: the card supersedes the switch, the
        same way consent_gate supersedes consent_text
        (Survey#respondent_code_prescreen?). Asking twice would be asking twice
        for a code the server records once. %>
    <% if @survey.respondent_code_prescreen? %>
      <div class="preview-card<%= " active" unless @survey.contact_form_enabled? %>"
           data-player-target="card"
           data-card-type="respondent_code_card">
        <div class="split-card">
          <div class="split-left"><div class="panel-progress"><div class="panel-progress-fill" style="width:5%;"></div></div></div>
          <div class="split-right">
            <div class="play-consent-main">
              <div class="q-header">
                <div class="q-title"><%= t("player.respondent_code_title") %></div>
              </div>
              <div class="play-consent-body"><%= @survey.respondent_code_prompt_text %></div>
              <input type="text" class="respondent-code-input"
                     data-player-target="respondentCode"
                     maxlength="<%= Survey::MAX_RESPONDENT_CODE %>"
                     autocomplete="off" spellcheck="false"
                     aria-label="<%= t("player.respondent_code_title") %>"
                     placeholder="<%= t("player.respondent_code_placeholder") %>" />
              <div class="respondent-code-note"><%= t("player.respondent_code_note") %></div>
              <div class="play-consent-actions">
                <button type="button" class="play-consent-agree"
                        data-action="click->player#submitRespondentCode"><%= t("player.respondent_code_continue") %></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% first_deck_card = !@survey.respondent_code_prescreen? && !@survey.contact_form_enabled? %>
    <% cards.each do |card, idx| %>
      <%
        type    = card["type"].to_s
        is_q    = CardTypes.question?(type)
        graded  = graded_set.include?(idx)
        awards_tokens = token_awarding_set.include?(idx)
        prev_q += 1 if is_q
        prog   = total_q > 0 ? ((prev_q.to_f / total_q) * 100).round : 5
        prog   = 5 unless is_q
        server_active = first_deck_card
        first_deck_card = false
      %>
      <%# A graded card carries only a boolean flag in the live player — never
          its correct answer (that's revealed by the server after answering).
          In owner preview the answer rides along so the reveal works offline.
          A card's token config is NOT secret (unlike a quiz's correct answer)
          — it's public config the creator set, so it rides along even live,
          letting the player compute a running total client-side. %>
      <div class="preview-card<%= " active" if server_active %>"
           data-player-target="card"
           data-card-index="<%= idx %>"
           data-card-cid="<%= card['cid'].to_s %>"
           <% if logic_mode %>data-card-logic="<%= card['logic'].to_json %>"<% end %>
           <% if logic_mode && card['next'].is_a?(Hash) %>data-card-next="<%= card['next'].to_json %>"<% end %>
           data-card-type="<%= type %>"
           data-card-graded="<%= graded %>"
           <% if preview_mode && graded %>data-card-correct="<%= QuizGrading.correct_display(card).to_json %>" data-card-explanation="<%= card['explanation'] %>"<% end %>
           data-card-awards-tokens="<%= awards_tokens %>"
           <% if awards_tokens %>data-card-tokens="<%= card['tokens'].to_json %>" data-card-token-award="<%= card['token_award'].to_json %>" data-card-token-award-mode="<%= card['token_award_mode'] %>"<% end %>
           data-card-required="<%= (is_q && card['required']) ? 'true' : 'false' %>"
           <%# The creator's intro modal, shown over this card the first time
               the respondent arrives on it. The flag rides the wrap so the
               player can decide whether to open one without reaching into the
               card's markup for a node that may not be there. %>
           <% if card_has_modal?(card) %>data-card-modal="true"<% end %>
           data-card-ask-once="<%= (is_q && card['ask_once']) ? 'true' : 'false' %>">
        <%= render "player/play_card", card: card, progress: prog, card_index: idx,
              locale: @display_locale, default_locale: @survey.default_locale %>
      </div>
    <% end %>

    <div class="preview-thankyou" data-player-target="thankyou">
      <%# Derived here rather than beside its first use, because that use is now
          inside a capture block and the compare panel further down needs it
          too — a local first assigned inside a block is invisible outside it. %>
      <% show_quiz_scores = quiz_mode && scores_url.present? %>
      <%
        thankyou_message = capture do %>
        <%# Publishing org's logo, mobile only — desktop already has the
            persistent masthead above the deck (.player-brand-header), and
            showing both would double up on the thank-you screen. Renders
            nothing for an org with no logo; the "Powered by Playverto"
            wordmark further down is the attribution and is unaffected. %>
        <%= brand_logo_tag @survey.organisation,
              style: "height:44px;width:auto;max-width:60%;margin:0 auto 18px;",
              class: "player-thankyou-logo", direct: true %>

        <div class="preview-thankyou-title" data-player-target="thankyouTitle"><%= @survey.thankyou_title_text %></div>
        <div class="preview-thankyou-sub" data-player-target="thankyouSub"><%= safe_join(@survey.thankyou_body_text.split("\n"), tag.br) %></div>
        <%# "from <account>". Its own line, under the message rather than
            standing in for it: as the message's fallback the two could never
            both appear, so a creator who wrote an end message lost the
            attribution and one who wrote none had it saved as their message.
            Never rewritten by a branch end screen (player#_applyEndScreen
            swaps the title and the message) — the Verto is published by the
            same account whichever screen a respondent lands on.
            No whitespace inside .preview-thankyou-sub above: it is hidden
            while :empty, and a newline is content. %>
        <div class="preview-thankyou-from"><%= @survey.thankyou_from_text %></div>
      <% end %>

      <%
        thankyou_actions = capture do %>
        <%# Quiz final score — filled in by the player on finish (live: from the
            submit response; preview: from client-side grading). %>
        <% if quiz_mode %>
          <div class="quiz-result-card hidden" data-player-target="quizScore"></div>
        <% end %>

        <%# Tokenisation final totals — filled in by the player on finish (live:
            from the submit response; preview/offline: from the running client
            tally, since a card's token config is public, not secret like a
            quiz's correct answer). %>
        <% if token_mode %>
          <div class="token-result-card hidden" data-player-target="tokenScore"></div>
        <% end %>

        <%# Leaderboard — filled in by the player on finish from the live
            endpoint (blank URL in preview/test keeps it empty there). %>
        <% if leaderboard_mode %>
          <div class="leaderboard-card hidden" data-player-target="leaderboard"></div>
        <% end %>

        <%# Thank-you actions: compare (brand CTA) then the outline secondaries —
            forward-to-website, share, and regions. Quiz score comparison and
            general answer comparison are independent settings (a creator can
            turn on either or both), but they used to render as two separate
            CTAs/panels — redundant and confusing when both are on. One button
            now opens one panel with whichever section(s) apply. %>
        <div class="play-end-actions">
          <% if show_quiz_scores || show_comparison %>
            <button type="button"
                    data-player-target="compareBtn"
                    data-action="click->player#showCompare"
                    class="play-end-btn play-end-btn-primary">
              <%= show_comparison ? t("player.compare_cta") : t("player.quiz_compare_cta") %>
            </button>
          <% end %>

          <%# Respondent accounts: the ask goes SECOND, under the compare CTA —
              the comparison is what they came for, the account is what they
              might want afterwards. A full-width card rather than a pill,
              like the token result and the leaderboard above it. %>
          <% if @survey.join_prompt? %>
            <%= render "player/join_block" %>
          <% end %>

          <%# Forward-to-website CTA. Always rendered (hidden until it has a URL)
              so answer-branching can point different end screens at different
              links — e.g. a per-hub Stripe page — swapped in by _applyEndScreen. %>
          <a data-player-target="forwardBtn"
             href="<%= @survey.forward_url %>" target="_blank" rel="noopener"
             class="play-end-btn<%= " hidden" unless @survey.forward_url? %>">
            <%= @survey.forward_label.presence || t("player.visit_website") %> →
          </a>

          <%# Share is opt-OUT: it has been on for every published Verto so far,
              so share_enabled defaults true and this only disappears when a
              creator deliberately turns it off. %>
          <% if @survey.share_enabled? %>
            <button type="button"
                    data-player-target="shareBtn"
                    data-action="click->player#share"
                    class="play-end-btn">
              <%= t("player.share") %>
            </button>
          <% end %>

          <% if regions_url.present? %>
            <button type="button"
                    data-player-target="regionsBtn"
                    data-action="click->player#showRegions"
                    class="play-end-btn">
              🌍 <%= t("player.see_regions") %>
            </button>
          <% end %>

          <%# Play again — the retake the leaderboard exists to reward. Only
              where a retake is allowed at all (No retests refuses it) AND can
              change the standings: under first-run-counts a second run is
              ignored, so offering one would be a lie. %>
          <% if leaderboard_mode && !@survey.no_retests? && !@survey.leaderboard_no_redo? %>
            <button type="button"
                    data-action="click->player#playAgain"
                    class="play-end-btn">
              🔁 <%= t("player.play_again") %>
            </button>
          <% end %>

          <%# Next person — No retests on a code-collecting Verto hides Play
              again, but a shared classroom device still needs a hand-over: the
              finished tab keeps its session token, so the next pupil would
              otherwise write onto this run's row. Same mechanics as Play again
              (fresh token, reload); the next code gets its own row. %>
          <% if @survey.retest_basis == "code" %>
            <button type="button"
                    data-action="click->player#playAgain"
                    class="play-end-btn">
              🙋 <%= t("player.next_person") %>
            </button>
          <% end %>
        </div>
      <% end %>

      <%= render "shared/end_screen_shell",
            message: thankyou_message, actions: thankyou_actions,
            card_attrs: { data: { player_target: "thankyouMain" } } %>

      <% if regions_url.present? %>
        <%# Post-finish regions view: a full-screen, pannable/zoomable world map
            of where answers came from, then per-region comparison against
            this respondent's own answers. %>
        <div data-player-target="regionsPanel" class="hidden regions-overlay">
          <div class="regions-header">
            <div>
              <div class="regions-header-title"><%= t("player.regions_title") %></div>
              <div data-player-target="regionsMeta" class="regions-header-meta"></div>
            </div>
            <button type="button" class="preview-close-btn" data-action="click->player#hideRegions">
              <%= t("player.back") %>
            </button>
          </div>

          <div data-player-target="regionsMain" class="regions-main">
            <div data-player-target="regionsMapViewport" class="regions-map-viewport">
              <div data-player-target="regionsMapStage" class="regions-map-stage">
                <%= render "shared/world_map" %>
              </div>
              <div class="regions-zoom-controls">
                <button type="button" class="regions-zoom-btn" data-action="click->player#zoomInMap"
                        aria-label="<%= t("player.region_zoom_in") %>">+</button>
                <button type="button" class="regions-zoom-btn" data-action="click->player#zoomOutMap"
                        aria-label="<%= t("player.region_zoom_out") %>">−</button>
                <button type="button" class="regions-zoom-btn" data-action="click->player#resetMapView"
                        aria-label="<%= t("player.region_reset_view") %>">⟲</button>
              </div>
            </div>
            <div class="regions-hint"><%= t("player.region_compare_hint") %></div>
            <div data-player-target="regionsList" class="regions-list"></div>
          </div>

          <div data-player-target="regionDetail" class="hidden regions-detail">
            <div data-player-target="regionDetailTitle" class="play-region-title"></div>
            <div data-player-target="regionDetailList" class="play-panel-list"></div>
          </div>
        </div>
      <% end %>

      <%# "How you compare" — one panel, up to two sections: the quiz score
          distribution + per-question correct-rate (filled by
          player#showCompare's scores fetch), and the general per-question
          answer distribution (its results fetch). Either section renders
          alone when only its setting is on; both stack when the creator has
          turned on both quiz mode and results comparison. %>
      <% if show_quiz_scores || show_comparison %>
        <div data-player-target="comparePanel" class="hidden play-panel">
          <% if show_quiz_scores %>
            <div data-player-target="scoresSection">
              <div class="play-panel-head">
                <div class="play-panel-title"><%= t("player.quiz_compare_title") %></div>
                <div class="play-panel-meta" data-player-target="scoresMeta"></div>
              </div>
              <div data-player-target="scoresList" class="play-panel-list"></div>
            </div>
          <% end %>

          <% if show_comparison %>
            <div data-player-target="comparisonSection"
                 class="<%= "play-panel-section-next" if show_quiz_scores %>">
              <div class="play-panel-head">
                <div class="play-panel-title"><%= t("player.comparison_title") %></div>
                <div class="play-panel-meta" data-player-target="comparisonMeta"></div>
              </div>
              <div data-player-target="comparisonList" class="play-panel-list"></div>
            </div>
          <% end %>

          <div class="play-panel-foot">
            <button type="button" data-action="click->player#hideCompare" class="play-panel-back">
              <%= t("player.back") %>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Shown when the respondent tries to advance past a required, unanswered
      question; cleared as soon as they move on. %>
  <div class="preview-required-hint hidden" data-player-target="requiredHint">
    <%= t("player.required_hint") %>
  </div>

  <div class="preview-footer">
    <button class="preview-btn preview-btn-back invisible"
            data-player-target="backBtn"
            data-action="click->player#back"
            aria-label="Back"><%= t("player.back") %></button>
    <span class="preview-progress-text" data-player-target="progress"></span>
    <%# Quiz running score — shown only on a quiz, updated after each graded card. %>
    <span class="quiz-score-chip hidden" data-player-target="scoreChip" aria-live="polite"></span>
    <%# Tokenisation running total — shown only when tokenisation is on,
        updated after each token-awarding card is answered. token_hud_enabled
        is a "blind scoring" opt-out: checkpoints, per-answer reveal and the
        final tally read from the same stored totals regardless, so omitting
        just this target is enough — _renderTokenChip no-ops without it. %>
    <% if @survey.token_hud_enabled? %>
      <span class="token-score-chip hidden" data-player-target="tokenScoreChip" aria-live="polite"></span>
    <% end %>
    <button class="preview-btn preview-btn-next"
            data-player-target="nextBtn"
            data-action="click->player#next"><%= t("player.next") %></button>
    <button class="preview-btn preview-btn-finish hidden"
            data-player-target="finishBtn"
            data-action="click->player#finish"><%= t("player.submit") %></button>
  </div>

  <% if @survey.show_consent_gate? %>
    <%= render "player/consent_banner" %>
  <% end %>

  <%# The Test Mode ring. Last child so it paints over everything it has to
      outline — the footer, the required-answer hint, the consent banner — and
      absolutely positioned so it takes no height from the card (see
      .play-test-frame; a border on the overlay itself would be inside its
      border-box and eat exactly the pixels this change is giving back).
      pointer-events: none, or it swallows every tap meant for the card
      underneath; the exit link opts back in.
      Viewers are unauthenticated testers, so there is normally nowhere to
      send them. The exception is @live_test (PlayerController#live_test_show):
      that person arrived from a real play link and params[:token] still IS
      it, so there is somewhere honest to go back to — and with the strip gone
      this pill is the only way. %>
  <% if @test_mode %>
    <div class="play-test-frame">
      <% if @live_test %>
        <%= link_to t("player.exit_test_mode"), play_survey_path(params[:token]),
                    class: "play-test-exit" %>
      <% end %>
    </div>
  <% end %>

</div>
